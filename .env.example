# Copy to .env and fill in ONE provider. .env is gitignored and never printed.
#
# ── Free options (no card required) ────────────────────────────────────
# Groq — fastest free tier, generous limits.        console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
#
# Google Gemini — large free tier.       aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
#
# OpenRouter — many models, ":free" ones cost nothing.  openrouter.ai/keys
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
#
# Cerebras — free tier, very fast.               cloud.cerebras.ai
# AI_PROVIDER=cerebras
# CEREBRAS_API_KEY=csk-...
#
# Ollama — fully local, no key, no limits. Needs `ollama serve`.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
#
# ── Paid ───────────────────────────────────────────────────────────────
# Claude (best copy quality; this is the default provider)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5          # or claude-sonnet-5
#
# OpenAI — note: there is NO free API tier, ChatGPT Plus does not include it.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# Override the model for any provider:
# AI_MODEL=...
# Override the endpoint (self-hosted / proxy):
# AI_BASE_URL=...

# ── Publishing through git (the review flow) ───────────────────────────
# With these set, "Publish" becomes "Send for review": drafts are committed
# to PREVIEW_BRANCH of PERSONAL_REPO, a super admin approves in /console/review,
# and approval merges into LIVE_BRANCH and pushes it to both repos.
# Without them the console publishes straight to its database, as before.
#
# PERSONAL_REPO=https://github.com/<you>/<site>.git
# GITHUB_TOKEN=github_pat_...        # fine-grained: Contents read/write on PERSONAL_REPO
# LOVABLE_REPO=https://github.com/<lovable-owner>/<site>.git
# LOVABLE_TOKEN=github_pat_...       # Contents read/write on LOVABLE_REPO (falls back to GITHUB_TOKEN)
# PREVIEW_BRANCH=previewbranch
# LIVE_BRANCH=main
# CONTENT_DIR=public/content         # where <page>.json files live in the site repo (served statically)
# PREVIEW_URL=https://<preview deployment of previewbranch>
# LIVE_URL=https://<live site>
