# Copy to .env and fill in ONE provider. .env is gitignored and never printed.
#
# ── Free options (no card required) ────────────────────────────────────
# Groq — fastest free tier, generous limits.        console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
#
# Google Gemini — large free tier.       aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
#
# OpenRouter — many models, ":free" ones cost nothing.  openrouter.ai/keys
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
#
# Cerebras — free tier, very fast.               cloud.cerebras.ai
# AI_PROVIDER=cerebras
# CEREBRAS_API_KEY=csk-...
#
# Ollama — fully local, no key, no limits. Needs `ollama serve`.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
#
# ── Paid ───────────────────────────────────────────────────────────────
# Claude (best copy quality; this is the default provider)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5          # or claude-sonnet-5
#
# OpenAI — note: there is NO free API tier, ChatGPT Plus does not include it.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# Override the model for any provider:
# AI_MODEL=...
# Override the endpoint (self-hosted / proxy):
# AI_BASE_URL=...
# Models to step to when the chosen one is overloaded (429/503, "high demand").
# Gemini has a built-in list; set this to change it, for any provider:
# AI_FALLBACK_MODELS=gemini-flash-latest, gemini-3.5-flash-lite

# ── Lovable sync ───────────────────────────────────────────────────
# LOVABLE_REPO=https://github.com/<owner>/<name>.git
# LOVABLE_TOKEN=github_pat_...      # fine-grained, contents read+write on that repo
# LOVABLE_BRANCH=main
# Where the repo's .asset.json pointers are served from; the build fetches the
# missing files into the clone's public/ before every build. Defaults to the
# project's own host, https://<name>.lovable.app
# LOVABLE_ASSETS_URL=https://tender-code-maker.lovable.app

# ── Picture uploads ─────────────────────────────────────────────────
# A UnionStack SERVER key (allowed origins "*") from the UnionStack dashboard.
# Files chosen in the editor go browser -> this server -> UnionStack and come
# back as https://files.unionstack.in/f/<id> links.
# UNIONSTACK_API_KEY=unionstack_live_...
# Pictures the designer adds in Lovable move to UnionStack on the pull that
# brings them, and the rewritten pointers go back to the repo as one commit
# from MU Console. On whenever UNIONSTACK_API_KEY is set; off with:
# ASSET_MIRROR=0
