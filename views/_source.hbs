                                newImg.src = data.img;
                                newImg.classList.add('fade-img');
                                newImg.style.opacity = 0;
                                newImg.style.zIndex = 1;
                                newImg.style.position = 'absolute';
                                newImg.style.top = 0;
                                newImg.style.left = 0;
                                newImg.style.width = '100%';
                                newImg.style.height = '100%';
                                newImg.style.objectFit = 'cover';
                                newImg.style.borderRadius = '0';
                                newImg.style.transition = 'opacity 0.4s ease';
                                // If lottie is null, set pointer-events to none to disable hover
                                if (isNullOrEmpty(data.lottie)) {
                                    newImg.style.pointerEvents = 'none';
                                }
                            }

                            // Create play button if videoId exists and is not null
                            if (!isNullOrEmpty(data.videoId)) {
                                playButton = document.createElement('img');
                                playButton.src = 'https://images.mastersunion.link/uploads/16062025/v3/MainButton.svg';
                                playButton.alt = 'Play Video';
                                playButton.classList.add('play-button');
                                playButton.style.position = 'absolute';
                                playButton.style.top = '50%';
                                playButton.style.left = '50%';
                                playButton.style.transform = 'translate(-50%, -50%)';
                                playButton.style.zIndex = 3;
                                playButton.style.opacity = 1;
                                playButton.style.cursor = 'pointer';
                                playButton.style.width = '60px';
                                playButton.style.height = '60px';
                                playButton.style.pointerEvents = 'auto';
                                playButton.style.transition = 'opacity 0.4s ease';
                            }
                        }

                        const handleClick = () => {
                            if (isNullOrEmpty(data.videoId)) return;

                            // Remove any existing YouTube iframe before adding a new one
                            removeYouTubeIframe(container);

                            const iframe = document.createElement('iframe');
                            iframe.src = `https://www.youtube.com/embed/${data.videoId}?autoplay=1&rel=0&modestbranding=1`;
                            iframe.setAttribute('allowfullscreen', '');
                            iframe.setAttribute('allow', 'autoplay; encrypted-media; fullscreen');
                            iframe.style.width = '100%';
                            iframe.style.height = '307px';

                            // Remove all children before adding the video
                            while (container.firstChild) {
                                container.removeChild(container.firstChild);
                            }
                            container.appendChild(iframe);

                            isVideoPlaying = true; // Mark video as playing
                        };

                        // Add click handlers if videoId exists and not lottie only
                        if (!isLottieOnly && !isNullOrEmpty(data.videoId)) {
                            if (newImg) newImg.onclick = handleClick;
                            if (lottieElement) lottieElement.onclick = handleClick;
                            if (playButton) playButton.onclick = handleClick;
                        }

                        // Remove all children before appending new ones
                        while (container.firstChild) {
                            container.removeChild(container.firstChild);
                        }

                        // Append new elements
                        if (isLottieOnly) {
                            if (lottieElement) {
                                lottieElement.style.opacity = 1;
                                container.appendChild(lottieElement);
                            }
                        } else {
                            if (newImg) container.appendChild(newImg);
                            if (lottieElement) container.appendChild(lottieElement);
                            if (playButton) container.appendChild(playButton);
                        }

                        // If lottie only, no image or play button, just show lottie
                        if (isLottieOnly) {
                            // Remove previous elements after transition (if any)
                            setTimeout(() => {
                                if (prevImg && prevImg.parentNode) prevImg.parentNode.removeChild(prevImg);
                                if (prevLottie && prevLottie.parentNode) prevLottie.parentNode.removeChild(prevLottie);
                                if (prevPlayBtn && prevPlayBtn.parentNode) prevPlayBtn.parentNode.removeChild(prevPlayBtn);
                            }, 400);
                            // If a video was playing, mark as stopped
                            if (isVideoPlaying) isVideoPlaying = false;
                            return;
                        }

                        // Wait for new image to load before starting transition
                        if (newImg) {
                            newImg.onload = () => {
                                // Fade out previous image (if any)
                                if (prevImg) {
                                    prevImg.style.opacity = 0;
                                }
                                // Fade in new image
                                setTimeout(() => {
                                    newImg.style.opacity = 1;
                                }, 10);

                                // Remove previous elements after transition
                                setTimeout(() => {
                                    if (prevImg && prevImg.parentNode) prevImg.parentNode.removeChild(prevImg);
                                    if (prevLottie && prevLottie.parentNode) prevLottie.parentNode.removeChild(prevLottie);
                                    if (prevPlayBtn && prevPlayBtn.parentNode) prevPlayBtn.parentNode.removeChild(prevPlayBtn);
                                }, 400);

                                // Only stop the video when the new image is actually shown
                                if (isVideoPlaying) {
                                    // Remove the YouTube iframe forcibly
                                    removeYouTubeIframe(container);
                                    isVideoPlaying = false;
                                }
                            };

                            // If image is cached and loads instantly, trigger onload manually
                            if (newImg.complete) {
                                newImg.onload();
                            }
                        }
                    };

                    const isAtTrigger = (el) => {
                        const rect = el.getBoundingClientRect();
                        return (
                            rect.top >= (TRIGGER_TOP - TOLERANCE) &&
                            rect.top <= (TRIGGER_TOP + TOLERANCE) &&
                            rect.bottom > 0 &&
                            rect.top < window.innerHeight
                        );
                    };

                    const closestToTrigger = (els) => {
                        return els.reduce((closest, el, i) => {
                            const d = Math.abs(el.getBoundingClientRect().top - TRIGGER_TOP);
                            return (el.getBoundingClientRect().bottom > 0 && el.getBoundingClientRect().top < window.innerHeight && d < closest.dist)
                                ? { i, dist: d }
                                : closest;
                        }, { i: 0, dist: Infinity }).i;
                    };

                    // No longer stop video on every scroll, only when new image is loaded

                    const processScroll = () => {
                        // Get the specific section for this script (second impactScroll section with careerSection class)
                        const section = document.querySelector('.impactScroll.careerSection');
                        if (!section) return;

                        const boxes = section.querySelectorAll(".impactLeftBox");
                        let newIndex = [...boxes].findIndex(isAtTrigger);
                        if (newIndex === -1) newIndex = closestToTrigger([...boxes]);
                        if (newIndex !== currentIndex && newIndex < videoData.length) {
                            updateContainerImage(newIndex);
                            currentIndex = newIndex;
                        }
                    };

                    // Helper to check if the section is in the viewport
                    function isSectionInView() {
                        const section = document.querySelector('.impactScroll.careerSection');
                        if (!section) return false;
                        const rect = section.getBoundingClientRect();
                        // Section is considered in view if any part is visible
                        return rect.bottom > 0 && rect.top < window.innerHeight;
                    }

                    // Remove YouTube iframe if section is out of view
                    function pauseYoutubeIfSectionOutOfView() {
                        if (!isSectionInView()) {
                            const container = document.getElementById("dynamicVideoContainer2");
                            if (container) {
                                const ytIframe = container.querySelector('iframe[src*="youtube.com"]');
                                if (ytIframe && ytIframe.parentNode) {
                                    ytIframe.parentNode.removeChild(ytIframe);
                                    isVideoPlaying = false;
                                    // Restore the image for the current card
                                    updateContainerImage(currentIndex);
                                }
                            }
                        }
                    }

                    const init = () => {
                        preloadImages();
                        processScroll();
                        window.addEventListener('scroll', throttle(() => {
                            processScroll();
                            pauseYoutubeIfSectionOutOfView();
                        }, 16), { passive: true });
                        window.addEventListener('resize', throttle(() => {
                            processScroll();
                            pauseYoutubeIfSectionOutOfView();
                        }, 250), { passive: true });

                        // Add hover event listeners
                        const container = document.getElementById("dynamicVideoContainer2");
                        if (container) {
                            container.addEventListener('mouseenter', (e) => {
                                const data = videoData[currentIndex];
                                if (!data) return;

                                // Do not show lottie if video is playing
                                if (isVideoPlaying) return;

                                // If lottie is null or empty, do not allow hover effect
                                if (isNullOrEmpty(data.lottie)) return;

                                const img = container.querySelector('img.fade-img');
                                const lottie = container.querySelector('iframe[src*="lottie.host"]');
                                // const playBtn = container.querySelector('.play-button');

                                // Only do hover effect if not lottie only
                                const isLottieOnly = isNullOrEmpty(data.img) && isNullOrEmpty(data.videoId);

                                if (!isLottieOnly && img && lottie && data.lottie) {
                                    img.style.opacity = 0;
                                    lottie.style.opacity = 1;
                                }
                            });

                            container.addEventListener('mouseleave', (e) => {
                                const data = videoData[currentIndex];
                                if (!data) return;

                                // Do not show lottie if video is playing
                                if (isVideoPlaying) return;

                                // If lottie is null or empty, do not allow hover effect
                                if (isNullOrEmpty(data.lottie)) return;

                                const img = container.querySelector('img.fade-img');
                                const lottie = container.querySelector('iframe[src*="lottie.host"]');
                                // const playBtn = container.querySelector('.play-button');

                                // Only do hover effect if not lottie only
                                const isLottieOnly = isNullOrEmpty(data.img) && isNullOrEmpty(data.videoId);

                                if (!isLottieOnly && img && lottie && data.lottie) {
                                    img.style.opacity = 1;
                                    lottie.style.opacity = 0;
                                }
                            });
                        }
                    };

                    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
                    else init();
                })();
            </script>
