            }).done(function (response) {
                if (response.IsSuccess == true) {

                    roasters = response.Data;

                    filterRoasters(roasters)

                }

            });

        }

        var filterArray = []
        var filterTermArray = []
        var filterFormatArray = []
        //   var filterProfessorArray = []
        var filterTypeArray = []
        var filterCohortArray = []


        function filterRoasters(roasters) {

            $('#tblBodyCore').html('')
            $('#tblBodyIndusry').html('')
            $('#tblBodyMentorship').html('')
            $('#tblBodyBootcamp').html('')
            $('#tblBodyBoard').html('')
            $('#tblBodyAll').html('')

            //console.log(filterArray)
            //console.log(filterTermArray)
            //console.log(filterFormatArray)

            if (filterArray.length > 0 && filterArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterArray.includes(el.Concentration)
                });

            if (filterTermArray.length > 0 && filterTermArray.indexOf('all') == -1)
                roasters = roasters.filter(function (el) {

                    return filterTermArray.includes(el.Term)
                });

            if (filterFormatArray.length > 0 && filterFormatArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterFormatArray.includes(el.Format)
                });

            if (filterCohortArray.length > 0 && filterCohortArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterCohortArray.includes(el.Cohort)
                });

            if (filterTypeArray.length > 0 && filterTypeArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterTypeArray.includes(el.ctype)
                });

            roasters.sort(function (a, b) {
                var keyA = (a.Term),
                    keyB = (b.Term);
                // Compare the 2 dates
                if (keyA < keyB) return -1;
                if (keyA > keyB) return 1;
                return 0;
            });
            roasters.forEach((roast, index) => {

                if (roast.CourseNum == null) roast.CourseNum = "";
                if (roast.CourseName == null) roast.CourseName = ""
                if (roast.ctype == null) roast.ctype = ""
                if (roast.Concentration == null) roast.Concentration = ""
                if (roast.Term == null) roast.Term = ""
                if (roast.Credits == null) roast.Credits = ""
                if (roast.Hours == null) roast.Hours = ""
                if (roast.Format == null) roast.Format = ""
                if (roast.Schedule == null) roast.Schedule = ""
                if (roast.Master == null) roast.Master = ""
                if (roast.AboutMaster == null) roast.AboutMaster = ""
                if (roast.Cohort == null) roast.Cohort = ""

                var html =
                    `
                         <tr>
                               <td>${roast.CourseName}</td>
                                <td>`
                if (roast.Masters.length > 0) {
                    roast.Masters.forEach((master, i) => {
                        html += `
                                        ${master.name}
                                        <p class="text10">${master.designation}</p>
                                        `
                    })
                }
                else {
                    html += `
                                        ${roast.Master}
                                        <p class="text10">${roast.AboutMaster}</p>
                                        `
                }
                html += `</td>
                                <td>
                                    ${roast.Concentration}
                                </td>
                                <td>
                                    ${roast.ctype}
                                </td>
                              
                                <td>
                                    ${roast.Credits} (${roast.Hours} hours)
                                </td>
                              
                           </tr>
                        `;


                $('#tblBodyAll').append(html);


            });

            if (filterArray.indexOf('Core') > -1) {
                //$('#headerUpper').html('Core');
                $('#headerLower').html('Core Concentration');



            }
            if (filterArray.indexOf('Skill') > -1) {
                $('#headerLower').html('Skill');



            }
            if (filterArray.indexOf('Industry') > -1) {
                $('#headerLower').html('Industry Concentration');


            }
            if (filterArray.indexOf('Mentorship') > -1) {

                $('#headerLower').html('Industry Mentorship Programm');
            }
            if (filterArray.indexOf('Bootcamp') > -1) {

                $('#headerLower').html('Bootcamp');

            } if (filterArray.indexOf('Boardmember') > -1) {

                $('#headerLower').html('Board Member Recticals');

            } if (filterArray.indexOf('all') > -1) {

                $('#headerLower').html('Member Recticals');

            }

            var htmlNodatafound = `<tr> 
                <td colspan="9">
                    <p class="alert-txt"> <span class="material-icons"> warning </span> No data found </p>
                </td> 
                </tr>`

            if ($('#tblBodyMentorship').html() == '' || $('#tblBodyMentorship').html() == undefined) $('#tblBodyMentorship').html(htmlNodatafound)
            if ($('#tblBodyBootcamp').html() == '' || $('#tblBodyBootcamp').html() == undefined) $('#tblBodyBootcamp').html(htmlNodatafound)
            if ($('#tblBodyBoard').html() == '' || $('#tblBodyBoard').html() == undefined) $('#tblBodyBoard').html(htmlNodatafound)
            if ($('#tblBodyCore').html() == '' || $('#tblBodyCore').html() == undefined) $('#tblBodyCore').html(htmlNodatafound)
            if ($('#tblBodySkill').html() == '' || $('#tblBodySkill').html() == undefined) $('#tblBodySkill').html(htmlNodatafound)
            if ($('#tblBodyIndusry').html() == '' || $('#tblBodyIndusry').html() == undefined) $('#tblBodyIndusry').html(htmlNodatafound)



        }
        $(document).on("click", ".core-text", function () {
            // console.log($(this).attr('data-type'))
            // console.log($(this).attr('data'))

            $(this).remove()
            if ($(this).attr('data-type') == 'concentration') {

                filterArray.splice(filterArray.indexOf($(this).attr('data')), 1)
                if (filterArray.length == 0)
                    $('#dropDown').val('all')
            }
            if ($(this).attr('data-type') == 'term') {
                filterTermArray.splice(filterTermArray.indexOf($(this).attr('data')), 1)
                if (filterTermArray.length == 0)
                    $('#selectTerm').val('all')
            } if ($(this).attr('data-type') == 'format') {
                filterFormatArray.splice(filterFormatArray.indexOf($(this).attr('data')), 1)
                if (filterFormatArray.length == 0)
                    $('#selectFormat').val('all')
            }
            if ($(this).attr('data-type') == 'cohort') {
                filterCohortArray.splice(filterCohortArray.indexOf($(this).attr('data')), 1)
                if (filterCohortArray.length == 0)
                    $('#selectCohort').val('all')
            }

            if ($(this).attr('data-type') == 'type') {
                filterTypeArray.splice(filterTypeArray.indexOf($(this).attr('data')), 1)
                if (filterTypeArray.length == 0)
                    $('#selectType').val('all')
            }
            filterRoasters(roasters)

            //$('select').selectpicker('refresh');
        });

        $('#selectCohort').val('3');
        $('#selectCohort').trigger('change');


    });


