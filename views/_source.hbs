<section class="heroSection">
    <div class="heroSectionImg">
        <div class="heroSectionImg">
            <div class="video-container mob-hide">
                <video autoplay loop muted playsinline>
                    <source src="https://files.mastersunion.link/brochures/Horizontal%20Video.mp4" type="video/mp4">
                </video>
            </div>
            <div class="mobvideoHeight relative">
                <!-- Fallback Image -->
                <img src="https://images.mastersunion.link/uploads/25092025/v1/herosectionmobss2.webp"
                    class="mob-visible absolute top-0 left-0 w-full h-full object-cover z-10 transition-opacity duration-700"
                    id="videoFallbackImg" alt="Fallback Image">

                <!-- Video -->
                <video class="mob-visible w-full h-full object-cover" autoplay loop muted playsinline
                    id="safariChromeAutoPlayVideo">
                    <source src="https://files.mastersunion.link/brochures/vertical%20video%202.mp4" type="video/mp4">
                </video>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var video = document.getElementById('safariChromeAutoPlayVideo');
                    var fallbackImg = document.getElementById('videoFallbackImg');

                    if (video) {
                        var playPromise = video.play();

                        if (playPromise !== undefined) {
                            playPromise.catch(function () {
                                // Agar autoplay block ho jaye toh force mute karke play kare
                                video.muted = true;
                                video.play();
                            });
                        }

                        // Jaise hi video ready ho aur play start ho
                        video.addEventListener('playing', function () {
                            if (fallbackImg) {
                                fallbackImg.style.opacity = "0"; // fade out
                                setTimeout(() => fallbackImg.style.display = "none", 700); // remove after transition
                            }
                        });
                    }
                });
            </script>

            <style>
                .mobvideoHeight {
                    position: relative;
                    overflow: hidden;
                }
            </style>

        </div>
    </div>

    <div class="heroSectionContent">
        <h1 class="go-HeroTitle font-white">
