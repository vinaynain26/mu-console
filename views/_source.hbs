            <script>
                // Script to scroll up and fade out the heading when last card touches top 250px
                document.addEventListener("DOMContentLoaded", function () {
                    // Only run this script on mobile devices (below 768px width)
                    if (window.innerWidth >= 768) return;

                    function animateHeading(progress) {
                        const heading = document.getElementById("beyondCapitalHeading");
                        const beyondText = document.querySelector(".beyondText");
                        if (!heading) return;

                        // Clamp progress between 0 and 1
                        progress = Math.max(0, Math.min(1, progress));

                        // Move up to -60px and fade out to 0
                        heading.style.transform = `translateY(${-60 * progress}px)`;
                        heading.style.opacity = `${1 - progress}`;

                        // Also animate the beyondText if it exists
                        if (beyondText) {
                            beyondText.style.transform = `translateY(${-60 * progress}px)`;
                            beyondText.style.opacity = `${1 - progress}`;
                        }
                    }

                    function onScroll() {
                        const lastCard = document.getElementById("lastcardBeyond");
                        const heading = document.getElementById("beyondCapitalHeading");
                        if (!lastCard || !heading) return;

                        const rect = lastCard.getBoundingClientRect();
                        const viewportHeight = window.innerHeight;
                        const screenCenter = viewportHeight / 2; // 50% of screen height

                        // When top of last card reaches 50% of screen height, start fade out
                        const triggerPoint = screenCenter;
                        // Animation over 100px scroll
                        const animDistance = 100;

                        if (rect.top <= triggerPoint) {
                            let progress = (triggerPoint - rect.top) / animDistance;
                            animateHeading(progress);
                        } else {
                            animateHeading(0);
                        }
                    }

                    // Set initial styles for smooth transition
                    const heading = document.getElementById("beyondCapitalHeading");
                    const beyondText = document.querySelector(".beyondText");

                    if (heading) {
                        heading.style.transition = "transform 0.4s cubic-bezier(0.4,0,0.2,1), opacity 0.4s cubic-bezier(0.4,0,0.2,1)";
                        heading.style.willChange = "transform, opacity";
                    }

                    if (beyondText) {
                        beyondText.style.transition = "transform 0.4s cubic-bezier(0.4,0,0.2,1), opacity 0.4s cubic-bezier(0.4,0,0.2,1)";
                        beyondText.style.willChange = "transform, opacity";
                    }

                    window.addEventListener("scroll", onScroll, { passive: true });
                    // Also trigger on load
                    onScroll();
                });
            </script>

            <script>
                document.querySelectorAll(".beyondCapitalCardCover").forEach((main) => {
                    const cursor = main.querySelector(".beyondCapitalCursor");
                    main.addEventListener("mousemove", function (dets) {
                        const rect = main.getBoundingClientRect();
                        const x = dets.clientX - rect.left;
                        const y = dets.clientY - rect.top;
                        gsap.to(cursor, {
                            x: x,
                            y: y,
                            duration: 1.2,
                            ease: "power3.out"
                        });
                    });
                });
            </script>
