            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollToPlugin.min.js"></script>
            <script>
                gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

                // Prevent GSAP from "catching up" the elapsed time after the tab
                // regains focus (rAF is paused in background tabs). Without this,
                // scrub-based ScrollTriggers jump or break on tab switch.
                gsap.ticker.lagSmoothing(0);

                let scrollTriggerInstance;

                function initializeAnimation() {
                    // Kill previous instance if exists
                    if (scrollTriggerInstance) {
                        scrollTriggerInstance.kill();
                        ScrollTrigger.getAll().forEach(st => st.kill());
                    }

                    const slides = gsap.utils.toArray(".custom-slide");
                    const progressLine = document.querySelector(".custom-progress");
                    const customDots = document.querySelectorAll(".custom-dot");
                    const dotContentTexts = document.querySelectorAll(".dotContentText");
                    const currentImage = document.getElementById("currentImage");
                    const imageWrapper = document.querySelector(".custom-imgWrapper");
                    const container = document.querySelector(".custom-container");

                    if (!container || slides.length === 0) return;

                    // Reset container styles
                    container.style.visibility = "visible";
                    container.style.display = "flex";

                    // Reset GSAP transforms
                    gsap.set(".custom-content", { clearProps: "all" });

                    // ✅ Function to calculate total scrollable width (fixed)
                    const getMaxScrollWidth = () => {
                        const totalWidth = slides.reduce((sum, slide) => sum + slide.offsetWidth, 0);
                        return totalWidth - window.innerWidth + 200; // ✅ extra scroll allowance
                    };


                    setTimeout(() => imageWrapper?.classList.add("loaded"), 100);

                    if (customDots.length > 0) {
                        customDots.forEach(dot => dot.classList.remove("active", "passed"));
                        dotContentTexts.forEach(text => text.classList.remove("active"));
                        customDots[0].classList.add("active");
                        dotContentTexts[0]?.classList.add("active");
                        slides.forEach((slide, i) => slide.classList.toggle("text-active", i === 0));
                    }

                    function changeImage(newSrc) {
                        if (!newSrc || !currentImage) return;
                        const newImg = document.createElement("img");
                        newImg.src = newSrc;
                        newImg.className = "transition-img";
                        newImg.style.zIndex = 5;
                        currentImage.parentElement.appendChild(newImg);

                        gsap.set(newImg, { clipPath: "inset(0 0 0 100%)" });
                        gsap.to(newImg, {
                            clipPath: "inset(0 0 0 0%)",
                            duration: 1,
                            ease: "power2.inOut",
                            onComplete: () => {
                                currentImage.src = newSrc;
                                newImg.remove();
                            }
                        });
                    }

                    let currentActiveIndex = 0;
                    function activateSlideText(index) {
                        slides.forEach((slide, i) => slide.classList.toggle("text-active", i === index));
                    }

                    // Hardcoded dot positions
                    const dotPositions = [0, 20, 40, 60, 80];

                    // HORIZONTAL SCROLL WITHOUT PIN
                    scrollTriggerInstance = gsap.to(".custom-content", {
                        x: () => `-${getMaxScrollWidth()}`,
                        ease: "none",
                        scrollTrigger: {
                            trigger: ".custom-container",
                            start: "top top",
                            end: () => `+=${getMaxScrollWidth()}`, // ✅ fixed
                            scrub: 0.1,
                            invalidateOnRefresh: true,
                            onUpdate: self => {
                                const progress = self.progress;
                                const firstDot = dotPositions[0];
                                const lastDot = dotPositions[dotPositions.length - 1];
                                const currentProgressPosition = firstDot + (progress * (lastDot - firstDot));

                                gsap.to(progressLine, { width: `${currentProgressPosition}%`, duration: 0.2 });

                                let activeDotIndex = 0;
                                for (let i = 0; i < dotPositions.length; i++) {
                                    if (currentProgressPosition >= dotPositions[i]) activeDotIndex = i;
                                }

                                if (activeDotIndex !== currentActiveIndex && slides[activeDotIndex]) {
                                    const imageSrc = slides[activeDotIndex].dataset?.image;
                                    if (imageSrc) changeImage(imageSrc);
                                    activateSlideText(activeDotIndex);

                                    currentActiveIndex = activeDotIndex;
                                    customDots.forEach((dot, j) => {
                                        dot.classList.toggle("active", j === currentActiveIndex);
                                        dot.classList.toggle("passed", j < currentActiveIndex);
                                    });

                                    dotContentTexts.forEach((text, j) => {
                                        text.classList.toggle("active", j === currentActiveIndex);
                                    });
                                }
                            }
                        }
                    });
                }

                // Initialize once
                initializeAnimation();

                // ----------------------
                // TAB SWITCH HANDLING
                // ----------------------
                document.addEventListener('visibilitychange', () => {
                    if (document.hidden) return;
                    // Recalculate ScrollTrigger positions once the tab is visible
                    // again. refresh() preserves the current scroll position, so we
                    // avoid the fragile teardown/rebuild that broke the animation.
                    requestAnimationFrame(() => ScrollTrigger.refresh());
                });

                // ----------------------
                // RESIZE HANDLING
                // ----------------------
                let resizeTimeout;
                window.addEventListener('resize', () => {
                    if (resizeTimeout) clearTimeout(resizeTimeout);
                    resizeTimeout = setTimeout(() => {
                        ScrollTrigger.refresh(true);
                    }, 250);
                });

                // ----------------------
                // MANUAL REFRESH
                // ----------------------
                function cleanupAnimation() {
                    if (scrollTriggerInstance) {
                        scrollTriggerInstance.kill();
                        ScrollTrigger.getAll().forEach(st => st.kill());
                        gsap.set(".custom-content", { clearProps: "all" });
                    }
                }

                window.addEventListener('unload', cleanupAnimation);

                window.refreshPGPJourneyAnimation = () => {
                    cleanupAnimation();
                    setTimeout(() => {
                        initializeAnimation();
                        ScrollTrigger.refresh(true);
                    }, 100);
                };
            </script>



