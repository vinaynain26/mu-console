                    data: JSON.stringify({
                        field_device_type: device,
                        email: email,
                        name: name,
                        mobile: number,
                        linkedinProfile: "",
                        medium: utmMedium || medium,
                        campaign: utmCampaign || null,
                        source: utmSource,
                        course: program,
