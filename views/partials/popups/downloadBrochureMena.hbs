        if(!isValid) return;

        const urlSearchParams = new URLSearchParams(window.location.search);
        const params = Object.fromEntries(urlSearchParams.entries());
        const utmSource = params.utm_source || 'Website';
        const utmMedium = params.utm_medium;
        const utmCampaign = params.utm_campaign;
        let url = window.location.pathname.substring(1);

        let formname = document.querySelector("#ApplyNowPopUpNEW").getAttribute("data-title") || "Download Placement Report";
        let medium = `PGP-TBM - ${formname} Popup`;
        console.log(APIpushToNPFendPoint,"APIpushToNPFendPoint")
        let course = 'Post Graduate Programme in Technology & Business Management';
        let program = "PGP Rise: General Management (Global)";
        if (url.startsWith("pgp-rise")) {
            course = 'PGP Rise';
            medium = `PGP RISE Gl - Check Your Fitment POPUP`;

        } else if (url.startsWith("ug-")) {
            course = 'Undergraduate Programme';
            medium = `UG - ${formname} Popup`;
        }

        let device = 'PC';
        if (window.matchMedia("(max-width: 768px)").matches) {
            device = "Mobile";
        } else {
            device = "Desktop";
        }

        // api for our Data base
        var post_url = '{{apiBaseURL}}/api/courseRegister';
        var request_method = 'POST'; //get form GET/POST method
        $.ajax({
            url: post_url,
            type: request_method,
            contentType: "application/json",
            data: JSON.stringify({
                "email": email,
                "name": name,
                "mobile": number,
                "courseName": program,
                "country":country,
                "leadSource": medium,
                "leadOrigin": medium || "N/A",// for lead matrix
                consentCheck: document.getElementById('consentCheckMena')?.checked || false,

            }),
            dataType: "json",
            success: function (result) {
                console.log("Second api after first success")
