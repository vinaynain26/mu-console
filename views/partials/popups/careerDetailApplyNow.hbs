<main>
    <div class="popupContainerOuter   ApplyNow" id="openJobRegisterPopUp">

        <div class="popupContainer">
            <div class="fromTophead ">
                <h2 class="font-56 font-bold font-black1 letter-spacing1" id="Ug_form_heading"> Apply Now </h2>
                <div class="popUpCloseBtnWrap">
                    <img  src="https://files.mastersunion.link/resources/svg/crossIcon.svg"
                        class="invert-img" alt="Icon" onclick="hideApplyNowPopUp();">
                </div>
            </div>
            <div class="PopupformWrapper CareerPage" id="leadformContainer">
                <div class="left mob-hide">
                    <img class="ugPopUpImg" src="https://files.mastersunion.link/media/img/ug-brochure-image.webp"
                        alt="">
                </div>
                <div class="right">
                    <div class="formContainer active">
                        <div class="flexInput" id="formain">
                            <div class="inputGroup">
                                <label for="name" class="font-14 font-medium font-black1">Full Name <span
                                        class="font-red">*</span></label>
                                <input type="text" placeholder="Enter your name"
                                    class="inputBox font-16 font-black1 font-medium" id="nameReport"
                                    onblur="validateNameInput('nameReport', 'nameReportVal')">
                                <p class="font-12 font-red font-regular warning" id="nameReportVal">Please Check the
                                    input</p>
                            </div>
                            <div class="inputGroup">
                                <label for="number" class="font-14 font-medium font-black1">Contact Number <span
                                        class="font-red">*</span></label>
                                <input type="text" placeholder="Enter your mobile number"
                                    class="inputBox font-16 font-black1 font-medium" id="numberReport" maxlength="10"
                                    onblur="validateMobileInput('numberReport', 'numberReportVal')">
                                <p class="font-12 font-red font-regular warning" id="numberReportVal">Please Enter Valid
                                    Number</p>
                            </div>
                            <div class="inputGroup">
                                <label for="email" class="font-14 font-medium font-black1">Email ID <span
                                        class="font-red">*</span></label>
                                <input type="text" placeholder="Enter your email"
                                    class="inputBox font-16 font-black1 font-medium" id="emailReport"
                                    onblur="validateEmailInput('emailReport', 'emailReportVal')">
                                <p class="font-12 font-red font-regular warning" id="emailReportVal">Please Enter Valid
                                    Email</p>
                            </div>
                            <div class="inputGroup">
                                <label for="location" class="font-14 font-medium font-black1">Current Location</label>
                                <input type="text" placeholder="Enter your location"
                                    class="inputBox font-16 font-black1 font-medium" id="locationReport">
                            </div>
                            <div class="inputGroup">
                                <label for="experience" class="font-14 font-medium font-black1">Experience</label>
                                <input type="text" placeholder="Enter your experience"
                                    class="inputBox font-16 font-black1 font-medium" id="experienceReport">
                            </div>
                            <div class="inputGroup">
                                <label for="currentCTC" class="font-14 font-medium font-black1">Current CTC</label>
                                <input type="text" placeholder="Enter your current CTC"
                                    class="inputBox font-16 font-black1 font-medium" id="currentCTCReport">
                            </div>
                            <div class="inputGroup">
                                <label for="expectedCTC" class="font-14 font-medium font-black1">Expected CTC</label>
                                <input type="text" placeholder="Enter your expected CTC"
                                    class="inputBox font-16 font-black1 font-medium" id="expectedCTCReport">
                            </div>
                            <div class="inputGroup">
                                <label for="noticePeriod" class="font-14 font-medium font-black1">Notice Period</label>
                                <input type="text" placeholder="Enter your notice period"
                                    class="inputBox font-16 font-black1 font-medium" id="noticePeriodReport">
                            </div>
                            <div class="inputGroup">
                                <label for="resume" class="font-14 font-medium font-black1">Resume/CV</label>
                                <input type="file" class="inputBox font-16 font-black1 font-medium" id="resumeReport"
                                    onchange="handleFileChange(event)">
                            </div>

                        </div>
                    </div>
                    <div class="consentCheckWrapper">
                        <div class="consentCheckRow">
                            <input type="checkbox" id="consentCheckcdan">
                            <label for="consentCheckcdan">I authorize Masters&rsquo; Union and its affiliates to process my personal data to send me information about programs related to my application, admission, or enrollment through digital channels (including email, phone calls, RCS, SMS, and WhatsApp), in accordance with Masters&rsquo; Union <a href="https://mastersunion.org/privacy-policy" target="_blank">Privacy Policy</a>, <a href="https://mastersunion.org/cookie-policy" target="_blank">Cookie Policy</a>, and <a href="https://mastersunion.org/terms-and-conditions" target="_blank">Terms &amp; Conditions</a>. By submitting my details, I agree to receive communications related to my application, events, and program updates. Message frequency may vary and message and data rates may apply. I may withdraw my consent at any time by replying STOP, UNSUBSCRIBE, or HELP for assistance.</label>
                        </div>
                        <p id="consentCheckErrorcdan" class="font-12 font-red font-regular warning consentCheckError">Please accept the consent to continue</p>
                    </div>
                    <div class="formFooter" id="submitbuttonreport">
                        <div class="gradientButton whiteHover" onclick="buttonOnClickJobRegister()">
                            <button class="button iconButton gtmUgDwnBroPop" id="submitButtonApplyJob">
                                Apply Now
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                    xmlns="https://www.w3.org/2000/svg">
                                    <path
                                        d="M16.0208 9.41421L7.41421 18.0208L6 16.6066L14.6066 8H7.02082V6H18.0208V17H16.0208V9.41421Z"
                                        fill="white"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="SuccessMessage" class="congrats-box text-center hide">
                <img src="https://files.mastersunion.link/assets/img/thankyou_logo.svg" alt="Icon">
                <h3 class="thankyouboxHeading mt-10 gtmUgDwnBroGotit" id="gtmUgDwnBroGotitId">Got it</h3>
                <p class="text-2 gtmUgDwnBroGotPara" id="gtmUgDwnBroGotParaId">Your Job Application is submited
                    successfully.
                </p>
                <p class="text-2">Feel free to write to us at <a class="link-red"
                        href="mailto:ugadmissions@mastersunion.org" target="_blank">ugadmissions@mastersunion.org</a>
                </p>
                <p class="text-2">or call on <span class="font-bold">+91 76691 86660</span> in case of any queries.</p>
            </div>
        </div>
-     
    </div>
</main>


<script>
    let jobIdHere;
    let selectedFile = null;
    let uploadedFileUrl = '';
    const fileStackClient = filestack.init('{{filestackApiKey}}');

    function openJobRegisterPopUp(formTitle, destination, jobId) {
        const form = document.getElementById("openJobRegisterPopUp");
        const h2 = document.querySelector("#Ug_form_heading");
        jobIdHere = jobId;

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);

        document.querySelector("#SuccessMessage").classList.add("hide");
        document.querySelector("#submitbuttonreport").classList.remove("hide");
        document.querySelector("#leadformContainer").classList.remove("hide");
        document.querySelector("#Ug_form_heading").classList.remove("hide");
    }

    async function handleFileChange(event) {
        selectedFile = event.target.files[0];
        const submitBtn = document.getElementById("submitButtonApplyJob");

        if (selectedFile) {
            submitBtn.textContent = "Uploading Resume...";
            submitBtn.disabled = true;

            try {
                const response = await fileStackClient.upload(selectedFile);
                uploadedFileUrl = response.url;
                console.log("Resume uploaded successfully:", uploadedFileUrl);
                submitBtn.textContent = "Apply Now";
                submitBtn.disabled = false;
            } catch (error) {
                console.error("File upload error:", error);
                alert("Failed to upload resume. Please try again.");
                uploadedFileUrl = '';
                submitBtn.textContent = "Apply Now";
                submitBtn.disabled = false;
            }
        }
    }

    async function buttonOnClickJobRegister() {
        if (!jobIdHere) {
            console.error("No job ID found!");
            return;
        }

        let name = $('#nameReport').val().trim();
        let email = $('#emailReport').val().trim();
        let number = $('#numberReport').val().trim();

        let isValid = true;
        isValid = validateNameInput('nameReport', 'nameReportVal') && isValid;
        isValid = validateEmailInput('emailReport', 'emailReportVal') && isValid;
        isValid = validateMobileInput('numberReport', 'numberReportVal') && isValid;
        if (!document.getElementById('consentCheckcdan')?.checked) { document.getElementById('consentCheckErrorcdan').classList.remove('warning'); isValid = false; } else { document.getElementById('consentCheckErrorcdan').classList.add('warning'); }
        if (!isValid) return;

        const submitBtn = document.getElementById("submitButtonApplyJob");
        submitBtn.textContent = "Submitting...";
        submitBtn.disabled = true;

        const urlSearchParams = new URLSearchParams(window.location.search);
        const params = Object.fromEntries(urlSearchParams.entries());

        const utmSource = params.utm_source || 'Website';
        const utmMedium = params.utm_medium || '';
        const utmCampaign = params.utm_campaign || '';
        const full_utm_url = window.location.href;

        const form = document.getElementById("openJobRegisterPopUp");
        const destination = form.getAttribute("data-destination") || "https://files.mastersunion.link/uploads/28042025/v1/ugbrochure2025.pdf";
        const formname = form.getAttribute("data-title") || "Download Placement Report";

        const medium = `Master's Union Apply For Job - Popup`;
        const leadLocation = `Master's Union Apply For Job - Popup`;
        const device = window.matchMedia("(max-width: 768px)").matches ? "Mobile" : "Desktop";

        const formData = {
            muJob_Id: jobIdHere,
            name,
            number,
            email,
            currentLocation: $('#locationReport').val().trim(),
            designation: "",
            experience: $('#experienceReport').val().trim(),
            currentCtc: $('#currentCTCReport').val().trim(),
            expectedCtc: $('#expectedCTCReport').val().trim(),
            noticePeriod: $('#noticePeriodReport').val().trim(),
            resume: uploadedFileUrl || "",
            medium,
            source: utmSource,
            campaign: utmCampaign,
            full_utm_url,
            leadSource: leadLocation,
            device,
            consentCheck: document.getElementById('consentCheckcdan')?.checked || false
        };

        $.ajax({
            url: '{{apiBaseURL}}/api/registerForJob',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function (response) {
                console.log("Success:", response);

                if (response.message === "You have already registered for this job.") {
                    document.querySelector("#gtmUgDwnBroGotParaId").innerHTML = "You have already registered for this job.";
                    document.querySelector("#SuccessMessage").classList.remove("hide");
                    document.querySelector("#submitbuttonreport").classList.add("hide");
                    document.querySelector("#leadformContainer").classList.add("hide");
                    document.querySelector("#Ug_form_heading").classList.add("hide");
                } else if (response.message == "Registration successful") {
                    document.querySelector("#gtmUgDwnBroGotParaId").innerHTML = "You are registered for this job Succesfully.";
                    document.querySelector("#SuccessMessage").classList.remove("hide");
                    document.querySelector("#submitbuttonreport").classList.add("hide");
                    document.querySelector("#leadformContainer").classList.add("hide");
                    document.querySelector("#Ug_form_heading").classList.add("hide");
                }


            },
            error: function (error) {
                console.error("Error submitting job registration:", error);
                alert("There was an error submitting your details. Please try again.");
            },
            complete: function () {
                submitBtn.textContent = "Apply Now";
                submitBtn.disabled = false;
            }
        });
    }

    function hideApplyNowPopUp() {
        const applyNowPopUp = document.getElementById("openJobRegisterPopUp");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active");
        }

        $('#nameReport, #emailReport, #numberReport, #locationReport, #experienceReport, #currentCTCReport, #expectedCTCReport, #noticePeriodReport, #resumeReport').val("");
        const consentEl = document.getElementById('consentCheckcdan');
        if (consentEl) consentEl.checked = false;
        document.getElementById('consentCheckErrorcdan')?.classList.add('warning');
        selectedFile = null;
        uploadedFileUrl = '';
    }
</script>