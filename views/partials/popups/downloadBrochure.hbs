    /* =========================================================
     * Fallback validators — only registered if not already defined
     * by main.js. Some layouts (e.g. pgp-rise) load newmain.js only,
     * where these helpers are absent, which previously caused
     * `validateNameInput is not a function` and silently halted the
     * Download Career Report submission. Semantics mirror main.js.
     * ========================================================= */
    (function () {
        if (typeof window.validateNameInput !== "function") {
            window.validateNameInput = function (elementId, errorElementId, fieldName) {
                fieldName = fieldName || "Name";
                var $input = $("#" + elementId);
                var $error = $("#" + errorElementId);
                var value = ($input.val() || "").trim();

                $error.css("visibility", "hidden");

                if (value === "") {
                    $error.css("visibility", "visible").removeClass("warning").text(fieldName + " cannot be empty");
                    return false;
                }
                if (value.length < 3) {
                    $error.css("visibility", "visible").removeClass("warning").text(fieldName + " is too short.");
                    return false;
                }
                var namePattern = /^[A-Za-z\s]+$/;
                if (!namePattern.test(value)) {
                    $error.css("visibility", "visible").removeClass("warning").text(fieldName + " can only contain letters and spaces.");
                    return false;
                }
                $error.removeClass("warning").text("").css("visibility", "hidden");
                return true;
            };
        }

        if (typeof window.validateEmailInput !== "function") {
            window.validateEmailInput = function (elementId, errorElementId) {
                var $input = $("#" + elementId);
                var $error = $("#" + errorElementId);
                var value = ($input.val() || "").trim();

                if (value === "") {
                    $error.css("visibility", "visible").removeClass("warning").text("Email cannot be empty");
                    return false;
                }
                var emailPattern = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
                if (!emailPattern.test(value)) {
                    $error.css("visibility", "visible").removeClass("warning").text("Invalid email address format");
                    return false;
                }
                $error.removeClass("warning").text("").css("visibility", "hidden");
                return true;
            };
        }

        if (typeof window.validateMobileInput !== "function") {
            window.validateMobileInput = function (elementId, errorElementId) {
                var $input = $("#" + elementId);
                var $error = $("#" + errorElementId);
                var value = ($input.val() || "").trim();

                $error.css("visibility", "hidden");

                if (value === "") {
                    $error.css("visibility", "visible").removeClass("warning").text("Mobile number cannot be empty");
                    return false;
                }
                var mobilePattern = /^[0-9]{10}$/;
                if (!mobilePattern.test(value)) {
                    $error.css("visibility", "visible").removeClass("warning").text("Mobile number must be 10 digits");
                    return false;
                }
                $error.removeClass("warning").text("").css("visibility", "hidden");
                return true;
            };
        }
    })();

    async function loadCountriesForDownloadBrochure() {
        const $countrySelect = $("#countryCodeUGDownloadbrochure");
        if (!$countrySelect.length) return;

        try {
            const response = await fetch("https://api.mastersunion.org/api/geo/countries");
            const payload = await response.json();
            const countries = Array.isArray(payload) ? payload : (payload?.Data || []);

            if (!countries.length) {
                throw new Error("Countries list is empty");
            }

            $countrySelect.empty();
            countries
                .filter((country) => country?.phonecode)
                .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")))
                .forEach((country) => {
                    const phoneCode = String(country.phonecode).trim();
                    const iso2 = String(country.iso2 || "").toUpperCase();
                    const $option = $("<option></option>")
                        .attr("value", phoneCode)
                        .attr("data-iso", iso2)
                        .text(phoneCode);
                    if (phoneCode === "91" || iso2 === "IN") {
                        $option.attr("selected", "selected");
                    }
                    $countrySelect.append($option);
                });
        } catch (error) {
            console.error("Failed to load countries for download brochure popup:", error);
            $countrySelect.empty().append('<option value="91" data-iso="IN">91</option>');
        }
    }

