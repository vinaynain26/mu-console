    function validateInputBlur(fieldId, fieldName) {
        const inputValue = $(`#${fieldId}`).val().trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const numberRegex = /^\d+$/;

        if (inputValue === "") {
            $(`#${fieldName}ReportVal`).removeClass('warning');
        } else {
            $(`#${fieldName}ReportVal`).addClass('warning');
        }
    }




    function hideApplyNowPopUp() {
        let applyNowPopUp = document.getElementById("ApplyNowPopUpNEW");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active")
        }

        $('#nameReport').val("");
        $('#emailReport').val("");
        $('#numberReport').val("");

        const consentCheckipf = document.getElementById('consentCheckipf');
        if (consentCheckipf) consentCheckipf.checked = false;
        const consentCheckErroripf = document.getElementById('consentCheckErroripf');
        if (consentCheckErroripf) consentCheckErroripf.classList.add('warning');

    }


    function validationOnblurPgpTbmCommon(field, errorId, errorMessage) {
        var input = $("#" + field);  // Get the field by ID
        var error = $("#" + errorId);  // Get the error element by ID

        if (input.val() === "") {
            error.removeClass("warning");  // Add the warning class if applicable
            error.text(errorMessage);  // Set the dynamic error message
        } else {
            error.hide();  // Hide the error message if input is valid
        }
    }














    $(document).ready(function () {
        (function deferCscUntilIntersectPartnerPopupOpen() {
            var el = document.getElementById("ApplyNowPopUpNEW");
            if (!el) return;
            var started = false;
            function kick() {
                if (started || !el.classList.contains("active")) return;
                started = true;
                getAllCountries();
            }
            kick();
            if (typeof MutationObserver !== "undefined") {
                new MutationObserver(kick).observe(el, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            }
        })();

        $('#selectCountryCode').change(function () {
            var countryCode = $(this).val();
            getAllStates(countryCode);
        });

        $('#userState').change(function () {
            var countryCode = $('#selectCountryCode').val();
            var stateCode = $(this).val();
            getCities(countryCode, stateCode);
        });





        function getAllCountries() {
            $.ajax({
                url: 'https://api.mastersunion.org/api/geo/countries',
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#selectCountryCode').empty().append($("<option value='' disabled selected></option>").text("Select your country"));
                $.each(response, function (idx, country) {
                    $('#selectCountryCode').append($("<option></option>")
                        .attr("value", country.iso2)
                        .text(`${country.phonecode} (${country.name})`));
                });

                $('#selectCountryCode').val('IN').change();
            });
        }

        function getAllStates(countryCode) {
            $.ajax({
                url: `https://api.mastersunion.org/api/geo/countries/${countryCode}/states`,
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#userState').empty().append($("<option value='' disabled selected></option>").text("Select your state"));
                $.each(response, function (idx, state) {
                    $('#userState').append($("<option></option>")
                        .attr("value", state.iso2)
                        .text(state.name));
                });
            });
        }

        function getCities(countryCode, stateCode) {
            $.ajax({
                url: `https://api.mastersunion.org/api/geo/countries/${countryCode}/states/${stateCode}/cities`,
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#userCity').empty().append($("<option value='' disabled selected></option>").text("Select your city"));
                $.each(response, function (idx, city) {
                    $('#userCity').append($("<option></option>")
                        .attr("value", city.name)
                        .text(city.name));
                });
            });
        }
    });

