<script>



// Global variable to store the uploaded file URL
let uploadedFileUrl = '';

$(document).ready(function () {
  // Ensure FileStack is initialized
  const fileStackClient = filestack.init('{{filestackApiKey}}'); // Replace YOUR_API_KEY if needed

  // Handle file input change
  $('#profilePicField').on('change', function (event) {
    const file = event.target.files[0];

    if (!file) {
      console.log('No file selected. Please choose a file.');
      return;
    }

    // Validate file type and size
    const allowedExtensions = ['image/png', 'image/jpeg', 'image/jpg'];
    const maxSize = 5 * 1024 * 1024; // 5 MB

    if (!allowedExtensions.includes(file.type)) {
      console.log('Invalid file type. Please upload a valid image file (PNG, JPEG, JPG).');
      return;
    }

    if (file.size > maxSize) {
      console.log('File size exceeds 5 MB. Please upload a smaller file.');
      return;
    }

    // Update UI with the chosen file name
    $('#fileChosenText').text(file.name);
    console.log('Selected file:', file.name);

    // Upload file to FileStack
    fileStackClient
      .upload(file)
      .then((response) => {
        uploadedFileUrl = response.url; // Assign the URL to the global variable
        console.log('File uploaded successfully. URL:', uploadedFileUrl);

        // Update UI after upload success
        $('#fileChosenText').text(`Uploaded: ${file.name}`);
      })
      .catch((error) => {
        console.error('File upload failed:', error);
      });
  });
});
 

