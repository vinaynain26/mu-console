    function validateInputBlur(fieldId, fieldName) {
        const inputValue = $(`#${fieldId}`).val().trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const numberRegex = /^\d+$/;

        if (inputValue === "") {
            $(`#${fieldName}ReportVal`).removeClass('warning');
        } else {
            $(`#${fieldName}ReportVal`).addClass('warning');
        }
    }


    function hideApplyNowPopUpMainUG() {
        let applyNowPopUp = document.getElementById("UgdownloadBrochure");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active")
        }

      
        if ($('#nameReport').length) $('#nameReport').val("");
        if ($('#emailReport').length) $('#emailReport').val("");
        if ($('#numberReport').length) $('#numberReport').val("");
        if ($('#qualificationReport').length) $('#qualificationReport').val("").trigger("change");
    
        toggleClassIfExists("#nameReportVal", "warning", "add");
        toggleClassIfExists("#emailReportVal", "warning", "add");
        toggleClassIfExists("#numberReportVal", "warning", "add");
        toggleClassIfExists("#qualificationReportVal", "warning", "add");
        
        
        document.body.style.overflow = 'auto';
    }

    // Ensure popup handlers are always available globally.
    window.hideApplyNowPopUpMainUG = hideApplyNowPopUpMainUG;
    window.UgdownloadBrochure13 = UgdownloadBrochure13;

    // Fallback close binding in case inline onclick doesn't fire.
    const ugPopupCloseBtn = document.getElementById("ugPopupCloseBtn");
    if (ugPopupCloseBtn) {
        ugPopupCloseBtn.addEventListener("click", hideApplyNowPopUpMainUG);
    }



</script>