<script>


    function toggleClassIfExists(selector, className, action) {
        const el = document.querySelector(selector);
        if (!el) return;

        if (action === "add") {
            el.classList.add(className);
        } else if (action === "remove") {
            el.classList.remove(className);
        }
    }

    function UgdownloadBrochure13(formTitle, destination) {
        const form = document.getElementById("UgdownloadBrochure");
        const h2 = document.querySelector("#Ug_form_heading");

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);

        toggleClassIfExists("#SuccessMessage", "hide", "add");
        toggleClassIfExists("#submitbuttonreport", "hide", "remove");
        toggleClassIfExists("#leadformContainer", "hide", "remove");
        toggleClassIfExists("#Ug_form_heading", "hide", "remove");
        
        // Disable scrolling when popup is open
        document.body.style.overflow = 'hidden';
    }
    // let name = $('#nameReport').val();
