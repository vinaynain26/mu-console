                    </svg>
                </div>
            </div>

            <div class="PopupformWrapper" id="leadformContainer">
                <form action="">

                    <div id="dropshippingChallengesContainer"></div>

                </form>  

                <div class="submitWrapper">
                    <div class="gradientButton whiteHover">
                        <button class="button iconButton" id="dropshippingSubmit">
                            Save
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path d="M13.1589 4.145L2.8125 14.4553L3.54115 15.1875L13.8875 4.87722L13.1589 4.145Z"
                                    fill="#090909" />
                                <path
                                    d="M14.0929 12.929C11.9657 10.2216 11.8005 6.35689 13.7831 3.53585C13.7418 3.49451 14.4337 4.22819 14.4233 4.21786C11.6456 6.16056 7.77318 5.98489 5.10898 3.85618L6.04868 2.8125C7.97971 5.05487 11.5423 5.11687 13.8761 3.43251C13.8657 3.43251 14.5679 4.14552 14.5163 4.11452C12.5336 6.27422 12.7608 10.1493 15.1875 11.8543L14.0826 12.9393L14.0929 12.929Z"
                                    fill="#090909" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>
</main>

<script>
    $(document).ready(function () {

        $(document).on('click', '.deleteSocialBtn', function () {
            $(this).closest('.other-social-entry').remove();
        });

        $(document).on('click', '.addOtherSocialEntry', function () {
            const parentId = $(this).data('id');
            const container = $(`.dropshipping-social-wrapper[data-id="${parentId}"] .other-social-container`);
            let count = parseInt(container.attr("data-count") || 0);
            const newId = `${parentId}_other_${count}`;

            const newEntry = $(`
                
                <div class="formField isImp other-social-entry">
                <div class="otherSocialWrapper">
                 <input type="text" name="Other" id="otherSocial_${newId}" placeholder="Other Social">
                  <p class="msg-error" id="otherSocial_${newId}Error"></p>
                </div>
                   
                    <button type="button" class="deleteSocialBtn" title="Remove Social">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.5 3.5H2.5" stroke="#E53935" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6.5 6.5V10.5" stroke="#E53935" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M9.5 6.5V10.5" stroke="#E53935" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12.5 3.5V13C12.5 13.1326 12.4473 13.2598 12.3536 13.3536C12.2598 13.4473 12.1326 13.5 12 13.5H4C3.86739 13.5 3.74021 13.4473 3.64645 13.3536C3.55268 13.2598 3.5 13.1326 3.5 13V3.5" stroke="#E53935" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10.5 3.5V2.5C10.5 2.23478 10.3946 1.98043 10.2071 1.79289C10.0196 1.60536 9.76522 1.5 9.5 1.5H6.5C6.23478 1.5 5.98043 1.60536 5.79289 1.79289C5.60536 1.98043 5.5 2.23478 5.5 2.5V3.5" stroke="#E53935" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>



                   
                </div>
            `);

            container.append(newEntry);
            container.attr("data-count", count + 1);

            attachFieldValidation([
                {
                    fieldId: `otherSocial_${newId}`,
                    errorMessage: "This field is required"
                }
            ]);
        });

        $('#dropshippingSubmit').on('click', async function (e) {
            e.preventDefault();

            const $entry = $('.dropshippingItem');
            const entryId = $entry.data('id');

            const requiredFields = [
                {{!-- { id: `dropshippingCurrency_${entryId}`, message: "Please select a currency" },
                { id: `dropshippingAmount_${entryId}`, message: "Please enter amount generated" }, --}}
                { id: `dropshippingProduct_${entryId}`, message: "Please enter product" },
                { id: `dropshippingCategory_${entryId}`, message: "Please select category" },
                { id: `dropshippingCompany_${entryId}`, message: "Please select company" },
                { id: `dropshippingInstagram__${entryId}`, message: "Please enter Instagram" },
                { id: `dropshippingYouTube__${entryId}`, message: "Please enter YouTube" }
            ];

            let isValid = true;
            requiredFields.forEach(({ id, message }) => {
                const result = validateField(id, message);
                if (!result) isValid = false;
            });

            const initialPhoto = initialDropshippingChallengesData?.dropshippingChallenges?.[0]?.photo || null;

            if (!initialPhoto) {
                isValid = validateFileField(`dropshippingPhoto_${entryId}`) && isValid;
            }

            // Validate "Other Socials"
            $entry.find(`.other-social-container input[id^="otherSocial_"]`).each(function () {
                const id = $(this).attr('id');
                if (!validateField(id, 'This filed is requried')) isValid = false;
            });

            if (!isValid) return;

            let photoURL = initialDropshippingChallengesData?.dropshippingChallenges[0]?.photo || null
            const $submitBtn = $('#dropshippingSubmit');
            $submitBtn.prop('disabled', true).text('Submitting...');
            
            try{

                photoURL = await handleFilestackUpload(`dropshippingPhoto_${entryId}`, initialDropshippingChallengesData.dropshippingChallenges[0] || {}, 'photo');

                // Build `socials` array
                const socials = [];

                const instaVal = $(`#dropshippingInstagram__${entryId}`).val().trim();
                if (instaVal) socials.push({ platform: 'Instagram', url: instaVal });

                const ytVal = $(`#dropshippingYouTube__${entryId}`).val().trim();
                if (ytVal) socials.push({ platform: 'YouTube', url: ytVal });

                $(`.dropshipping-social-wrapper[data-id="${entryId}"] .other-social-container input[type="text"]`).each(function () {
                    const url = $(this).val().trim();
                    if (!url) return;

                    let hostname;
                    try {
                        hostname = new URL(url).hostname.replace('www.', '');
                    } catch (e) {
                        hostname = 'Other';
                    }

                    const platform = hostname
                        .split('.')[0]
                        .replace(/^\w/, c => c.toUpperCase());

                    socials.push({ platform, url });
                });

                // Final payload
                const payload = {
                    photo : photoURL,
                    currency: $(`#dropshippingCurrency_${entryId}`).val(),
                    amountGenerated: $(`#dropshippingAmount_${entryId}`).val().trim(),
                    product: $(`#dropshippingProduct_${entryId}`).val().trim(),
                    category: $(`#dropshippingCategory_${entryId}`).val(),
                    company: $(`#dropshippingCompany_${entryId}`).val().trim(),
                    socials
                };

                const initial = initialDropshippingChallengesData.dropshippingChallenges[0] || {};
                const hasInitial = !!initialDropshippingChallengesData?.dropshippingChallenges?.length;

                const userId = window.location.pathname.split('/').pop();
                const requestPayload = {
                    section: 'dropshippingChallenges',
                    actions: [{
                        action: hasInitial ? 'update' : 'add',
                        data: payload,
                        targetId : entryId
                    }]
                };

                let socialsChanged = false;

                if (Array.isArray(initial.socials) && Array.isArray(socials)) {
                    if (initial.socials.length !== socials.length) {
                        socialsChanged = true;
                    } else {
                        for (let i = 0; i < socials.length; i++) {
                            const oldItem = initial.socials[i];
                            const newItem = socials[i];

                            if (
                                String(oldItem.platform ?? '') !== String(newItem.platform ?? '') ||
                                String(oldItem.url ?? '') !== String(newItem.url ?? '')
                            ) {
                                socialsChanged = true;
                                break;
                            }
                        }
                    }
                } else {
                    socialsChanged = String(initial.socials ?? '') !== String(socials ?? '');
                }

                const isChanged = (
                    String(initial.photo ?? '') !== String(payload.photo ?? '') ||
                    String(initial.currency ?? '') !== String(payload.currency ?? '') ||
                    String(initial.amountGenerated ?? '') !== String(payload.amountGenerated ?? '') || 
                    String(initial.product ?? '') !== String(payload.product ?? '') ||
                    String(initial.category ?? '') !== String(payload.category ?? '') ||
                    String(initial.company ?? '') !== String(payload.company ?? '') ||
                    String(initial.socials ?? '') !== String(payload.socials ?? '') ||
                    socialsChanged
                );

                if(!isChanged){
                    console.log("No changes detected. Request will not be made.");
                    alert('No Changes');
                    return;
                }

                $.ajax({
                    url: `{{apiBaseURL}}/api/student-profile/${userId}/draft`,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestPayload),
                    success: function (res) {
                        renderProfile(res.draft)
                        closeDropshippingChallange(); 
                    },
                    error: function (err) {
                        console.error('Submission failed', err);
                        alert(err?.responseJSON?.Message || 'Something went wrong');
                    }
                });
                
            }catch (error) {
                console.error("Photo upload or submission failed:", error);
                alert("Something went wrong during submission.");
            } finally {
                $submitBtn.prop('disabled', false).html(`Save
                    <svg  
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    >
                    <path
                        d="M13.1589 4.145L2.8125 14.4553L3.54115 15.1875L13.8875 4.87722L13.1589 4.145Z"
                        fill="#090909"
                    />
                    <path
                        d="M14.0929 12.929C11.9657 10.2216 11.8005 6.35689 13.7831 3.53585C13.7418 3.49451 14.4337 4.22819 14.4233 4.21786C11.6456 6.16056 7.77318 5.98489 5.10898 3.85618L6.04868 2.8125C7.97971 5.05487 11.5423 5.11687 13.8761 3.43251C13.8657 3.43251 14.5679 4.14552 14.5163 4.11452C12.5336 6.27422 12.7608 10.1493 15.1875 11.8543L14.0826 12.9393L14.0929 12.929Z"
                        fill="#090909"
                    />
                    </svg>`
                );
            }

        });



    });

</script>