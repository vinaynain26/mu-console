<script>


    function triggerBrochureDownload(destination) {
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

        if (isIOS) {
            // iOS Safari often blocks async window.open; same-tab navigation is more reliable.
            window.location.href = destination;
            return;
        }

        const link = document.createElement("a");
        link.href = destination;
        link.target = "_blank";
        link.rel = "noopener";
        link.download = "";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function PgdownloadBrochure(formTitle, destination) {
        console.log('PgdownloadBrochureCalled')

        console.log('destination1234', destination)
        const form = document.getElementById("PGdownloadBrochure");
        const h2 = document.querySelector("#Pg_form_heading");

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);

        document.querySelector("#SuccessMessage").classList.add("hide");
        document.querySelector("#submitbuttonreport").classList.remove("hide");
        document.querySelector("#leadformContainer").classList.remove("hide");
        document.querySelector("#Pg_form_heading").classList.remove("hide");

        // Disable scrolling when popup is open
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
    }
    // let name = $('#nameReport').val();
    // let email = $('#emailReport').val();
    // let number = $('#numberReport').val();
