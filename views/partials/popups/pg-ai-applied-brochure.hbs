    function validateInputBlur(fieldId, fieldName) {
        const inputValue = $(`#${fieldId}`).val().trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const numberRegex = /^\d+$/;

        if (inputValue === "") {
            $(`#${fieldName}ReportVal`).removeClass('warning');
        } else {
            $(`#${fieldName}ReportVal`).addClass('warning');
        }
    }


    function hideApplyNowPopUpMainPG() {
        let applyNowPopUp = document.getElementById("PGdownloadBrochure");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active");
        }

        $('#nameReport').val("");
        $('#emailReport').val("");
        $('#numberReport').val("");
        $('#qualificationReport').val("").trigger("change");

        document.querySelector("#nameReportVal").classList.add("warning");
        document.querySelector("#emailReportVal").classList.add("warning");
        document.querySelector("#numberReportVal").classList.add("warning");
        document.querySelector("#qualificationReportVal").classList.add("warning");

        // Re-enable scrolling when popup is closed - remove inline style completely
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
    }

    // Close popup when clicking outside (on the background) or pressing ESC – same as UG finance popup
    document.addEventListener('DOMContentLoaded', function () {
        const popup = document.getElementById("PGdownloadBrochure");
        if (popup) {
            popup.addEventListener('click', function (e) {
                if (e.target === popup) {
                    hideApplyNowPopUpMainPG();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && popup.classList.contains('active')) {
                    hideApplyNowPopUpMainPG();
                }
            });

            const observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                        if (!popup.classList.contains('active')) {
                            document.body.style.overflow = '';
                            document.documentElement.style.overflow = '';
                        }
                    }
                });
            });
            observer.observe(popup, {
                attributes: true,
                attributeFilter: ['class']
            });
        }
    });
</script>