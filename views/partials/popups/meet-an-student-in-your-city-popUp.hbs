// Function to format date as '13th July | Wednesday'
function formatEventDate(eventDateString) {
    const eventDate = new Date(eventDateString);

    // Format day with ordinal suffix
    const day = eventDate.getDate();
    const dayWithSuffix = day + (day % 10 === 1 && day !== 11 ? "st" : day % 10 === 2 && day !== 12 ? "nd" : day % 10 === 3 && day !== 13 ? "rd" : "th");

    // Format month
    const month = eventDate.toLocaleString('default', { month: 'long' });

    // Get the day of the week
    const dayOfWeek = eventDate.toLocaleString('default', { weekday: 'long' });

    // Return formatted date string
    return `${dayWithSuffix} ${month} | ${dayOfWeek}`;
}

