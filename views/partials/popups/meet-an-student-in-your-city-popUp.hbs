    function bindEvent(event) {
        $('#header_mainImage').attr({
            src: event.mainImage,
            alt: event.title
        });

        $('#header_thumbNail').attr({
            src: event.thumbNail,
            alt: event.title
        });


        let html = "";
        event.formDetails.forEach((form, index) => {
            html += `
                <h1 class="font-24 font-bold font-white ${index != 0 ? 'mt30' : ''}">${form.heading}</h1>

                    ${form?.description ? `<p class="font-14 font-regular font-grey8 mt10 formDescriptiton">
                        ${form.description}
                    </p>` : ''}


                    ${form?.bulletPoints?.length > 0 ?
                    `<h2 class="font-14 font-bold font-white mt25">${form.bulletPointsHeading || ""}</h2>
                    <ul class="eventList">
                       
                       ${form.bulletPoints.map(bullet => {
                        return `
                        <li class="font-14 font-regular font-white">
                            <img  src="https://files.mastersunion.link/resources/svg/listItemIcon.svg" alt="">
                            ${bullet.text.trim()}
                        </li>`;
                    }).join("")}
                    </ul>` : ''}

                   <div class="rgbDetails mt25">
                    <div class="darkPill hide">
                        <img src="https://files.mastersunion.link/resources/svg/rgbLocation.svg" alt=""> <span class="rgbGradient font-12">${"Masters’ Union Gurugram Campus"}</span>
                    </div>
                    </div>
                `;
        });

        $("#eventDescription").html(html);

    }


    async function getEventBySlug(slug) {
        const courseEnum = {
            "PGP-TBM": "Post Graduate Programme in Technology & Business Management",
            "UG": "Undergraduate Programme",
            "PGP Rise": "PGP Rise"
        }

        const res = await fetch(`{{apiBaseURL}}/api/eventbyslug/${slug}`);
        const event = await res.json();
        event_Id = event.Data?._id;
        event_Slug = event.Data?.slug;
        eventName = event.Data?.title;
        mode = event.Data?.eventLocation;
        Specialization = event.Data?.eventCourseType;
        course = courseEnum[event.Data?.eventCourseType];

        return event.Data;
    }


    $(document).ready(function () {
        (function deferCscUntilMeetStudentPopupOpen() {
            function kick() {
                if (window.__muCscGeoMeetPopupLoaded) return;
                var nodes = document.querySelectorAll(
                    "main.newEventLeadsBigPopup .popupContainerOuter.ApplyNow"
                );
                var anyActive = Array.prototype.some.call(nodes, function (el) {
                    return el.classList.contains("active");
                });
                if (!anyActive) return;
                window.__muCscGeoMeetPopupLoaded = true;
                getAllCountries();
            }
            kick();
            if (typeof MutationObserver !== "undefined") {
                document
                    .querySelectorAll("main.newEventLeadsBigPopup .popupContainerOuter.ApplyNow")
                    .forEach(function (el) {
                        new MutationObserver(kick).observe(el, {
                            attributes: true,
                            attributeFilter: ["class"],
                        });
                    });
            }
        })();

        $('#selectCountryCode').change(function () {
            var countryCode = $(this).val();
            getAllStates(countryCode);
        });

        $('#userState').change(function () {
            var countryCode = $('#selectCountryCode').val();
            var stateCode = $(this).val();
            getCities(countryCode, stateCode);
        });


        function getAllCountries() {
            $.ajax({
                url: 'https://api.mastersunion.org/api/geo/countries',
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#selectCountryCode').empty().append($("<option value='' disabled selected></option>").text("Select your country"));
                $.each(response, function (idx, country) {
                    $('#selectCountryCode').append($("<option></option>")
                        .attr("value", country.iso2)
                        .text(`${country.phonecode} (${country.name})`));
                });

                $('#selectCountryCode').val('IN').change();
            });
        }

        function getAllStates(countryCode) {
            $.ajax({
                url: `https://api.mastersunion.org/api/geo/countries/${countryCode}/states`,
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#userState').empty().append($("<option value='' disabled selected></option>").text("Select your state"));
                $.each(response, function (idx, state) {
                    $('#userState').append($("<option></option>")
                        .attr("value", state.iso2)
                        .text(state.name));
                });
            });
        }

        function getCities(countryCode, stateCode) {
            $.ajax({
                url: `https://api.mastersunion.org/api/geo/countries/${countryCode}/states/${stateCode}/cities`,
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#userCity').empty().append($("<option value='' disabled selected></option>").text("Select your city"));
                $.each(response, function (idx, city) {
                    $('#userCity').append($("<option></option>")
                        .attr("value", city.name)
                        .text(city.name));
                });
            });
        }
    });

