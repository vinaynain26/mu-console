        $("#alumini_city").text(`${event.eventCity}`);
        event.slots.forEach((slot, index) => {
            const slotDate = new Date(slot.dateTime);
            const currentDate = new Date();
            if (slotDate < currentDate) {
                return; 
            }
            const formattedDate = formatDate(slotDate); 
            const formattedTime = formatTime(slotDate);
            const option = document.createElement('option');
            option.value = JSON.stringify(slot);
            option.text = slot.isDisabled === 1 ? `${formattedDate}, ${formattedTime} (Booked)` : `${formattedDate}, ${formattedTime}`;
            
            
            if (slot.isDisabled) {
                option.disabled = true;
            }

            
            userSlot.appendChild(option);
        });
    }

