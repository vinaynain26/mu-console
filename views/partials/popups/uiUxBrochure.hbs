    const UIUX_BROCHURE_WIDGET_ID = "c5f9d1bc-ddc4-4a02-80fe-aea993fde813";
    const UIUX_BROCHURE_DEFAULT_DESTINATION = "https://files.mastersunion.link/brochures/01042026/v1/PGUIUXAIProductDesign.pdf";


    function triggerBrochureDownloadUiUx(destination) {
    // Guard clause — agar destination missing ho to default use karo
    if (!destination || destination === "undefined") {
        destination = UIUX_BROCHURE_DEFAULT_DESTINATION;
    }

    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || 
                  (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    if (isIOS) {
        window.location.href = destination; // ab guaranteed valid URL hai
        return;
    }

    const link = document.createElement("a");
    link.href = destination;
    link.target = "_blank";
    link.rel = "noopener";
   // link.download = "https://files.mastersunion.link/brochures/01042026/v1/PGUIUXAIProductDesign.pdf"; // explicit naam do
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}
    function UgdownloadBrochure19(formTitle, destination) {
        const form = document.getElementById("UgdownloadBrochure19");
        const h2 = document.querySelector("#Ug_form_heading");

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);
        form.setAttribute("data-download-triggered", "false");

        document.querySelector("#SuccessMessage").classList.add("hide");
        document.querySelector("#submitbuttonreport").classList.remove("hide");
        document.querySelector("#leadformContainer").classList.remove("hide");
        document.querySelector("#Ug_form_heading").classList.remove("hide");
        
        // Disable scrolling when popup is open
        document.body.style.overflow = 'auto';
    }

    function getUiUxWidgetMessagePayload(rawData) {
        let payload = rawData;

        if (typeof payload === "string") {
            try {
                payload = JSON.parse(payload);
            } catch (error) {
                return null;
            }
        }

        if (!payload || typeof payload !== "object") {
            return null;
        }

        const eventName = payload.event || payload.type || payload.name || payload.eventName || payload.action;

        if (eventName !== "WIDGET_FORM_SUBMISSION_SUCCESSFUL") {
            return null;
        }

        const widgetId =
            payload.widgetId ||
            payload.formId ||
            payload.id ||
            (payload.data && (payload.data.widgetId || payload.data.formId || payload.data.id));

        return { widgetId };
    }

    window.addEventListener("message", function (event) {
        const parsedMessage = getUiUxWidgetMessagePayload(event.data);
        if (!parsedMessage) return;

        const popupForm = document.getElementById("UgdownloadBrochure19");
        if (!popupForm || !popupForm.classList.contains("active")) return;

        if (parsedMessage.widgetId && parsedMessage.widgetId !== UIUX_BROCHURE_WIDGET_ID) return;
        if (popupForm.getAttribute("data-download-triggered") === "true") return;

        popupForm.setAttribute("data-download-triggered", "true");

        const destination = popupForm.getAttribute("data-destination") || UIUX_BROCHURE_DEFAULT_DESTINATION;
        triggerBrochureDownloadUiUx(destination);

        document.querySelector("#SuccessMessage").classList.remove("hide");
        document.querySelector("#submitbuttonreport").classList.add("hide");
        document.querySelector("#leadformContainer").classList.add("hide");
        document.querySelector("#Ug_form_heading").classList.add("hide");
    });
