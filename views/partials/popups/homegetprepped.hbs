            isValid = false;
        }

        if (!formData.email.val() || !isValidEmail(formData.email.val())) {
            showError('homeGetPrepEmail', 'Please enter a valid email address');
            isValid = false;
        }

        if (!formData.phone.val() || !isValidPhone(formData.phone.val())) {
            showError('homeGetPrepPhone', 'Please enter a valid 10-digit phone number');
            isValid = false;
        }

        if (!formData.company.val()) {
            showError('homeGetPrepCompanyOrCollege', `Please enter your ${formData.title === 'Student' ? 'college name' : 'company name'}`);
            isValid = false;
        }

        if (!formData.designation.val()) {
            showError('homeGetPrepDesignationOrQualification', `Please enter your ${formData.title === 'Student' ? 'qualification' : 'designation'}`);
            isValid = false;
        }

        if (formData.title === 'Student') {
            if (!formData.yrsOfExp) {
                showError('homeGetPrepCurrentYearError', 'Please enter your current year');
                isValid = false;
            }
        } else {
            if (!formData.yrsOfExp || formData.yrsOfExp === 'Select The Option') {
                showError('homeGetPrepYearOfExperience', 'Please select your years of experience');
                isValid = false;
            }
        }

        if (formData.linkedin.val() && !isValidLinkedInUrl(formData.linkedin.val())) {
            showError('homeGetPrepLinkedIn', 'Please enter a valid LinkedIn profile URL');
            isValid = false;
        }

        return isValid;
    }

    function submitForm() {
        if (!validateForm()) {
            return;
        }

        $('#homeGetPrepSubmit').html('Submitting...').prop('disabled', true)

        const formData = {
            firstname: $('#homeGetPrepFirstname').val(),
            lastname: $('#homeGetPrepLastname').val(),
            email: $('#homeGetPrepEmail').val(),
            number: $('#homeGetPrepPhone').val(),
            designation: $('#homeGetPrepDesignationOrQualification').val(),
            company: $('#homeGetPrepCompanyOrCollege').val(),
            linkedin: $('#homeGetPrepLinkedIn').val(),
            title: userType === 'student' ? 'Student' : 'Working Professional',
            yrsOfExp: userType === 'student' ? $('#homeGetPrepCurrentYearError').val() : $('#homeGetPrepYearOfExperience').val()
        };

        fetch('https://apiv3.getprepped.in/api/registerAndBookSlot', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-api-key': 'QmFzZT/Y0RW5jb2RlZEl/eQ'
            },
            body: JSON.stringify(formData)
        })
            .then(response => response.json())
            .then(data => {
                if (data.IsSuccess) {
                    $('#SuccessMessage').removeClass('hide');
                    $('#leadformContainer').addClass('hide');
                } else {
                    if (data.Message === "User already exists! Please login to continue.") {
                        showError('homeGetPrepEmail', 'Already Registered');
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
            })
            .finally(() => {
                $('#homeGetPrepSubmit').html('Submit Now').prop('disabled', false)
            });
    }

    function hideApplyNowPopUp() {
        let applyNowPopUp = document.getElementById("ApplyNowPopUpNEWs");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active");
        }
        document.body.style.overflow = "visible";
        $(".inputGroup input").val("");
        $(".inputGroup select").prop("selectedIndex", 0);
        $("span.error-message").text("");
        $("#homeGetPrepSubmit").html('Submit Now').prop('disabled', false);
    }
</script> --}}