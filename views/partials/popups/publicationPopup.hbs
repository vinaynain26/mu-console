<main>
    <div class="popupContainerOuter displyScreenResolution ApplyNow scrollPopup newHomePagePopup homeCrossPopup" id="publicationPopUp">
        <div class="popupContainer" id="publicationFormContainer">
            <div class="fromTophead">
                <h2 class="font-56 font-bold font-black1 letter-spacing1" id="form_heading">
                    Submit your Publication
                </h2>
                <button id="publicationCloseButton" class="popUpCloseBtnWrap homeCrossfix">
                    <img  src="https://files.mastersunion.link/resources/svg/crossIcon.svg" class="invert-img" alt="">
                </button>
            </div>
            <div class="PopupformWrapper">
                <div class="left mob-hide">
                    <img  src="https://images.mastersunion.link/brochures/18022025/v1/StudentsWork.webp" alt="MU Students">
                </div>
                <div class="right">
                    <div class="formContainer active">
                        <div class="flexInput" id="formain">
                            <div class="inputGroup">
                                <label for="publicationFullname" class="font-14 font-medium font-black1">Full Name <span class="font-red">*</span></label>
                                <input type="text" placeholder="Enter your full name" class="inputBox font-16 font-black1 font-medium" id="publicationFullname" onblur="validatePublicationFullname()">
                                <p id="publicationFullname_error" class="error-message"></p>
                            </div>
                            <div class="inputGroup">
                                <label for="publicationEmail" class="font-14 font-medium font-black1">Email <span class="font-red">*</span></label>
                                <input type="email" placeholder="Enter your email" class="inputBox font-16 font-black1 font-medium" id="publicationEmail" onblur="validatePublicationEmail()">
                                <p id="publicationEmail_error" class="error-message"></p>
                            </div>
                            <div class="inputGroup">
                                <label for="publicationTitle" class="font-14 font-medium font-black1">Publication Title <span class="font-red">*</span></label>
                                <input type="text" placeholder="Enter publication title" class="inputBox font-16 font-black1 font-medium" id="publicationTitle" onblur="validatePublicationTitle()">
                                <p id="publicationTitle_error" class="error-message"></p>
                            </div>
                            <div class="inputGroup">
                                <label for="publicationFile" class="font-14 font-medium font-black1">Article Upload <span class="font-red">*</span></label>
                                <input type="file" id="publicationFile" class="fileInput" accept=".pdf,.docx">
                                <p id="publicationFile_error" class="error-message"></p>
                            </div>
                            <div class="inputGroup">
                                <div class="consentCheckWrapper">
                                    <div class="consentCheckRow">
                                        <input type="checkbox" id="publicationAgreeTerms" class="checkboxInput"/>
                                        <label for="publicationAgreeTerms">I authorize Masters&rsquo; Union and its affiliates to process my personal data to send me information about programs related to my application, admission, or enrollment through digital channels (including email, phone calls, RCS, SMS, and WhatsApp), in accordance with Masters&rsquo; Union <a href="https://mastersunion.org/privacy-policy" target="_blank">Privacy Policy</a>, <a href="https://mastersunion.org/cookie-policy" target="_blank">Cookie Policy</a>, and <a href="https://mastersunion.org/terms-and-conditions" target="_blank">Terms &amp; Conditions</a>. By submitting my details, I agree to receive communications related to my application, events, and program updates. Message frequency may vary and message and data rates may apply. I may withdraw my consent at any time by replying STOP, UNSUBSCRIBE, or HELP for assistance.</label>
                                    </div>
                                    <p id="consentCheckErrorPub1" class="font-12 font-red font-regular warning consentCheckError">Please accept the consent to continue</p>
                                </div>
                                <p id="publicationAgreeTerms_error" class="error-message"></p>
                            </div>
                        </div>
                    </div>
                    <div class="formFooter" id="submitbuttonreport">
                        <div class="gradientButton whiteHover" onclick="submitPublicationForm()">
                            <button class="button iconButton gtmUgDwnBroPop" id="publicationSubmitButton">
                                Submit
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                    xmlns="https://www.w3.org/2000/svg">
                                    <path d="M16.0208 9.41421L7.41421 18.0208L6 16.6066L14.6066 8H7.02082V6H18.0208V17H16.0208V9.41421Z" fill="white"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="SuccessMessage" class="congrats-box hide">
                <button id="publicationFormSuccessPage" class="popUpCloseBtnWrap homeCrossfix" onclick="hideThanksPage()" aria-label="Close">
                    <img  src="https://files.mastersunion.link/resources/svg/crossIcon.svg" class="invert-img" alt="Close">
                </button>
                <img src="https://files.mastersunion.link/assets/img/thankyou_logo.svg" alt="">

                <h3 class="thankyouboxHeading mt-10 gtmUgDwnBroGotit" id="gtmUgDwnBroGotitId">Thank You</h3>
                <p class="text-2 gtmUgDwnBroGotPara" id="gtmUgDwnBroGotParaId">We've successfully received your publication. Our team will get back to you, if your publication is shortlisted.</p>
                <p class="text-2">For any queries please contact us at <a class="font-red" href="mailto:pummy.ralli@mastersunion.org">pummy.ralli@mastersunion.org</a></p>
            </div>
    </div>
</main>


<script>

    function publicationPopup(formTitle, destination) {
        const form = document.getElementById("publicationPopUp");
        const h2 = document.querySelector("#form_heading");

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);

        $("#publicationFormContainer input").val("");
        $("#publicationFormContainer input[type='checkbox']").prop("checked", false);
        document.getElementById('consentCheckErrorPub1')?.classList.add('warning');

        document.querySelector("#SuccessMessage").classList.add("hide");
        document.querySelector("#submitbuttonreport").classList.remove("hide");
        document.querySelector("#leadformContainer").classList.remove("hide");
        document.querySelector("#form_heading").classList.remove("hide");
    }

    $('#publicationCloseButton').click(function(){
        $('#publicationPopUp').removeClass('active')
    })

    const fileStackClient = filestack.init('{{filestackApiKey}}');
    let articleFileUrl = ''

    // Per-field onblur validation (matches submit-time checks + inline .error convention)
    function showFieldError(inputId, message) {
        $(`#${inputId}`).nextAll(".error").remove();
        $(`#${inputId}`).after(`<p class="error font-red font-12 mt-2">${message}</p>`);
    }
    function clearFieldError(inputId) {
        $(`#${inputId}`).nextAll(".error").remove();
    }
    function validatePublicationFullname() {
        const fullName = $("#publicationFullname").val().trim();
        if (fullName === "") { showFieldError("publicationFullname", "Full Name is required"); return false; }
        clearFieldError("publicationFullname");
        return true;
    }
    function validatePublicationEmail() {
        const email = $("#publicationEmail").val().trim();
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (email === "") { showFieldError("publicationEmail", "Email is required"); return false; }
        if (!emailPattern.test(email)) { showFieldError("publicationEmail", "Enter a valid email"); return false; }
        clearFieldError("publicationEmail");
        return true;
    }
    function validatePublicationTitle() {
        const title = $("#publicationTitle").val().trim();
        if (title === "") { showFieldError("publicationTitle", "Publication title is required"); return false; }
        clearFieldError("publicationTitle");
        return true;
    }

    async function submitPublicationForm(e) {
        e.preventDefault();
        let isValid = true;

        $(".error").remove();

        function showError(inputId, message) {
            isValid = false;

            $(`#${inputId}`).next(".error").remove(); 
            $(`#${inputId}`).after(`<p class="error font-red font-12 mt-2">${message}</p>`);
        }

        const fullName = $("#publicationFullname").val().trim();
        if (fullName === "") showError("publicationFullname", "Full Name is required");

        const email = $("#publicationEmail").val().trim();
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (email === "") showError("publicationEmail", "Email is required");
        else if (!emailPattern.test(email)) showError("publicationEmail", "Enter a valid email");

        const title = $("#publicationTitle").val().trim();
        if (title === "") showError("publicationTitle", "Publication title is required");

        const file = $("#publicationFile")[0].files[0];
        if (!file) showError("publicationFile", "Please upload your article");

        if (!document.getElementById('publicationAgreeTerms')?.checked) { document.getElementById('consentCheckErrorPub1').classList.remove('warning'); isValid = false; } else { document.getElementById('consentCheckErrorPub1').classList.add('warning'); }

        if (isValid) {

            $('#publicationSubmitButton').html(`Submitting...`);

            if(file){
                try{
                    let response = await fileStackClient.upload(file);
                    articleFileUrl = response.url
                }catch(err){
                    console.error('Error uploading image:', err);
                }
            }

            const formData = {
                fullName,
                email,
                publicationTitle : title,
                articleFileUrl,
                consentCheck: document.getElementById('publicationAgreeTerms')?.checked || false
            }


            $.ajax({
                url: `{{apiBaseURL}}/api/intersect/addPublication`, 
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData), 
                success: function (response) {
                    console.log("Form submitted successfully:", response);
                    $('#publicationFormContainer').addClass('hide'); 
                    $('#SuccessMessage').removeClass('hide');
                },
                error: function (xhr, status, error) {
                    if (xhr.status === 409) {
                    showError("publicationEmail", "Email is Already Registered"); 
                    $('#publicationEmail').focus();
                    }
                    else if (xhr.status === 500) {
                        errorMessage = "Server error! Please try again.";
                        $("#serverErrorMessage").text(errorMessage).removeClass("hide");
                    } else if (xhr.status === 503) {
                        errorMessage = "Service unavailable. Please try again later.";
                        $("#serverErrorMessage").text(errorMessage).removeClass("hide");
                    }
                }
            })
            .always(function () {
                        $('#publicationSubmitButton').html(`Submit <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                                        xmlns="https://www.w3.org/2000/svg">
                                                                        <path
                                                                            d="M16.0208 9.41421L7.41421 18.0208L6 16.6066L14.6066 8H7.02082V6H18.0208V17H16.0208V9.41421Z"
                                                                            fill="white"></path>
                                                                    </svg>`);
            });
        }
    }

    $("#publicationSubmitButton").click(submitPublicationForm);

    $('#publicationFormSuccessPage').click(function(){
        $('#SuccessMessage').addClass('hide');
        $('#publicationFormContainer').removeClass('hide'); 
        $("#publicationPopUp").removeClass('active')
    })

</script>