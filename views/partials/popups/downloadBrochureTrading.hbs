                        <div id="your-element-id"></div>

                        <script data-target="#your-element-id" data-widget="1f87edd7-3681-4364-be06-b7f41c359e17"
                            src="https://widgets-v2.mastersunion.org/loader.js"></script>

                    </div>
                </div>
            </div>

        </div>
