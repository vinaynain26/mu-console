<main>
    <div class="popupContainerOuter ApplyNow" id="ApplyNowPopUpNEW">

        <div class="popupContainer">
            <div class="fromTophead">

                <h2 class="font-56 font-bold font-black1  letter-spacing1" id="form_heading">Download Brochure</h2>
                <div class="popUpCloseBtnWrap">
                    <img src="https://files.mastersunion.link/resources/svg/crossIcon.svg" class="invert-img" alt="Icon"
                        onclick="hideApplyNowPopUp();">

                </div>
            </div>
            <div id="tradingDownloadBrochureForm">

                <div class="PopupformWrapper" id="leadformContainer">
                    <div class="left mob-hide">
                        {{!-- <img src="https://files.mastersunion.link/resources/img/formleft.webp" alt=""> --}}
                        <img src="https://files.mastersunion.link/resources/img/pgpRisePopFbm.webp" alt="">
                    </div>
                    {{!-- <div class="right">
                        <iframe id="1eedc5bf-eb53-484a-922f-2462f5c97495" width="100%" height="388px"></iframe>
                        <script src="https://cdn.mastersunion.org/widget/iframe.js"></script>
                        <script>
                            new LoadWidget("1eedc5bf-eb53-484a-922f-2462f5c97495");
                        </script>
                    </div> --}}
