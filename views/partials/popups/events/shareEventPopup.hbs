<script>

    function closeShareEventPopup() {
        let shareEventPopup = document.getElementById("shareEventPoupUp");
        if (shareEventPopup) {
            shareEventPopup.classList.remove("active")
        }
        document.body.classList.remove("no-scroll");
    }


    function openShareEventPopup(formTitle, destination) {
        const form = document.getElementById("shareEventPoupUp");
        const h2 = document.querySelector("#form_heading");

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);

        document.body.classList.add("no-scroll");

        document.querySelector("#SuccessMessage").classList.add("hide");
        document.querySelector("#leadformContainer").classList.remove("hide");

    }
function share(platform) {
    const pageUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent(document.title);
    const message = encodeURIComponent("Check out this amazing page!");

    let shareUrl = '';
    switch (platform.toLowerCase()) { // Ensure case-insensitivity
        case 'facebook':
            shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`;
            break;
        case 'instagram':
            alert("Instagram does not support direct URL sharing via web. Please share manually.");
            return;
        case 'linkedin':
            shareUrl = `https://www.linkedin.com/shareArticle?url=${pageUrl}&title=${pageTitle}`;
            break;
        case 'whatsapp':
            shareUrl = `https://wa.me/?text=${message}%20${pageUrl}`;
            break;
        case 'x':
            shareUrl = `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`;
            break;
        case 'email':
            shareUrl = `mailto:?subject=${pageTitle}&body=${message}%20${pageUrl}`;
            break;
        default:
            console.error('Unsupported platform:', platform);
            return;
    }

    // Open the share URL in a new window
    window.open(shareUrl, '_blank');
}

    $(document).ready( function () {
        const currentUrl = window.location.href;
        const sharePageURL = document.getElementById('sharePageURL')

        sharePageURL.innerHTML = currentUrl;



        

    })

</script>