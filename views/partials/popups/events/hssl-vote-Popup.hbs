            // Hide the institute name field when not required
            $('#InstituteNameContinerhssl').addClass("hide");
            $('#InstituteNamehsslError').hide();
        } else {
            needValidationOrg = true;
            // Show and enable the institute name field when required
            $('#InstituteNameContinerhssl').removeClass("hide");
        }
    }
   
   
   
   
   
    function handleFormSubmit(e) {
        e.preventDefault();

