<script>
let currentCaptchaCode = "";

    // Function to generate CAPTCHA code and render it on canvas
    function generateCaptcha() {
      const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
      currentCaptchaCode = "";
      for (let i = 0; i < 6; i++) {
        currentCaptchaCode += chars.charAt(Math.floor(Math.random() * chars.length));
      }

      const canvas = document.getElementById('captchaCanvas');
      const ctx = canvas.getContext('2d');

      // Draw background
      ctx.fillStyle = "#f2f2f2";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Add noise
      for (let i = 0; i < 30; i++) {
        ctx.fillStyle = `rgba(${Math.random() * 255}, ${Math.random() * 255}, ${Math.random() * 255}, 0.3)`;
        ctx.beginPath();
        ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 5, 0, Math.PI * 2);
        ctx.fill();
      }

      // Draw CAPTCHA text
      ctx.font = "24px Arial";
      ctx.fillStyle = "#000";
      ctx.textBaseline = "middle";
      ctx.textAlign = "center";
      const x = canvas.width / 2;
      const y = canvas.height / 2;
      ctx.fillText(currentCaptchaCode, x, y);

      // Add distortion
      ctx.beginPath();
      ctx.moveTo(0, Math.random() * canvas.height);
      ctx.bezierCurveTo(canvas.width / 4, Math.random() * canvas.height, canvas.width / 2, Math.random() * canvas.height, canvas.width, Math.random() * canvas.height);
      ctx.strokeStyle = "rgba(0,0,0,0.2)";
      ctx.stroke();
    }

    // Initial CAPTCHA setup
    generateCaptcha();

    // Handle form submission
    let form = document.getElementById('captchaForm');
    let captchaInput = document.getElementById('captchaInput');
    let captchaError = document.getElementById('captchaError');
    let successMessage = document.getElementById('successMessage');





    function closeHsslVotePopup() {
        let applyNowPopUp = document.getElementById("leaderboardWaitlist");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active");

        }

        document.body.classList.remove("no-scroll");
    }


    function openHsslVotePopup(event) {

        event.stopPropagation()
        const form = document.getElementById("leaderboardWaitlist");

        form.classList.add("active");

        document.body.classList.add("no-scroll");

        document.querySelector("#SuccessMessage").classList.add("hide");
        document.querySelector("#leadformContainer").classList.remove("hide");

    }

    function onSucessVote(event) {

        event.preventDefault();
        $("#hsslVotePopUp").addClass("hide");
        $("#registerSuccess").removeClass("hide");
    }

    $(document).ready(function () {
        (function deferCscUntilHsslVotePopupOpen() {
            var el = document.getElementById("leaderboardWaitlist");
            if (!el) return;
            var started = false;
            function kick() {
                if (started || !el.classList.contains("active")) return;
                started = true;
                getAllCountries();
            }
            kick();
            if (typeof MutationObserver !== "undefined") {
                new MutationObserver(kick).observe(el, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            }
        })();

        $('#selectCountryCode').change(function () {
            var countryCode = $(this).val();
            getAllStates(countryCode);
        });

        $('#userState').change(function () {
            var countryCode = $('#selectCountryCode').val();
            // get stateCode from data-StateCode value from the selected option
            var stateCode = $(this).find(':selected').data('state');

            console.log("stateCode", stateCode);

            getCities(countryCode, stateCode);
        });





        function getAllCountries() {
            $.ajax({
                url: 'https://api.mastersunion.org/api/geo/countries',
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#selectCountryCode').empty().append($("<option value='' disabled selected></option>").text("Select your country"));
                $.each(response, function (idx, country) {
                    $('#selectCountryCode').append($("<option></option>")
                        .attr("value", country.phonecode)
                        .text(`${country.phonecode} (${country.name})`));
                });

                $('#selectCountryCode').val('91').change();
            });
        }

        function getAllStates(countryCode) {
            $.ajax({
                url: `https://api.mastersunion.org/api/geo/countries/${countryCode}/states`,
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#userState').empty().append($("<option value='' disabled selected></option>").text("Select your state"));
                $.each(response, function (idx, state) {
                    $('#userState').append($("<option></option>")
                        .attr("value", state.name)
                        .attr("data-state", state.iso2)
                        .text(state.name));
                });
            });
        }

        function getCities(countryCode, stateCode) {
            $.ajax({
                url: `https://api.mastersunion.org/api/geo/countries/${countryCode}/states/${stateCode}/cities`,
                type: 'GET',
                headers: {
                    "Accept": "application/json"
                }
            }).done(function (response) {
                $('#userCity').empty().append($("<option value='' disabled selected></option>").text("Select your city"));
                $.each(response, function (idx, city) {
                    $('#userCity').append($("<option></option>")
                        .attr("value", city.name)
                        .text(city.name));
                });
            });
        }
    });
    let needValidationOrg = true;

    function handleGradeChange() {
