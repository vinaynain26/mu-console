            url: "{{apiBaseURL}}/api/leads/pushToNPF_UG",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                field_device_type: device,
                email: email,
                name: name,
                mobile: number,
                linkedinProfile: "",
                medium: utmMedium || medium,
