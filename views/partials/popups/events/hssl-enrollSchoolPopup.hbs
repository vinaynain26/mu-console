        schoolNumber: document.querySelector("#hsslEnrl_schoolNumber")
    }

    function enrollBtnHandler() {
        console.log('on submit');

        // Validate functions
        const validateNumber = (number) => /^\d{10}$/.test(number);
        const validateEmail = (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

        let name = enrollSchool.studentName?.value?.trim();
        let email = enrollSchool.studentEmail?.value?.trim();
        let number = enrollSchool.studentNumber?.value?.trim();
        let schoolName = enrollSchool.schoolName?.value?.trim();
        let city = enrollSchool.cityName?.value?.trim();
        let teacherName = enrollSchool.teacherName?.value?.trim();
        let schoolEmail = enrollSchool.schoolEmail?.value?.trim();
        let schoolNumber = enrollSchool.schoolNumber?.value?.trim();


        // print all

        // Check name validity
        if(!validateNameInput("hsslEnrl_studentName", "hsslEnrl_studentNameVal")) return;

        // Check email validity
        if (!validateEmail(email)) {
            console.log("email check fail")
            $('#hsslEnrl_studentEmailVal').text("Please enter a valid email address.");
