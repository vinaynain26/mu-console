                source: utmSource,
                //course: course,
                course: "course",
                Specialization: course,
                //"Course Preference": "Psychology and Marketing",
                sendMail: false,
                field_utm_url: window.location.href,
                leadSource: medium

            }),
            dataType: "json"
        });


        


    }

    function validateInputBlur(fieldId, fieldName) {
        const inputValue = $(`#${fieldId}`).val().trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const numberRegex = /^\d+$/;

        if (inputValue === "") {
            $(`#${fieldName}ReportVal`).removeClass('warning');
        } else {
            $(`#${fieldName}ReportVal`).addClass('warning');
        }
    }




    function closeHighSchoolEnrollPopup() {
        let applyNowPopUp = document.getElementById("enrollHsslSchool");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active")
        }
        // Restore body scrolling when popup is closed
        document.body.style.overflow = 'auto';
        $('#consentCheckHes').prop('checked', false);
        $('#consentCheckErrorHes').addClass('warning');
        resetEnrollForm();
    }

    function openHighSchoolEnrollMainPopup() {
        document.getElementById("enrollHsslSchool").classList.add("active");
        document.querySelector("#hssl_enroll_SuccessMessage").classList.add("hide");
        document.querySelector("#hssl_enroll_leadformContainer").classList.remove("hide");
        // Prevent body scrolling when popup is active
        document.body.style.overflow = 'hidden';
    }

</script>




