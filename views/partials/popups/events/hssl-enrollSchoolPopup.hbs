            return false; 
        } else {
            $('#hsslEnrl_studentEmailVal').addClass('warning');
        }

        if (!validateNumber(number)) {
            console.log("phone number check fail")
            $('#hsslEnrl_studentNumberVal').text("Please enter valid 10 digits phone number.");
            $('#hsslEnrl_studentNumberVal').removeClass('warning');
            return false; 
        } else {
            $('#hsslEnrl_studentNumberVal').addClass('warning');
        }
////////////////////////////////////////


        if (!schoolName) {
            $('#hsslEnrl_schoolNameVal').text("Please enter your school name.");
            $('#hsslEnrl_schoolNameVal').removeClass('warning');
            return false; 
        } else {
            $('#hsslEnrl_schoolNameVal').addClass('warning');
        }

        if (!city) {
            $('#hsslEnrl_cityNameVal').text("Please enter city.");
            $('#hsslEnrl_cityNameVal').removeClass('warning');
            return false; 
        } else {
            $('#hsslEnrl_cityNameVal').addClass('warning');
        }

        if (!teacherName) {
            $('#hsslEnrl_teacherNameVal').text("Please enter Principal/Teacher's name");
            $('#hsslEnrl_teacherNameVal').removeClass('warning');
            return false; 
        } else {
            $('#hsslEnrl_teacherNameVal').addClass('warning');
        }

        if (!validateEmail(schoolEmail)) {
            $('#hsslEnrl_schoolEmailVal').text("Please enter a valid email address.");
            $('#hsslEnrl_schoolEmailVal').removeClass('warning');
            return false; 
        } else {
            $('#hsslEnrl_schoolEmailVal').addClass('warning');
        }

        if (!schoolNumber) {
            $('#hsslEnrl_schoolNumberVal').text("Please enter valid 10 digits phone number.");
            $('#hsslEnrl_schoolNumberVal').removeClass('warning');
            return false; 
        } else {
            $('#hsslEnrl_schoolNumberVal').addClass('warning');
        }


        const urlSearchParams = new URLSearchParams(window.location.search);
        const params = Object.fromEntries(urlSearchParams.entries());
        const utmSource = params.utm_source || 'Website';
        const utmMedium = params.utm_medium;
        const utmCampaign = params.utm_campaign;
        let url = window.location.pathname.substring(1);
        let formname = "Enroll Your School";
        let medium = `UG High School Startup - ${formname} Popup`;
        //let course = 'UG High School Startup';
        let course = 'UG Programme in TBM or PSM';
   

        let device = 'PC';
        if (window.matchMedia("(max-width: 768px)").matches) {
            device = "Mobile";
        } else {
            device = "Desktop";
        }


        $.ajax({
            url: "{{apiBaseURL}}/api/registerForEvent",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                event_Id:"67a9b3c2b824a6c33081eb97", // old hssl id replaced "668cbe6361bf2340668d4207",
                eventName: "High School Startup League",
                field_device_type: device,
                linkedinProfile: "",
                medium: utmMedium || medium,
                campaign: utmCampaign || null,
