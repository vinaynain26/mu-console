<script>
    // Validation functions


// Main validation function
function validateForm() {
    let isValid = true;

    // Validate main fields
    if (!validateNameInput('nameUser', 'nameError')) isValid = false;
    if (!validateEmailInput('emailUser', 'emailError')) isValid = false;
    if (!validateMobileInput('phoneUser', 'phoneError')) isValid = false;
    if (!validateSelectInput('gradeUser', 'gradeError')) isValid = false;
    if (!validateTextInput('schoolUser12', 'schoolError12')) isValid = false;
    if (!validateTextInput('cityUser', 'cityError')) isValid = false;
    if (!validateSelectInput('participants', 'participantsError')) isValid = false;

    // Validate additional participants if any
    const totalMembers = parseInt(document.getElementById('participants').value || "1");
    for (let i = 2; i <= totalMembers; i++) {
        const nameField = `participantName${i}`;
        const emailField = `participantEmail${i}`;
        
        if (!validateTextInput(nameField, `${nameField}Error`)) isValid = false;
        if (!validateEmailInput(emailField, `${emailField}Error`)) isValid = false;
        if (!validateMobileInput(phoneField, `${phoneField}Error`)) isValid = false;
        if (!validateSelectInput(gradeField, `${gradeField}Error`)) isValid = false;

    }

    return isValid;
}

// Submit function with validation
function submitRegisterationForm() {
    let isValid = validateForm();
    if (!document.getElementById('consentCheckHes')?.checked) { document.getElementById('consentCheckErrorHes').classList.remove('warning'); isValid = false; } else { document.getElementById('consentCheckErrorHes').classList.add('warning'); }
    if (!isValid) {
        return;
    }

    const urlSearchParams = new URLSearchParams(window.location.search);
    const params = Object.fromEntries(urlSearchParams.entries());
    const utmSource = params.source || '';
    const utmMedium = params.medium || '';
    const utmCampaign = params.campaign || '';
    const deviceType = window.innerWidth < 767 ? 'mobile' : 'desktop';

    const name = $('#nameUser').val().trim();
    const email = $('#emailUser').val().trim();
    const phone = $('#phoneUser').val().trim();
    const grade = $('#gradeUser').val().trim();
    const school = $('#schoolUser12').val().trim();
    const city = $('#cityUser').val().trim();
    const selectedParticipant = $('#participants').val();

    const teamMembers = [];
    const totalMembers = parseInt(selectedParticipant);

    for (let i = 1; i <= totalMembers; i++) {
        const memberName = i === 1 ? name : $(`#participantName${i}`).val().trim();
        const memberEmail = i === 1 ? email : $(`#participantEmail${i}`).val().trim();
        teamMembers.push({ name: memberName, email: memberEmail });
    }

    const FormData = {
        email,
        name,
        mobile: phone,
        yourGrade: grade,
        school,
        city,
        selectedParticipant,
        medium: utmMedium||"High School Startup League - Register For Event Form Popup",
        source: utmSource || "website",
        campaign: utmCampaign,
        device: deviceType,
        event_Id: "67a9b3c2b824a6c33081eb97",
        eventName: "High School Startup League",
        leadSource: "High School Startup League - Register For Event Form Popup",
        Specialization: "UG Programme in Data Science & AI",
        course: "Course",
        form_steps_email: "1",
        teamMembers,
        consentCheck: document.getElementById('consentCheckHes')?.checked || false
    };

    const post_url = `{{apiBaseURL}}/api/updateDataOfRegisteredEventUserData`;

    $.ajax({
        url: post_url,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(FormData),
        success: function(res) {
            $('#hssl_enroll_leadformContainer').hide();
            $('#hssl_enroll_SuccessMessage').removeClass('hide');
        },
        error: function(err) {
            console.error("There was an error submitting the form. Please try again.");
            console.error(err);
        }
    });
}

// Handle additional participants
function handleMultiParticipants() {
    const selectedParticipantsCount = parseInt($('#participants').val().trim());
    const teamDetails = $("#multiParticipantsBind");
    teamDetails.empty();

    const primaryName = $('#nameUser').val().trim();
    const primaryEmail = $('#emailUser').val().trim();
    const primaryPhone = $('#phoneUser').val().trim();
    const primaryGrade = $('#gradeUser').val().trim();

    for (let i = 1; i <= selectedParticipantsCount; i++) {
        const isPrimary = i === 1;
        const nameValue = isPrimary ? primaryName : '';
        const emailValue = isPrimary ? primaryEmail : '';
        const phoneValue = isPrimary ? primaryPhone : '';
        const gradeValue = isPrimary ? primaryGrade : '';
        const nameAttr = `participantName${i}`;
        const emailAttr = `participantEmail${i}`;
        const phoneAttr = `participantPhone${i}`;
        const gradeAttr = `participantGrade${i}`;
        
        const nameReadonly = isPrimary ? 'readonly' : '';
        const emailReadonly = isPrimary ? 'readonly' : '';
        const phoneReadonly = isPrimary ? 'readonly' : '';
        const gradeReadonly = isPrimary ? 'readonly' : '';
        const labelText = isPrimary ? `Participant ${i} (Primary Member)` : `Participant ${i}`;

        const participantBlock = `
            <p class="participantLabel">${labelText}</p>
            <div class="PopupformWrapper">
                    <div class="InputGroup">
                        <label class="font-14 font-medium">Name<span class="font-red">*</span></label>
                        <input type="text" id="${nameAttr}" name="${nameAttr}" placeholder="Enter the name"
                            value="${nameValue}" ${nameReadonly}
                            class="inputBox input font-16 font-black1 font-medium"
                            onblur="validateTextInput('${nameAttr}', '${nameAttr}Error')"
                            required>
                        <p id="${nameAttr}Error" class="font-12 font-red font-regular"></p>
                    </div>

                    <div class="InputGroup">
                        <label class="font-14 font-medium">Email<span class="font-red">*</span></label>
                        <input type="email" id="${emailAttr}" name="${emailAttr}" placeholder="Enter the email"
                            value="${emailValue}" ${emailReadonly}
                            class="inputBox input font-16 font-black1 font-medium"
                            onblur="validateEmailInput('${emailAttr}', '${emailAttr}Error')"
                            required>
                        <p id="${emailAttr}Error" class="font-12 font-red font-regular"></p>
                    </div>
                    <div class="InputGroup">
                        <label class="font-14 font-medium">Contact<span class="font-red">*</span></label>
                        <input type="email" id="${phoneAttr}" name="${phoneAttr}" placeholder="Enter the mobile"
                            value="${phoneValue}" ${phoneReadonly}
                            class="inputBox input font-16 font-black1 font-medium"
                            onblur="validateEmailInput('${phoneAttr}', '${phoneAttr}Error')"
                            required>
                        <p id="${phoneAttr}Error" class="font-12 font-red font-regular"></p>
                    </div>

                    <div class="InputGroup">
                        <label for="${gradeAttr}" class="font-14 font-medium">
                            Grade<span class="font-red">*</span>
                            </label>
                        <select 
                             id="${gradeAttr}" 
                             name="${gradeAttr}" 
                             class="inputBox selectInput" 
                             onblur="validateSelectInput('${gradeAttr}', '${gradeAttr}Error')" 
                             ${gradeReadonly}>
        
                            <option value="" disabled selected>Select your Grade</option>
                            <option value="9" ${gradeValue === '9' ? 'selected' : ''}>9</option>
                            <option value="10" ${gradeValue === '10' ? 'selected' : ''}>10</option>
                            <option value="11" ${gradeValue === '11' ? 'selected' : ''}>11</option>
                            <option value="12" ${gradeValue === '12' ? 'selected' : ''}>12</option>
                            <option value="Others" ${gradeValue === 'Others' ? 'selected' : ''}>Others (1–8)</option>
                            <option value="College" ${gradeValue === 'College' ? 'selected' : ''}>College</option>
    </select>
    <p id="${gradeAttr}Error" class="font-12 font-red font-regular"></p>
</div>

            </div>
        `;

        teamDetails.append(participantBlock);
    }
}



</script>