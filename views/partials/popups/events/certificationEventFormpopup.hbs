        $('#nameReportLeader').val("");
        $('#emailReportLeader').val("");
        $('#numberReportLeader').val("");
        $('#consentCheckCef').prop('checked', false);
        $('#consentCheckErrorCef').addClass('warning');
    }


    function openLeadGenForm(formTitle, destination) {
        const form = document.getElementById("leaderform");
        // const h2 = document.querySelector("#form_heading");

        form.classList.add("active");
        h2.textContent = formTitle || h2.textContent;
        form.setAttribute("data-destination", destination);
        form.setAttribute("data-title", h2.textContent);

        // Reset form
