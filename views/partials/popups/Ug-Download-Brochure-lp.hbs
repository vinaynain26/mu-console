    function hideApplyNowPopUpMainUG() {
        let applyNowPopUp = document.getElementById("UgdownloadBrochure");
        if (applyNowPopUp) {
            applyNowPopUp.classList.remove("active")
        }

        // Re-enable scrolling when popup is closed
        document.body.style.overflow = 'auto';
      
        $('#nameReport').val("");
        $('#emailReport').val("");
        $('#numberReport').val("");
        $('#qualificationReport').val("").trigger("change");
        $('#schoolNameReport').val("");
    
        const nameReportVal = document.querySelector("#nameReportVal");
        const emailReportVal = document.querySelector("#emailReportVal");
        const numberReportVal = document.querySelector("#numberReportVal");
        const qualificationReportVal = document.querySelector("#qualificationReportVal");
        const schoolNameReportVal = document.querySelector("#schoolNameReportVal");
        
        if (nameReportVal) nameReportVal.classList.add("warning");
        if (emailReportVal) emailReportVal.classList.add("warning");
        if (numberReportVal) numberReportVal.classList.add("warning");
        if (qualificationReportVal) qualificationReportVal.classList.add("warning");
        if (schoolNameReportVal) schoolNameReportVal.classList.add("warning");

        const consentCheckUgLP = document.getElementById("consentCheckUgLP");
        if (consentCheckUgLP) consentCheckUgLP.checked = false;
        const consentCheckErrorUgLP = document.getElementById("consentCheckErrorUgLP");
        if (consentCheckErrorUgLP) consentCheckErrorUgLP.classList.add("warning");
