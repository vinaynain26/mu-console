<script type="text/javascript">
/*
 * LinkedIn Insight Tag — GDPR consent-gated.
 * Loads (and sets bcookie / lidc / UserMatchHistory) ONLY after the visitor accepts cookies
 * via the banner. See window.MUConsent in components/cokkie.hbs. If the user rejects or has
 * not chosen yet, nothing here runs and no LinkedIn cookies are set.
 * The <noscript> tracking pixel was removed because a no-JS fallback cannot honour consent.
 */
(function () {
    function loadLinkedInInsight() {
        window._linkedin_partner_id = "3683610";
        window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
        window._linkedin_data_partner_ids.push(window._linkedin_partner_id);

        (function (l) {
            if (!l) {
                window.lintrk = function (a, b) { window.lintrk.q.push([a, b]) };
                window.lintrk.q = [];
            }
            var s = document.getElementsByTagName("script")[0];
            var b = document.createElement("script");
            b.type = "text/javascript"; b.async = true;
            b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
            s.parentNode.insertBefore(b, s);
        })(window.lintrk);
    }

    if (window.MUConsent && typeof window.MUConsent.whenGranted === 'function') {
        window.MUConsent.whenGranted(loadLinkedInInsight);
    } else {
        try {
            if (localStorage.getItem('mu_cookie_consent') === 'accepted') loadLinkedInInsight();
        } catch (e) { /* no-op */ }
    }
})();
</script>
