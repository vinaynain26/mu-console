<script>
    (function () {
        const hamburger = document.getElementById("mobileHamburgerBtn");
        const mobileMenu = document.getElementById("mobileHeaderContent");
        const closeBtn = document.getElementById("mobileMenuCloseBtn");

        function openMobileMenu() {
            if (mobileMenu) {
                mobileMenu.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }
        function closeMobileMenu() {
            if (mobileMenu) {
                mobileMenu.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        if (hamburger) {
            hamburger.addEventListener("click", openMobileMenu);
            hamburger.addEventListener("keydown", function (e) {
                if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " "))
                    openMobileMenu();
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", closeMobileMenu);
            closeBtn.addEventListener("keydown", function (e) {
                if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " "))
                    closeMobileMenu();
            });
        }

        document.addEventListener("mousedown", function (e) {
            const target = e.target;
            if (
                mobileMenu &&
                mobileMenu.classList.contains("active") &&
                !mobileMenu.contains(target instanceof Node ? target : null) &&
                !(hamburger && hamburger.contains(target instanceof Node ? target : null))
            ) {
                closeMobileMenu();
            }
        });

        document.addEventListener("keydown", function (e) {
            if (
                e instanceof KeyboardEvent &&
                e.key === "Escape" &&
                mobileMenu &&
                mobileMenu.classList.contains("active")
            ) {
                closeMobileMenu();
            }
        });

        function closeAllMobMenuItems(except = null) {
            const allItems = document.querySelectorAll(".mobMenuItem");
            allItems.forEach((item) => {
                if (!(item instanceof HTMLElement)) return;
                const body = item.querySelector(".mobMenuItemBody");
                const header = item.querySelector(".mobMenuItemHeader");

                if (item !== except) {
                    if (body && body instanceof HTMLElement) {
                        body.style.overflow = "hidden";
                        body.style.transition =
                            "max-height 0.45s cubic-bezier(0.4,0,0.2,1)";

                        if (!body.classList.contains("open")) {
                            body.style.setProperty("max-height", "0px", "important");
                            body.classList.remove("open");
                        } else {
                            body.style.maxHeight = body.scrollHeight + "px";
                            void body.offsetHeight;
                            body.style.setProperty("max-height", "0px", "important");

                            const removeOpen = function () {
                                body.classList.remove("open");
                                body.removeEventListener("transitionend", removeOpen);
                            };
                            body.addEventListener("transitionend", removeOpen);
                        }
                    }
                    if (header && header instanceof HTMLElement) {
                        header.classList.remove("active");
                    }
                    item.classList.remove("active");
                }
            });
        }

        function activateMobMenuItemSmoothly(item) {
            const body = item.querySelector(".mobMenuItemBody");
            const header = item.querySelector(".mobMenuItemHeader");
            if (!body || !header) return;

            closeAllMobMenuItems(item);

            if (body instanceof HTMLElement) {
                body.style.overflow = "hidden";
                body.style.transition =
                    "max-height 0.45s cubic-bezier(0.4,0,0.2,1)";
                if (body.classList.contains("open")) return;

                body.style.setProperty("max-height", "0px", "important");
                void body.offsetHeight;

                body.classList.add("open");
                body.style.maxHeight = body.scrollHeight + "px";
            }

            header.classList.add("active");
            item.classList.add("active");
        }

        function deactivateMobMenuItemSmoothly(item) {
            const body = item.querySelector(".mobMenuItemBody");
            const header = item.querySelector(".mobMenuItemHeader");
            if (!body || !header) return;

            if (body instanceof HTMLElement) {
                body.style.overflow = "hidden";
                body.style.transition =
                    "max-height 0.45s cubic-bezier(0.4,0,0.2,1)";
                body.style.maxHeight = body.scrollHeight + "px";
                void body.offsetHeight;
                body.style.setProperty("max-height", "0px", "important");

                const removeOpen = function () {
                    body.classList.remove("open");
                    body.removeEventListener("transitionend", removeOpen);
                };
                body.addEventListener("transitionend", removeOpen);
            }

            header.classList.remove("active");
            item.classList.remove("active");
        }

        function toggleMobMenuItem(item) {
            const body = item.querySelector(".mobMenuItemBody");
            if (!body) return;

            if (body.classList.contains("open")) {
                deactivateMobMenuItemSmoothly(item);
            } else {
                activateMobMenuItemSmoothly(item);
            }
        }

        document.querySelectorAll(".mobMenuItem").forEach((item) => {
            if (!(item instanceof HTMLElement)) return;
            const header = item.querySelector(".mobMenuItemHeader");
            const body = item.querySelector(".mobMenuItemBody");

            if (header && body) {
                body.style.overflow = "hidden";
                body.style.transition =
                    "max-height 0.45s cubic-bezier(0.4,0,0.2,1)";
                body.style.setProperty("max-height", "0px", "important");
                body.classList.remove("open");

                const toggler = header.querySelector(".togglerDown");
                if (toggler) {
                    toggler.style.cursor = "pointer";
                    toggler.addEventListener("click", function (e) {
                        e.stopPropagation();
                        toggleMobMenuItem(item);
                    });
                }

                header.addEventListener("click", function (e) {
                    e.stopPropagation();
                    toggleMobMenuItem(item);
                });
            }
        });

        if (closeBtn) {
            closeBtn.addEventListener("click", function () {
                closeAllMobMenuItems();
            });
        }
    })();
</script>


<script>
    // Mobile-only subParent dropdown toggle functionality
    (function () {
        // Check if mobile (typically 768px or below)
        function isMobile() {
            return window.innerWidth <= 768;
        }

        // Toggle subDropContent visibility
        function toggleSubDropContent(subParent) {
            const subDropContent = subParent.querySelector(".subDropContent");
            if (!subDropContent) return;

            const isVisible = subDropContent.style.display === "block";
            subDropContent.style.display = isVisible ? "none" : "block";

            // Optional: toggle active class on subDropdown for styling
            const subDropdown = subParent.querySelector(".subDropdown");
            if (subDropdown) {
                subDropdown.classList.toggle("active", !isVisible);
            }
        }

        // Initialize event listeners for all subParent elements
        function initSubParentDropdowns() {
            if (!isMobile()) return;

            document.querySelectorAll(".subParent").forEach((subParent) => {
                const subDropdown = subParent.querySelector(".subDropdown");
                const subDropContent = subParent.querySelector(".subDropContent");

                if (!subDropdown || !subDropContent) return;

                // Ensure subDropContent is hidden initially
                subDropContent.style.display = "none";

                // Add click event to subDropdown
                subDropdown.addEventListener("click", function (e) {
                    e.stopPropagation();
                    toggleSubDropContent(subParent);
                });

                // Make subDropdown keyboard accessible
                subDropdown.setAttribute("tabindex", "0");
                subDropdown.style.cursor = "pointer";
                subDropdown.addEventListener("keydown", function (e) {
                    if (
                        e instanceof KeyboardEvent &&
                        (e.key === "Enter" || e.key === " ")
                    ) {
                        e.preventDefault();
                        toggleSubDropContent(subParent);
                    }
                });
            });
        }

        // Initialize on page load
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initSubParentDropdowns);
        } else {
            initSubParentDropdowns();
        }

        // Re-initialize on window resize (in case user switches between mobile/desktop)
        let resizeTimer;
        window.addEventListener("resize", function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                // Re-initialize to handle mobile/desktop switch
                if (isMobile()) {
                    initSubParentDropdowns();
                } else {
                    // Reset on desktop - remove event listeners and show content
                    document.querySelectorAll(".subParent").forEach((subParent) => {
                        const subDropContent = subParent.querySelector(".subDropContent");
                        if (subDropContent) {
                            subDropContent.style.display = "";
                        }
                        const subDropdown = subParent.querySelector(".subDropdown");
                        if (subDropdown) {
                            subDropdown.classList.remove("active");
                        }
                    });
                }
            }, 250);
        });
    })();
</script>

<script>
    // Show/hide dropdowns on click for top nav only
    function showMenu(id) {
        $(".menuDown").removeClass("active");
        if (id) {
            $("#" + id).addClass("active");
            $("header").addClass("menuActive");
            $(".blurScreen").addClass("active");
            $("body").css("overflow", "hidden");
        }
    }
    function hideMenu() {
        $(".menuDown").removeClass("active");
        $("header").removeClass("menuActive");
        $(".blurScreen").removeClass("active");
        $("body").css("overflow", "auto");
    }

    const ENTERPRISE_ACTIVE_MENU_KEY = "enterpriseActiveMenuSlug";
    const MEGA_MENU_OPEN_CLASS = "menu-open";
    const PAGE_ACTIVE_CLASS = "page-active";
    const NON_PERSISTENT_MENU_SLUGS = new Set(["industries", "organizations"]);
    const $topMenuItems = $(".navMenu > .navList");
    const $topMenuLinks = $topMenuItems.find("> .dropdownItems");

    function isPersistableMenuSlug(slug) {
        return !!slug && !NON_PERSISTENT_MENU_SLUGS.has(slug);
    }

    function setTopMenuActive(slug) {
        $topMenuItems.removeClass(`active ${PAGE_ACTIVE_CLASS}`);
        $topMenuLinks.removeClass(`active ${PAGE_ACTIVE_CLASS}`);
        if (!isPersistableMenuSlug(slug)) return;
        const $activeLink = $topMenuLinks.filter(`[data-menu-slug="${slug}"]`).first();
        $activeLink.addClass(`active ${PAGE_ACTIVE_CLASS}`);
        $activeLink.closest(".navList").addClass(`active ${PAGE_ACTIVE_CLASS}`);
    }

    function normalizePath(pathname) {
        const normalizedPath = (pathname || "/").toLowerCase().replace(/\/+$/, "");
        return normalizedPath || "/";
    }

    function getSlugFromPath(pathname) {
        const path = normalizePath(pathname);

        if (path === "/" || path === "https://ventures.mastersunion.org/") return "home";
        if (path === "https://ventures.mastersunion.org/") return "courses";


        return "";
    }

    function persistMenuSlug(slug) {
        if (!isPersistableMenuSlug(slug)) return;
        try {
            localStorage.setItem(ENTERPRISE_ACTIVE_MENU_KEY, slug);
        } catch (e) {
            // Ignore storage failures in private mode or restricted environments.
        }
    }

    function getInitialMenuSlug() {
        const slugFromPath = getSlugFromPath(window.location.pathname);
        if (slugFromPath) return slugFromPath;

        try {
            const storedSlug = localStorage.getItem(ENTERPRISE_ACTIVE_MENU_KEY) || "";
            return isPersistableMenuSlug(storedSlug) ? storedSlug : "";
        } catch (e) {
            return "";
        }
    }

    function restorePersistentMenuActiveState() {
        setTopMenuActive(getInitialMenuSlug());
    }

    function activateEnterpriseSubtab(tabId) {
        if (!tabId) return;
        const $enterpriseMenu = $("#enterprise");
        const $secondaryTab = $enterpriseMenu.find(".tabSecondary").first();
        if (!$secondaryTab.length) return;

        $secondaryTab.find(".aboutTabs .aboutItems").removeClass("active");
        $secondaryTab.find(`.aboutTabs .aboutItems[data-rel="${tabId}"]`).first().addClass("active");
        $secondaryTab.find(".sub-academic-content").removeClass("active");
        $secondaryTab.find("#" + tabId).addClass("active");
    }

    restorePersistentMenuActiveState();

    // Remove hover events for top nav
    $(".megaLink").off("mouseenter mouseleave");

    $(".navMenu > .navList:not(.megaLink) .dropdownItems")
        .off("click")
        .on("click", function () {
            const slug = $(this).attr("data-menu-slug");
            persistMenuSlug(slug);
            hideMenu();
            $(".megaLink").removeClass(MEGA_MENU_OPEN_CLASS);
            $("body").addClass("enterprise-nav-loading");
        });

    // Top nav: open/close menu on click only
    $(".megaLink").off("click");
    $(".megaLink").on("click", function (e) {
        e.preventDefault();
        const $menuLink = $(this).find(".dropdownItems").first();
        const slug = $menuLink.attr("data-menu-slug");
        const id = $(this).attr("data-rel");
        const submenuTarget = $(this).attr("data-submenu-target");
        if (!id) return;
        if ($(this).hasClass(MEGA_MENU_OPEN_CLASS)) {
            hideMenu();
            $(".megaLink").removeClass(MEGA_MENU_OPEN_CLASS);
            restorePersistentMenuActiveState();
        } else {
            $(".megaLink").removeClass(MEGA_MENU_OPEN_CLASS);
            // Hide persistent page highlight while dropdown menu is open.
            setTopMenuActive("");
            $(this).addClass(MEGA_MENU_OPEN_CLASS);
            showMenu(id);
            activateEnterpriseSubtab(submenuTarget);
        }
    });

    // Academic tab switching: hover only (no click)
    $(".academicTabs .aboutItems")
        .off("mouseenter click")
        .on("mouseenter", function (e) {
            // Only switch tab on hover, not on click
            const id = $(this).attr("data-rel");
            if (!id) return;
            $(this).addClass("active").siblings().removeClass("active");
            const $tabAcademic = $(this).closest(".tabAcademic");
            $tabAcademic.find(".academic-content").removeClass("active");
            $tabAcademic.find("#" + id).addClass("active");
        });

    // Sub-tabs inside academic tab: hover only (no click)
    $(".tabSecondary .aboutTabs .aboutItems")
        .off("mouseenter click")
        .on("mouseenter", function (e) {
            // Only switch sub-tab on hover, not on click
            const id = $(this).attr("data-rel");
            if (!id) return;
            $(this).addClass("active").siblings().removeClass("active");
            const $tabSecondary = $(this).closest(".tabSecondary");
            $tabSecondary.find(".sub-academic-content").removeClass("active");
            $tabSecondary.find("#" + id).addClass("active");
        });

    // Ensure program links inside academic tab redirect on click
    // Remove e.preventDefault() from program links
    // This is handled by not binding click events to .tabSecondary .aboutTabs .aboutItems > a

    // Clicking blurScreen closes menu
    function closeMenu() {
        hideMenu();
        $(".megaLink").removeClass(MEGA_MENU_OPEN_CLASS);
        restorePersistentMenuActiveState();
    }

    // Clicking on menuDown closes menu
    $(".menuDown")
        .off("click")
        .on("click", function (e) {
            // Only close if user clicks directly on menuDown, not on its children
            if (e.target === this) {
                closeMenu();
            }
        });

    // Prevent menuDown from closing when interacting inside
    $(".menuDown")
        .off("mousedown")
        .on("mousedown", function (e) {
            e.stopPropagation();
        });

    // Prevent menuDown from closing on mouseleave
    $(".menuDown").off("mouseleave");

    // Clicking anywhere outside menuDown or nav closes menu
    $(document).on("mousedown", function (e) {
        if (
            !$(e.target).closest(".menuDown").length &&
            !$(e.target).closest(".megaLink").length &&
            !$(e.target).closest(".navMenu").length &&
            $(".menuDown.active").length
        ) {
            closeMenu();
        }
    });

    // Keep top nav active state in sync with current URL on page load.
    function setActiveClassHeader() {
        const slugFromPath = getSlugFromPath(window.location.pathname);
        if (slugFromPath) {
            setTopMenuActive(slugFromPath);
            persistMenuSlug(slugFromPath);
            return;
        }

        const persistedSlug = getInitialMenuSlug();
        if (persistedSlug) {
            setTopMenuActive(persistedSlug);
            return;
        }

        const currentPath = normalizePath(window.location.pathname).split("/")[1];
        const legacyElem = document.querySelector(`#nav__${currentPath}`);
        if (legacyElem) {
            legacyElem.classList.add("active");
            const parentLi = legacyElem.closest(".navList");
            if (parentLi) {
                parentLi.classList.add("active");
            }
        }
    }

    document.addEventListener("DOMContentLoaded", setActiveClassHeader);

    function prefetchEnterpriseTopNavLinks() {
        const prefetchedHrefSet = new Set();
        $(".navMenu > .navList:not(.megaLink) .dropdownItems").each(function () {
            const href = $(this).attr("href");
            if (!href || href === "#" || prefetchedHrefSet.has(href)) return;

            prefetchedHrefSet.add(href);
            const prefetchLink = document.createElement("link");
            prefetchLink.rel = "prefetch";
            prefetchLink.href = href;
            prefetchLink.as = "document";
            document.head.appendChild(prefetchLink);
        });
    }

    if ("requestIdleCallback" in window) {
        requestIdleCallback(prefetchEnterpriseTopNavLinks);
    } else {
        setTimeout(prefetchEnterpriseTopNavLinks, 400);
    }

    // Header shrink on scroll logic with smooth transition
    (function () {
        const $menu = $("header.topHeader");
        let lastScrollTop = 0;
        const menuHeight = safeNumber($menu.outerHeight());
        const windowHeight = safeNumber($(window).height());

        function getBannerOffset() {
            // If you have a banner above header, return its height, else 0
            const $banner = $(".bannerTop");
            const bannerHeight = $banner.length ? safeNumber($banner.outerHeight()) : 0;

            // Also account for hero banner if visible
            const $heroBanner = $("#heroBanner");
            const heroBannerHeight = ($heroBanner.length && $heroBanner.hasClass("active"))
                ? safeNumber($heroBanner.outerHeight())
                : 0;

            return bannerHeight + heroBannerHeight;
        }

        $(window).on("scroll", function () {
            const stRaw = $(this).scrollTop();
            const st = safeNumber(stRaw);
            const bannerOffset = getBannerOffset();
            const currentOffset = Math.max(0, bannerOffset - st);

            // Remove shrikIt if we reach top 80px or less
            if (st <= 80) {
                $menu.css("top", currentOffset + "px");
                $menu.removeClass("shrikIt");
                // Remove custom -2.25rem top if present
                if ($menu.css("top") === "-2.25rem") {
                    $menu.css("top", currentOffset + "px");
                }
                lastScrollTop = st;
                return;
            }

            const $highlight = $(".highlightsec");
            const highlightHeight = $highlight.length
                ? safeNumber($highlight.height())
                : 0;

            if ($highlight.length > 0) {
                if (st < highlightHeight) {
                    if (st > lastScrollTop) {
                        // Scrolling down
                        if (
                            st > menuHeight &&
                            st + windowHeight < safeNumber($(document).height())
                        ) {
                            $menu.css("top", "-2.25rem");
                            $menu.addClass("shrikIt");
                        }
                    } else {
                        // Scrolling up
                        // Only unshrink if at the top 80px
                        if (st <= 80) {
                            $menu.css("top", currentOffset + "px");
                            $menu.removeClass("shrikIt");
                        }
                        // Otherwise, keep it shrunk
                    }
                    lastScrollTop = st;
                }
            } else {
                if (st > lastScrollTop) {
                    // Scrolling down
                    if (
                        st > menuHeight &&
                        st + windowHeight < safeNumber($(document).height())
                    ) {
                        $menu.css("top", "-2.25rem");
                        $menu.addClass("shrikIt");
                    }
                } else {
                    // Scrolling up
                    // Only unshrink if at the top 80px
                    if (st <= 80) {
                        $menu.css("top", currentOffset + "px");
                        $menu.removeClass("shrikIt");
                    }
                    // Otherwise, keep it shrunk
                }
                lastScrollTop = st;
            }
        });
    })();

    // Note: For PGP Rise extended nav, ensure data-rel and menuDown id match exactly in HTML.
</script>


<script>
    // menu scroller

    $(document).ready(function () {
        const currentPath = window.location.pathname;
        const deviceWidth = window.innerWidth;
        // Disable scroll-based shrikIt movement on mobile, but keep banner offset sync
        if (deviceWidth <= 767) {
            $("header").css({ "position": "fixed", "width": "100%", "z-index": "9999" });
            $("#ugBanner").css({ "top": "0", "position": "fixed", "width": "100%", "z-index": "1001" });

            function updateMobileHeaderTop() {
                var st = $(window).scrollTop() || 0;
                var offset = 0;
                const heroBanner = document.getElementById('heroBanner');
                if (heroBanner && heroBanner.classList.contains('active')) {
                    offset += heroBanner.offsetHeight;
                }

                var currentOffset = Math.max(0, offset - st);
                $("header").css("top", currentOffset + "px");

                const mobileHeaderContent = document.getElementById("mobileHeaderContent");
                if (mobileHeaderContent) {
                    mobileHeaderContent.style.top = currentOffset + "px";
                }
            }

            $(window).scroll(function () {
                updateMobileHeaderTop();
            });
            updateMobileHeaderTop();

            return;
        }
        if (deviceWidth >= 768 && deviceWidth <= 822) return;

        var lastScrollTop = 0;
        var $menu = $("header");
        var menuHeight = $menu.height() - 60;
        var windowHeight = $(window).height();
        var sectionHeight = $(".highlightsec").height();
        var documentHeight = $(document).scrollTop();

        // Function to get banner offset
        function getBannerOffset() {
            let offset = 0;

            // Account for ugBanner if visible
            const banner = document.getElementById('ugBanner');
            if (banner && banner.classList.contains('ug-banner--visible')) {
                const rect = banner.getBoundingClientRect();
                offset += rect.height;
            }

            // Also account for hero banner if visible
            const heroBanner = document.getElementById('heroBanner');
            if (heroBanner && heroBanner.classList.contains('active')) {
                offset += heroBanner.offsetHeight;
            }

            return offset;
        }

        $(window).scroll(function () {
            var st = $(this).scrollTop();
            var bannerOffset = getBannerOffset();
            var currentOffset = Math.max(0, bannerOffset - st);

            // Remove shrikIt if we reach top 80px or less
            if (st <= 80) {
                $menu.css("top", currentOffset + "px");
                $menu.removeClass("shrikIt");
                lastScrollTop = st;
                return;
            }

            if ($(".highlightsec").length > 0) {
                if (st < $(".highlightsec").height()) {
                    if (st > lastScrollTop) {
                        // Scrolling down
                        if (st > menuHeight && st + windowHeight < $(document).height()) {
                            $menu.css("top", -menuHeight + "px");
                            $menu.addClass("shrikIt");
                        }
                    } else {
                        // Scrolling up
                        // Only unshrink if at the top 80px
                        if (st <= 80) {
                            $menu.css("top", currentOffset + "px");
                            $menu.removeClass("shrikIt");
                        }
                        // Otherwise, keep it shrunk
                    }
                    lastScrollTop = st;
                }
            } else {
                if (st > lastScrollTop) {
                    // Scrolling down
                    if (st > menuHeight && st + windowHeight < $(document).height()) {
                        $menu.css("top", -menuHeight + "px");
                        $menu.addClass("shrikIt");
                    }
                } else {
                    // Scrolling up
                    // Only unshrink if at the top 80px
                    if (st <= 80) {
                        $menu.css("top", currentOffset + "px");
                        $menu.removeClass("shrikIt");
                    }
                    // Otherwise, keep it shrunk
                }
                lastScrollTop = st;
            }
        });

        if (documentHeight > sectionHeight) {
            $menu.css("top", -menuHeight + "px");
            $menu.addClass("darkHeader");
        } else {
            // Set initial position based on banner visibility (includes hero banner)
            var bannerOffset = getBannerOffset();
            if (bannerOffset > 0) {
                $menu.css("top", bannerOffset + "px");
            }
        }
    });
</script>

