<script>
    // Show hero banner only on homepage
    (function () {
        const heroBanner = document.getElementById('heroBanner');
        if (!heroBanner) return;

        function checkAndShowBanner() {
            const currentPath = window.location.pathname;
            // Show only on homepage "/"
            if (currentPath === '/' || currentPath === '') {
                heroBanner.classList.add('active');

                // Trigger scroll event to recalculate header position
                // This ensures the existing scroll logic accounts for the banner
                setTimeout(function () {
                    $(window).trigger('scroll');
                }, 100);
            } else {
                heroBanner.classList.remove('active');

                // Trigger scroll event to recalculate header position
                setTimeout(function () {
                    $(window).trigger('scroll');
                }, 100);
            }
        }

        // Check on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', checkAndShowBanner);
        } else {
            checkAndShowBanner();
        }

        // Check on navigation (for SPA-like behavior if applicable)
        window.addEventListener('popstate', checkAndShowBanner);

        // Also check when location changes (for frameworks that use pushState)
        let lastPath = window.location.pathname;
        setInterval(function () {
            if (window.location.pathname !== lastPath) {
                lastPath = window.location.pathname;
                checkAndShowBanner();
            }
        }, 100);
    })();
</script>