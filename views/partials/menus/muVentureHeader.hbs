<style>
    .enterList {
        padding: 10px 8px;
        display: flex;
        align-items: center;
        width: 100%;
        justify-content: space-between;
        border-bottom: 1px solid var(--grey17);
        cursor: pointer;
    }

    .dropdownItems {
        justify-content: center;
    }

    .dropdownItems.droEvent::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 2px;
        background: var(--grey3) !important;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.35s ease;

    }

    .shapeText {
        font-size: 14px;
        line-height: 120%;
        font-family: var(--go-regular);
        color: var(--grey4);

    }

    .enterDrop {
        padding: 16px 8px;
        background: var(--black);
        border-radius: 12px;
        width: 100%;
        max-width: 202px;
        border: 1px solid var(--grey3);
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: 15px;
    }

    .menuDown::after {
        background: unset;
    }

    .menuDown {
        background: unset;
    }

    .enterDrop {
        position: absolute;
        right: 23%;
    }

    .enterDrop2 {
        position: absolute;
        right: 15%;
    }

    .navList {
        width: 100%;
        max-width: 50%;
    }

    .navMenu {
        width: 100%;
        max-width: 40%;
        justify-content: space-between;

        .megaLink.active {
            .dropdownItems {
                color: var(--white);
            }

            .dropdownItems::after {
                background: var(--grey3) !important;
                transform: scaleX(1);
            }

            .dropdownItems .dropdown-icon path {
                stroke: #ffffff;
            }
        }
    }

    .mu-home-countdown {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(0, 0, 0, 0.4);
        /* very light background for white banner */
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 4px 10px;
    }

    .dropImage {
        display: none;
        transition: 0.4s ease;
    }

    .dropdownItems {
        position: relative;
        padding: 8px;
        border-bottom: 2px solid transparent;
    }

    .dropdownItems::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 2px;
        background: linear-gradient(91deg, #39B5D7 -6.14%, #F7D544 47.02%, #E38330 99.71%);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.35s ease;
    }


    .dropdownItems.active::after {
        transform: scaleX(1);
    }

    .navMenu .megaLink.menu-open>.dropdownItems.droEvent::after {
        background: var(--grey3) !important;
        transform: scaleX(1);
    }


    .topHeader.shrikIt {
        top: 0px !important;
        border-bottom: unset;
    }

    .navMenu .dropdownItems:hover {
        color: var(--white);
        font-family: "go-regular";
        font-weight: 600;

    }

    .navMenu .dropdownItems.active {
        color: var(--white);
        font-family: "go-regular";
        font-weight: 600;

        .dropImage {
            display: block;
        }
    }

    body.enterprise-nav-loading {
        cursor: progress;
    }

    body.enterprise-nav-loading .navMenu .dropdownItems {
        pointer-events: none;
    }

    .belowHeader {
        padding: 8px 0;
    }

    .mu-time-item {
        display: flex;
        align-items: baseline;
        gap: 2px;
    }

    .navMenu .dropdownItems {
        font-size: 14px;
        font-family: var(--go-regular);
        color: var(--grey4);
        text-transform: capitalize;
        transition: 0.4s ease all;
    }

    .mu-time-item span:first-child {
        font-size: 13px;
        font-weight: 700;
        font-feature-settings: "tnum";
        font-variant-numeric: tabular-nums;
        color: white;
    }

    .mu-time-lbl {
        font-size: 10px;
        font-weight: 600;
        color: var(--grey10, #666);
    }

    .mu-colon {
        font-weight: 700;
        color: var(--grey10, #666);
        position: relative;
        top: -1px;
    }

    .menuLogo {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 20px;
        max-width: fit-content;
    }

    .homeDirect {
        width: 100%;
        max-width: 20px;
    }

    .enterLinking {
        width: 100%;
        max-width: 206px;
    }

    @media (max-width: 480px) {
        .mu-home-countdown {
            padding: 3px 6px;
            gap: 4px;
        }

        .mu-time-item span:first-child {
            font-size: 11px;
        }
    }

    @media (max-width: 767px) {
        .mobileMenu .menuLogo {
            width: 100%;
            gap: 0px;
        }

        .mobileMenu .hamburgerParent {
            padding: 8px 0;
        }

        .mobileMenu .hamburgerParent {
            padding: 8px 0;
        }

        .mobileMenu .heading {
            text-transform: capitalize;
        }

        .mobileMenu .mobMenuHeader .logo {
            width: 52%;
        }


    }
</style>



