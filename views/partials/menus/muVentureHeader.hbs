<script>
    // This script enables tab switching for the "Other Tabs" section (used in Student Life, Innovation, etc.)
    // It works for any .tabMenuOther with .otherTabs > .aboutItems and .otherSecondaryContent siblings

    document.addEventListener("DOMContentLoaded", function () {
        // For each .tabMenuOther on the page (handles multiple, e.g. Student Life, Innovation, etc.)
        document.querySelectorAll(".tabMenuOther").forEach(function (tabMenu) {
            // Get all tab items and content panels within this tabMenuOther
            const tabList = tabMenu.querySelectorAll(".otherTabs .aboutItems");
            const contents = tabMenu.querySelectorAll(".otherSecondaryContent");

            // Helper: Remove all active classes and hide all contents
            function clearActive() {
                tabList.forEach(function (li) {
                    li.classList.remove("active");
                });
                contents.forEach(function (c) {
                    c.classList.remove("active");
                    // Fix: Check if c is an HTMLElement before accessing style
                    if (c instanceof HTMLElement) {
                        c.style.display = "none";
                    }
                });
            }

            // Helper: Show content for target
            function showContent(target) {
                contents.forEach(function (c) {
                    if (c.id === target) {
                        c.classList.add("active");
                        // Fix: Check if c is an HTMLElement before accessing style
                        if (c instanceof HTMLElement) {
                            c.style.display = "";
                        }
                    }
                });
            }

            // Set initial state: first tab and content active/visible
            let firstTab = tabList[0];
            if (firstTab) {
                clearActive();
                firstTab.classList.add("active");
                showContent(firstTab.getAttribute("data-target"));
            }

            tabList.forEach(function (li) {
                // Hover: switch active tab and content
                li.addEventListener("mouseenter", function () {
                    clearActive();
                    li.classList.add("active");
                    showContent(li.getAttribute("data-target"));
                });

                // Click: go to the link
                li.addEventListener("click", function (e) {
                    const link = li.querySelector("a");
                    if (link && link.href) {
                        window.location.href = link.href;
                    }
                });
            });
        });
    });
</script>


