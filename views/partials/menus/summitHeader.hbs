<script>
    document.addEventListener("DOMContentLoaded", function () {
        const navItems = Array.from(document.querySelectorAll(".forAiSummit .topNav .navItem[href^='#']"));
        if (!navItems.length) return;

        const sections = navItems
            .map(function (item) {
                const target = item.getAttribute("href");
                if (!target || target === "#") return null;
                const section = document.querySelector(target);
                if (!section) return null;
                return { item, section };
            })
            .filter(Boolean);

        if (!sections.length) return;

        function setActiveNav(activeSection) {
            sections.forEach(function (entry) {
                entry.item.classList.toggle("navItemActive", entry.section === activeSection);
            });
        }

        function updateActiveNavByScroll() {
            const scrollY = window.scrollY || window.pageYOffset;

            // Keep Agenda active at top and while hero is in viewport.
            if (scrollY <= 60) {
                setActiveNav(sections[0].section);
                return;
            }

            const header = document.querySelector("header.topHeader");
            const headerOffset = header ? header.offsetHeight + 24 : 120;
            const currentLine = scrollY + headerOffset;

            let activeSection = sections[0].section;
            sections.forEach(function (entry) {
                if (entry.section.offsetTop <= currentLine) {
                    activeSection = entry.section;
                }
            });

            setActiveNav(activeSection);
        }

        window.addEventListener("scroll", updateActiveNavByScroll, { passive: true });
        window.addEventListener("resize", updateActiveNavByScroll);
        updateActiveNavByScroll();
    });

    document.addEventListener("DOMContentLoaded", function () {
        // Countdown Timer Logic
        const targetDate = new Date("April 18, 2026 00:00:00").getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                const cd = document.getElementById("tnt-countdown");
                if (cd) cd.innerHTML = "<span class='tnt-blue-text' style='font-size:14px; font-weight:700;'>EVENT STARTED</span>";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            const elD = document.getElementById("tnt-d");
            const elH = document.getElementById("tnt-h");
            const elM = document.getElementById("tnt-m");
            const elS = document.getElementById("tnt-s");

            if (elD) elD.innerText = days.toString().padStart(2, '0');
            if (elH) elH.innerText = hours.toString().padStart(2, '0');
            if (elM) elM.innerText = minutes.toString().padStart(2, '0');
            if (elS) elS.innerText = seconds.toString().padStart(2, '0');
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Header Displacement Logic
        const tntAnnouncement = document.getElementById("tnt-announcement");
        const topHeader = document.querySelector("header.topHeader");
        const mobileHeader = document.querySelector(".mobileHeader");
        const mobileHeaderContent = document.getElementById("mobileHeaderContent");

        function adjustHeaderPosition() {
            if (tntAnnouncement) {
                const h = tntAnnouncement.offsetHeight;
                const scrollY = window.scrollY || window.pageYOffset;
                const currentOffset = Math.max(0, h - scrollY);

                if (topHeader) {
                    topHeader.style.marginTop = currentOffset + "px";
                }
                if (mobileHeader) {
                    mobileHeader.style.marginTop = currentOffset + "px";
                }
                if (mobileHeaderContent) {
                    mobileHeaderContent.style.marginTop = currentOffset + "px";
                }
            }
        }

        window.addEventListener('scroll', adjustHeaderPosition, { passive: true });
        window.addEventListener('resize', adjustHeaderPosition);
        setTimeout(adjustHeaderPosition, 50);
        setTimeout(adjustHeaderPosition, 500);
        adjustHeaderPosition();
    });
</script>


