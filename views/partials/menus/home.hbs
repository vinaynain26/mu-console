<script>
    (function () {
        // ✅ Run ONLY on desktop (>= 768px)
        if (!window.matchMedia("(min-width: 768px)").matches) return;

        function safeNumber(value) {
            const n = Number(value);
            return Number.isFinite(n) ? n : 0;
        }

        function showMenu(id) {
            $(".menuDown").removeClass("active");
            if (id) {
                $("#" + id).addClass("active");
                $("header").addClass("menuActive");
                $(".blurScreen").addClass("active");
                $("body").css("overflow", "hidden");
            }
        }

        function hideMenu() {
            $(".menuDown").removeClass("active");
            $("header").removeClass("menuActive");
            $(".blurScreen").removeClass("active");
            $("body").css("overflow", "auto");
        }

        $(".megaLink").off("mouseenter mouseleave");

        $(".megaLink").on("click", function (e) {
            e.preventDefault();
            const id = $(this).attr("data-rel");
            if (!id) return;

            if ($(this).hasClass("active")) {
                hideMenu();
                $(".megaLink").removeClass("active");
            } else {
                $(".megaLink").removeClass("active");
                $(this).addClass("active");
                showMenu(id);
            }
        });

        $(".academicTabs .aboutItems")
            .off("mouseenter click")
            .on("mouseenter", function () {
                const id = $(this).attr("data-rel");
                if (!id) return;

                $(this).addClass("active").siblings().removeClass("active");

                const $tabAcademic = $(this).closest(".tabAcademic");
                $tabAcademic.find(".academic-content").removeClass("active");
                $tabAcademic.find("#" + id).addClass("active");
            });

        $(".tabSecondary .aboutTabs .aboutItems")
            .off("mouseenter click")
            .on("mouseenter", function () {
                const id = $(this).attr("data-rel");
                if (!id) return;

                $(this).addClass("active").siblings().removeClass("active");

                const $tabSecondary = $(this).closest(".tabSecondary");
                $tabSecondary.find(".sub-academic-content").removeClass("active");
                $tabSecondary.find("#" + id).addClass("active");
            });

        function closeMenu() {
            hideMenu();
            $(".megaLink").removeClass("active");
        }

        $(".blurScreen").off("click").on("click", closeMenu);

        $(".menuDown")
            .off("click")
            .on("click", function (e) {
                if (e.target === this) {
                    closeMenu();
                }
            });

        $(".menuDown")
            .off("mousedown")
            .on("mousedown", function (e) {
                e.stopPropagation();
            });

        $(".menuDown").off("mouseleave");

        $(document).on("mousedown", function (e) {
            if (
                !$(e.target).closest(".menuDown").length &&
                !$(e.target).closest(".megaLink").length &&
                !$(e.target).closest(".navMenu").length &&
                $(".menuDown.active").length
            ) {
                closeMenu();
            }
        });

        function setActiveClassHeader() {
            const currentPath = window.location.pathname.split("/")[1];

            document
                .querySelectorAll(".navMenu .dropdownItems")
                .forEach((el) => el.classList.remove("active"));

            const elem = document.querySelector(`#nav__${currentPath}`);
            if (elem) {
                elem.classList.add("active");
            }
        }

        document.addEventListener("DOMContentLoaded", setActiveClassHeader);

        // Header shrink logic
        (function () {
            const $menu = $("header.topHeader");
            let lastScrollTop = 0;
            const menuHeight = safeNumber($menu.outerHeight());
            const windowHeight = safeNumber($(window).height());

            function getBannerOffset() {
                const $banner = $(".bannerTop");
                const bannerHeight = $banner.length ? safeNumber($banner.outerHeight()) : 0;

                const $heroBanner = $("#heroBanner");
                const heroBannerHeight =
                    ($heroBanner.length && $heroBanner.hasClass("active"))
                        ? safeNumber($heroBanner.outerHeight())
                        : 0;

                return bannerHeight + heroBannerHeight;
            }

            $(window).on("scroll", function () {
                const st = safeNumber($(this).scrollTop());
                const bannerOffset = getBannerOffset();
                const currentOffset = Math.max(0, bannerOffset - st);

                if (st <= 80) {
                    $menu.css("top", currentOffset + "px");
                    $menu.removeClass("shrikIt");
                    lastScrollTop = st;
                    return;
                }

                if (st > lastScrollTop) {
                    if (
                        st > menuHeight &&
                        st + windowHeight < safeNumber($(document).height())
                    ) {
                        $menu.css("top", "-2.25rem");
                        $menu.addClass("shrikIt");
                    }
                } else {
                    if (st <= 80) {
                        $menu.css("top", currentOffset + "px");
                        $menu.removeClass("shrikIt");
                    }
                }

                lastScrollTop = st;
            });
        })();
    })();
</script>
{{!-- blue screen script Ends --}}

{{!-- web Header linear gradient script starts --}}
<script>
    (function () {
        const header = document.querySelector("header.topHeader");
        if (!header) return;

        const DESKTOP_MIN_WIDTH = 768; // sirf web/desktop

        function updateHeaderBG() {

            // mobile? -> kuch mat karo
            if (window.innerWidth < DESKTOP_MIN_WIDTH) {
                return;
            }

            if (window.scrollY > 40) {
                header.style.background = "var(--black)";
            } else {
                header.style.background =
                    "linear-gradient(to bottom, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.5) 30%, rgba(0, 0, 0, 0.3) 55%, rgba(0, 0, 0, 0) 100%)";
            }
        }

        window.addEventListener("scroll", updateHeaderBG, { passive: true });
        window.addEventListener("resize", updateHeaderBG);

        updateHeaderBG(); // initial call
    })();
</script>
{{!-- web Header linear gradient script Ends --}}