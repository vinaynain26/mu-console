    <script>
        (function () {
            // Other Tabs (Student Life, Innovation, …): run as soon as markup exists — no DOMContentLoaded wait.
            document.querySelectorAll(".tabMenuOther").forEach(function (tabMenu) {
                var otherTabs = tabMenu.querySelector(".otherTabs");
                if (!otherTabs) return;

                var tabList = otherTabs.querySelectorAll(".aboutItems");
                var contents = tabMenu.querySelectorAll(".otherSecondaryContent");
                var firstTab = tabList[0];
                if (!firstTab) return;

                function clearActive() {
                    tabList.forEach(function (li) {
                        li.classList.remove("active");
                    });
                    contents.forEach(function (c) {
                        c.classList.remove("active");
                        if (c instanceof HTMLElement) c.style.display = "none";
                    });
                }

                function showContent(target) {
                    contents.forEach(function (c) {
                        if (c.id === target) {
                            c.classList.add("active");
                            if (c instanceof HTMLElement) c.style.display = "";
                        }
                    });
                }

                clearActive();
                firstTab.classList.add("active");
                showContent(firstTab.getAttribute("data-target"));

                otherTabs.addEventListener("mouseover", function (e) {
                    var t = e.target;
                    if (!t || typeof t.closest !== "function") return;
                    var li = t.closest(".aboutItems");
                    if (!li || !otherTabs.contains(li) || li.classList.contains("active")) return;
                    clearActive();
                    li.classList.add("active");
                    showContent(li.getAttribute("data-target"));
                });

                otherTabs.addEventListener("click", function (e) {
                    var t = e.target;
                    if (!t || typeof t.closest !== "function") return;
                    var li = t.closest(".aboutItems");
                    if (!li || !otherTabs.contains(li)) return;
                    var link = li.querySelector("a");
                    if (link && link.href) window.location.href = link.href;
                });
            });
        })();
    </script>

