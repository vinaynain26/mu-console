<link rel="stylesheet" href="/assets/css/menu.css">

<style>
    .enterList {
        padding: 10px 8px;
        display: flex;
        align-items: center;
        width: 100%;
        justify-content: space-between;
        border-bottom: 1px solid var(--grey17);
        cursor: pointer;
        transition: 0.4s ease;

        img {
            transition: 0.4s ease;
            max-width: 16px;
        }
    }

    .enterList:hover {
        img {
            transform: translate(4px, -4px);

        }
    }

    .shapeText {
        font-size: 14px;
        line-height: 120%;
        font-family: var(--go-regular);
        color: var(--grey4);

    }

    .enterDrop {
        padding:8px;
        background: var(--black);
        border-radius: 12px;
        width: 100%;
        max-width: 182px;
        border: 1px solid var(--grey3);
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
    }

    .menuDown::after {
        background: unset;
    }

    .topHeader {
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.5) 30%, rgba(0, 0, 0, 0.4) 55%, rgba(0, 0, 0, 0.0) 100%);
    }

    .menuDown {
        background: unset;
    }

    .enterDrop {
        position: absolute;
        right: 23%;
    }

    .enterDrop2 {
        position: absolute;
        right: 15%;
    }

    @media (min-width: 1220px) and (max-width: 1500px) {
        .enterDrop {
            right: 18%;
        }

        .enterDrop2 {
            right: 6%;
        }
    }
    @media (min-width: 1500px) and (max-width: 1920px) {
        .enterDrop {
            right: 26%;
        }
        .enterDrop2 {
            right: 17%;
        }
    }

    .navMenu {

        gap: 32px;
        .megaLink.active {
            .dropdownItems {
                color: #E38330;
            }

            .dropdownItems::after {
                background: var(--grey3) !important;
                transform: scaleX(1);
            }

            .dropdownItems .dropdown-icon path {
                stroke: #E38330;
            }
        }
    }

    .mu-home-countdown {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(0, 0, 0, 0.4);
        /* very light background for white banner */
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 4px 10px;
    }

    .dropImage {
        display: none;
        transition: 0.4s ease;
    }

    .dropdownItems {
        position: relative;
        padding: 0 8px;
    }


    .dropdownItems.active::after {
        transform: scaleX(1);
    }


    .navMenu .megaLink.menu-open>.dropdownItems.droEvent::after {
        background: var(--grey3) !important;
        transform: scaleX(1);
    }

    .navMenu .megaLink>.dropdownItems.droEvent .dropdown-icon {
        transform: rotate(0deg);
        transition: transform 0.6s ease;
    }

    .navMenu .megaLink.menu-open>.dropdownItems.droEvent .dropdown-icon {
        transform: rotate(180deg);
    }

    .topHeader.shrikIt {
        top: 0px !important;
        border-bottom: unset;
    }

    .navMenu .dropdownItems:hover {
        color: #E38330;
        font-family: "go-medium";
        font-weight: 600;

    }

    .navMenu .dropdownItems.active {
        color: #E38330;
        font-family: "go-medium";
        font-weight: 600;

        .dropImage {
            display: block;
        }
    }

    body.enterprise-nav-loading {
        cursor: progress;
    }

    body.enterprise-nav-loading .navMenu .dropdownItems {
        pointer-events: none;
    }

    .belowHeader {
        padding: 4.5px 0;
    }

    .mu-time-item {
        display: flex;
        align-items: baseline;
        gap: 2px;
    }

    .navMenu .dropdownItems {
        font-size: 14px;
        font-family: var(--go-medium);
        color: var(--grey4);
        text-transform: capitalize;
        transition: 0.4s ease all;
    }

    .mu-time-item span:first-child {
        font-size: 13px;
        font-weight: 700;
        font-feature-settings: "tnum";
        font-variant-numeric: tabular-nums;
        color: white;
    }

    .mu-time-lbl {
        font-size: 10px;
        font-weight: 600;
        color: var(--grey10, #666);
    }

    .mu-colon {
        font-weight: 700;
        color: var(--grey10, #666);
        position: relative;
        top: -1px;
    }

    .topHeader .menuLogo {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 20px;
        max-width: fit-content;
    }

    .homeDirect {
        width: 100%;
        max-width: 20px;
    }

    .enterLinking {
        width: 100%;
        max-width: 206px;
    }

    @media (max-width: 480px) {
        .mu-home-countdown {
            padding: 3px 6px;
            gap: 4px;
        }

        .mu-time-item span:first-child {
            font-size: 11px;
        }
    }

    @media (max-width: 767px) {
        .mobileMenu .menuLogo {
            width: 100%;
            gap: 0px;
        }

        .mobileMenu .hamburgerParent {
            padding: 10px 0;
        }

        .mobileMenu .heading {
            text-transform: capitalize;
        }


        .mobileMenu .mobMenuHeader .logo {
            width: 60%;
        }


    }
</style>



