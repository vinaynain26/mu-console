<div id="preloader">
  <div class="preloader">
    <img  src="https://files.mastersunion.link/Preloader.gif" alt="Loader">
  </div>
</div>
{{> popups/heroPopup }}
{{>components/bottomFooter}}
{{>components/cokkie}}
<script>
  // Function to hide preloader
  function hidePreloader() {
    $("#preloader").fadeOut(1000);
  }

  // Hide preloader after 2 seconds on page load
  $("#preloader").fadeOut(1000);

  // Handle page visibility change (browser back/forward)
  document.addEventListener("visibilitychange", function() {
    if (!document.hidden) {
      // Page became visible (user came back via back button)
      hidePreloader();
    }
  });

  // Handle page show event (browser back/forward)
  window.addEventListener("pageshow", function(event) {
    // If page was loaded from cache (back/forward navigation)
    if (event.persisted) {
      hidePreloader();
    }
  });

  // Handle page load event
  window.addEventListener("load", function() {
    // Additional safety to hide preloader after page is fully loaded
    setTimeout(hidePreloader, 500);
  });

  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".darkHeader a, footer a").forEach((link) => {
      link.addEventListener("click", function (e) {
        const href = (link.getAttribute("href") || "").trim().toLowerCase();
        // Do not show page loader for non-page navigation links like mailto/tel.
        if (href.startsWith("mailto:") || href.startsWith("tel:")) {
          hidePreloader();
          return;
        }

        // Show preloader immediately
        document.getElementById("preloader").style.display = "block";
        
        // Check if this is a middle-click, ctrl+click, or cmd+click (new tab)
        if (e.button === 1 || e.ctrlKey || e.metaKey) {
          // If opening in new tab, fade out preloader after a short delay
          setTimeout(hidePreloader, 100);
        }
      });
      
      // Also handle mouseup event for middle-click detection
      link.addEventListener("mouseup", function (e) {
        if (e.button === 1) { // Middle click
          setTimeout(hidePreloader, 100);
        }
      });
    });
  });

</script>
