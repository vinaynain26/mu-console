<script>
    document.addEventListener("DOMContentLoaded", () => {
        var slider = document.getElementById("lensWrapper");

        // Hide scrollbar but keep functionality
        slider.style.msOverflowStyle = 'none'; // IE and Edge
        slider.style.scrollbarWidth = 'none'; // Firefox
        slider.style.overflow = 'scroll';
        slider.style.overflow = '-webkit-scrollbar'; // Chrome and Safari (not standard)

        // Clone the contents once to allow seamless scroll
        slider.innerHTML += slider.innerHTML;

        let scrollAmount = 0;
        let animationFrame;

        function autoScroll() {
            scrollAmount += 0.90; // Adjust scroll speed here
            slider.scrollLeft = scrollAmount;

            // Reset scroll when it reaches half (original content width)
            if (scrollAmount >= slider.scrollWidth / 2) {
                scrollAmount = 0;
            }

            animationFrame = requestAnimationFrame(autoScroll);
        }

        // Start scrolling
        autoScroll();

        // Pause on hover
        slider.addEventListener('mouseenter', () => {
            cancelAnimationFrame(animationFrame);
        });

        // Resume on mouse leave
        slider.addEventListener('mouseleave', () => {
            autoScroll();
        });
    });
</script>


<script>
    document.addEventListener("DOMContentLoaded", () => {

        var slider = document.getElementById("lensWrapper2");

        // Hide scrollbar but keep functionality
        slider.style.msOverflowStyle = 'none'; // IE and Edge
        slider.style.scrollbarWidth = 'none'; // Firefox
        slider.style.overflow = 'scroll';
        slider.style.overflow = '-webkit-scrollbar'; // Chrome and Safari (not standard)

        // Clone the contents once to allow seamless scroll
        slider.innerHTML += slider.innerHTML;

        let scrollAmount = slider.scrollWidth / 2; // Start from middle (end of original content)
        let animationFrame;

        function autoScroll() {
            scrollAmount -= 0.9; // Reverse scroll speed

            slider.scrollLeft = scrollAmount;

            // Reset to the end if reaches the start
            if (scrollAmount <= 0) {
                scrollAmount = slider.scrollWidth / 2;
            }

            animationFrame = requestAnimationFrame(autoScroll);
        }

        // Start scrolling
        autoScroll();

        // Pause on hover
        slider.addEventListener('mouseenter', () => {
            cancelAnimationFrame(animationFrame);
        });

        // Resume on mouse leave
        slider.addEventListener('mouseleave', () => {
            autoScroll();
        });
    });
</script>