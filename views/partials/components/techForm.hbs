</div>

<script>
    // ─────────────────────────────────────────────────────────────────────────────
    //  Registration form — THE NEXT TECH 1.0
    //
    //  Flow:
    //    1. User opens modal  →  openModal()
    //    2. User fills form and clicks SUBMIT  →  handleFormSubmit()
    //       a. validateAllFields()   — shows red errors inline, stops if invalid
    //       b. detectDeviceType()    — mobile / tablet / desktop from screen width
    //       c. readUtmParamsFromUrl() — picks up any utm_* / gclid / fbclid from URL
    //       d. buildRequestBody()    — assembles the full payload
    //       d. registerForEvent()    — POSTs to API
    //    3. On success  →  showThankYouScreen(data)   — hides form, shows QR + token
    //    4. User closes modal  →  closeModal()         — resets back to form
    // ─────────────────────────────────────────────────────────────────────────────

    var API_BASE = "{{apiBaseUrl}}";

    // Event details — change these if the event changes Critical INFORMATION FOR THE NEXT TECH 1.0 *******************************************************************************************
    var EVENT_NAME = 'THE NEXT TECH 1.0';
    var EVENT_SLUG = 'the-next-tech-1.0';
    var EVENT_DATE     = '2026-04-18T03:30:00.000Z';  // 18 Apr 2026, 9 AM IST (UTC+5:30)
    var EVENT_LOCATION = 'Masters\' Union Campus, DLF CyberPark, Gurugram';
    /* ******************************************************************************  critical information for the next tech 1.0 ******************************************************************************************* */

    // Payment amounts per role (in INR)
    var ROLE_PAY_AMOUNTS = {
        student_delegate:      1,
        professional_delegate: 2,
        sponsor:               3,
        exhibitor:             4,
        awardee_nomination:    5
    };

    function getPayAmountForRole(role) {
        return ROLE_PAY_AMOUNTS.hasOwnProperty(role) ? ROLE_PAY_AMOUNTS[role] : 0;
    }


    // ── 1. MODAL OPEN / CLOSE ────────────────────────────────────────────────────

    var tnIsScrollLocked = false;
    var tnOriginalScrollY = 0;
    var tnOriginalBodyPaddingRight = '';
    var tnOriginalHtmlOverflow = '';
    var tnOriginalBodyOverflow = '';

    function lockBackgroundScroll() {
        if (tnIsScrollLocked) return;
        tnIsScrollLocked = true;

        tnOriginalScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;

        var html = document.documentElement;
        var body = document.body;
        tnOriginalHtmlOverflow = html.style.overflow || '';
        tnOriginalBodyOverflow = body.style.overflow || '';
        tnOriginalBodyPaddingRight = body.style.paddingRight || '';

        var scrollBarWidth = window.innerWidth - document.documentElement.clientWidth;
        if (scrollBarWidth > 0) {
            body.style.paddingRight = scrollBarWidth + 'px';
        }

        html.style.overflow = 'hidden';

        body.style.position = 'fixed';
        body.style.top = (-tnOriginalScrollY) + 'px';
        body.style.left = '0';
        body.style.right = '0';
        body.style.width = '100%';
        body.style.overflow = 'hidden';
    }

    function unlockBackgroundScroll() {
        if (!tnIsScrollLocked) return;
        tnIsScrollLocked = false;

        var html = document.documentElement;
        var body = document.body;
        body.style.position = '';
        body.style.top = '';
        body.style.left = '';
        body.style.right = '';
        body.style.width = '';
        body.style.overflow = tnOriginalBodyOverflow;
        body.style.paddingRight = tnOriginalBodyPaddingRight;
        html.style.overflow = tnOriginalHtmlOverflow;

        window.scrollTo(0, tnOriginalScrollY);
    }

    function openModal() {
        var modal = document.getElementById('tn-register-modal');
        if (!modal) return;
        resetToFormScreen();
        lockBackgroundScroll();
        modal.classList.add('is-visible');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('tnModal-open');
    }

    function closeModal() {
        var modal = document.getElementById('tn-register-modal');
        if (!modal) return;
        modal.classList.remove('is-visible');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('tnModal-open');
        resetToFormScreen();
        unlockBackgroundScroll();
    }

    function resetToFormScreen() {
        var form = document.getElementById('tnRegisterForm');
        var thanks = document.getElementById('tnThankYouInline');
        if (form) form.hidden = false;
        if (thanks) thanks.hidden = true;
        clearForm();
    }

    function clearForm() {
        ['tn-name', 'tn-company', 'tn-email', 'tn-designation', 'tn-phone', 'tn-context'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.value = '';
        });

        var select = document.getElementById('tn-registerAs');
        if (select) select.selectedIndex = 0;

        ['tn-name-err', 'tn-company-err', 'tn-email-err', 'tn-designation-err', 'tn-phone-err', 'tn-registerAs-err', 'tn-context-err'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.textContent = '';
        });

        document.querySelectorAll('#tnRoleFieldsContainer [data-role-required]').forEach(function (el) {
            if (el.tagName === 'SELECT') {
                el.selectedIndex = 0;
            } else {
                el.value = '';
            }
            var errorEl = document.getElementById(el.id + '-err');
            if (errorEl) errorEl.textContent = '';
        });

        // hide payment field and clear its value
        var payWrap = document.getElementById('tn-payment-wrap');
        var payInput = document.getElementById('tn-payAmount');
        if (payWrap) payWrap.hidden = true;
        if (payInput) payInput.value = '';

        updateRoleSpecificFieldsVisibility('');

        var formError = document.getElementById('tn-form-error');
        if (formError) formError.textContent = '';

        var consentCb = document.getElementById('consentChecktn1');
        if (consentCb) consentCb.checked = false;
        var consentErr = document.getElementById('consentCheckErrortn1');
        if (consentErr) consentErr.classList.add('warning');

        resetSubmitButton(document.getElementById('tnSubmitBtn'));
    }


    // ── 2a. VALIDATE ALL FIELDS ──────────────────────────────────────────────────

    function validateAllFields() {
        var allValid = true;

        var fieldsToCheck = [
            { id: 'tn-name', errorMsg: 'Name is required' },
            { id: 'tn-company', errorMsg: 'Company is required' },
            { id: 'tn-email', errorMsg: 'Valid email is required', checkEmail: true },
            { id: 'tn-designation', errorMsg: 'Designation is required' },
            { id: 'tn-phone', errorMsg: 'Contact number is required' },
            { id: 'tn-registerAs', errorMsg: 'Please select a role' },
            { id: 'tn-context', errorMsg: 'Please fill this field' }
        ];

        fieldsToCheck.forEach(function (field) {
            var input = document.getElementById(field.id);
            var errorEl = document.getElementById(field.id + '-err');
            if (!input || !errorEl) return;

            var value = input.value.trim();
            var errorMsg = '';

            if (!value) {
                errorMsg = field.errorMsg;
            } else if (field.checkEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
                errorMsg = 'Please enter a valid email address';
            }

            errorEl.textContent = errorMsg;
            if (errorMsg) allValid = false;
        });

        if (!validateRoleSpecificFields()) allValid = false;

        return allValid;
    }

    function updateRoleSpecificFieldsVisibility(selectedRole) {
        document.querySelectorAll('#tnRoleFieldsContainer .tnRoleFields').forEach(function (block) {
            var isVisible = block.getAttribute('data-role') === selectedRole;
            block.hidden = !isVisible;
        });

        var payWrap = document.getElementById('tn-payment-wrap');
        var payInput = document.getElementById('tn-payAmount');
        if (payWrap && payInput) {
            if (selectedRole && ROLE_PAY_AMOUNTS.hasOwnProperty(selectedRole)) {
                payInput.value = '₹' + ROLE_PAY_AMOUNTS[selectedRole];
                payWrap.hidden = false;
            } else {
                payInput.value = '';
                payWrap.hidden = true;
            }
        }
    }

    function validateRoleSpecificFields() {
        var selectedRole = document.getElementById('tn-registerAs').value;
        var activeBlock = document.querySelector('#tnRoleFieldsContainer .tnRoleFields[data-role="' + selectedRole + '"]');
        if (!activeBlock) return true;

        var isValid = true;
        activeBlock.querySelectorAll('[data-role-required]').forEach(function (field) {
            var errorEl = document.getElementById(field.id + '-err');
            if (!errorEl) return;
            var value = (field.value || '').trim();
            if (!value) {
                errorEl.textContent = (field.getAttribute('data-role-label') || 'This field') + ' is required';
                isValid = false;
            } else {
                errorEl.textContent = '';
            }
        });

        return isValid;
    }


    // ── 2b. DETECT DEVICE TYPE FROM SCREEN WIDTH ────────────────────────────────

    function detectDeviceType() {
        var width = window.innerWidth;
        if (width <= 480) return 'mobile';
        if (width <= 1024) return 'tablet';
        return 'desktop';
    }


    // ── 2c. READ UTM PARAMS FROM URL ─────────────────────────────────────────────

    function readUtmParamsFromUrl() {
        var params = new URLSearchParams(window.location.search);

        function get(key) { return params.get(key) || undefined; }

        return {
            source: get('utm_source') || window.location.href,
            medium: get('utm_medium'),
            campaign: get('utm_campaign'),
            term: get('utm_term'),
            content: get('utm_content'),
            campaignId: get('utm_campaign_id') || get('campaignid'),
            adGroupId: get('utm_adgroup_id') || get('adgroupid'),
            creativeId: get('utm_creative_id') || get('creativeid'),
            placement: get('utm_placement') || get('placement'),
            gclid: get('gclid'),
            fbclid: get('fbclid'),
            leadSource: get('lead_source') || get('leadsource') || "THE NEXT TECH 1.0 Register For Event Form",
            leadOrigin: get('lead_origin') || get('leadorigin') || "THE NEXT TECH 1.0 Register For Event Form",
            device: get('device'),
            landingPage: window.location.pathname,
            fullUrl: window.location.href
        };
    }


    // ── 2d. BUILD REQUEST BODY ───────────────────────────────────────────────────

    function buildRequestBody(utm, deviceType) {
        var selectedRole = document.getElementById('tn-registerAs').value;

        var body = {
            // event info
            eventName: EVENT_NAME,
            eventSlug: EVENT_SLUG,
            eventDate: EVENT_DATE,
            eventLocation: EVENT_LOCATION,

            // core user fields
            name:        document.getElementById('tn-name').value.trim(),
            email:       document.getElementById('tn-email').value.trim(),
            mobile:      document.getElementById('tn-phone').value.trim(),
            company:     document.getElementById('tn-company').value.trim(),
            designation: document.getElementById('tn-designation').value.trim(),
            registerAs:  selectedRole,
            notes:       document.getElementById('tn-context').value.trim(),
            payAmount:   getPayAmountForRole(selectedRole),
            consentCheck: document.getElementById('consentChecktn1')?.checked || false,

            // device type
            deviceType: deviceType,

            // tracking
            source:     utm.source,
            medium:     utm.medium,
            campaign:   utm.campaign,
            term:       utm.term,
            content:    utm.content,
            campaignId: utm.campaignId,
            adGroupId:  utm.adGroupId,
            creativeId: utm.creativeId,
            placement:  utm.placement,
            gclid:      utm.gclid,
            fbclid:     utm.fbclid,
            leadSource: utm.leadSource,
            leadOrigin: utm.leadOrigin,
            landingPage: utm.landingPage,
            fullUrl:    utm.fullUrl
        };

        // role-specific fields as individual keys
        if (selectedRole === 'student_delegate') {
            body.school        = document.getElementById('tn-student-school').value.trim();
            body.academicYear  = document.getElementById('tn-student-academic-year').value.trim();
            body.studentIdProof = document.getElementById('tn-student-id-proof').value.trim();

        } else if (selectedRole === 'professional_delegate') {
            body.profCompany     = document.getElementById('tn-prof-company').value.trim();
            body.profDesignation = document.getElementById('tn-prof-designation').value.trim();

        } else if (selectedRole === 'exhibitor') {
            body.exhibitorCompany     = document.getElementById('tn-exhibitor-company').value.trim();
            body.exhibitorBusiness    = document.getElementById('tn-exhibitor-business').value.trim();
            body.exhibitorDesignation = document.getElementById('tn-exhibitor-designation').value.trim();
            body.exhibitorPurpose     = document.getElementById('tn-exhibitor-purpose').value.trim();
            body.exhibitorBoothSize   = document.getElementById('tn-exhibitor-booth-size').value;

        } else if (selectedRole === 'sponsor') {
            body.sponsorInterest = document.getElementById('tn-sponsor-interest').value.trim();

        } else if (selectedRole === 'awardee_nomination') {
            body.awardCategory    = document.getElementById('tn-award-category').value.trim();
            body.awardNomineeName = document.getElementById('tn-award-nominee-name').value.trim();
            body.awardNomineeOrg  = document.getElementById('tn-award-org').value.trim();
        }

        return body;
    }


    // ── 2e. CALL THE REGISTRATION API ───────────────────────────────────────────

    function registerForEvent(body, submitBtn, formErrorEl) {
        fetch(API_BASE + '/api/flagship-event-registration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        })
            .then(function (res) { return res.json(); })
            .then(function (response) {

                if (!response.success) {
                    formErrorEl.textContent = response.message || 'Registration failed. Please try again.';
                    resetSubmitButton(submitBtn);
                    return;
                }

                showThankYouScreen();
            })
            .catch(function (networkError) {
                formErrorEl.textContent = 'Something went wrong. Please try again.';
                resetSubmitButton(submitBtn);
                console.error('Registration error:', networkError);
            });
    }


    // ── 3. SHOW THANK YOU SCREEN ─────────────────────────────────────────────────

    function showThankYouScreen() {
        var form = document.getElementById('tnRegisterForm');
        var thanks = document.getElementById('tnThankYouInline');
        if (form) form.hidden = true;
        if (thanks) thanks.hidden = false;
    }


    // ── HELPERS ──────────────────────────────────────────────────────────────────

    function setSubmitButtonLoading(btn) {
        if (!btn) return;
        btn.disabled = true;
        btn.textContent = 'Submitting...';
    }

    function resetSubmitButton(btn) {
        if (!btn) return;
        btn.disabled = false;
        btn.textContent = 'SUBMIT';
    }


    // ── ENTRY POINT — called when form is submitted ───────────────────────────────

    function handleFormSubmit() {
        var formErrorEl = document.getElementById('tn-form-error');
        var submitBtn = document.getElementById('tnSubmitBtn');

        formErrorEl.textContent = '';

        var isValid = validateAllFields();

        if (!document.getElementById('consentChecktn1')?.checked) { document.getElementById('consentCheckErrortn1').classList.remove('warning'); isValid = false; } else { document.getElementById('consentCheckErrortn1').classList.add('warning'); }

        if (!isValid) return;

        setSubmitButtonLoading(submitBtn);

        var deviceType = detectDeviceType();
        var utm = readUtmParamsFromUrl();
        var body = buildRequestBody(utm, deviceType);

        registerForEvent(body, submitBtn, formErrorEl);
    }


    // ── WIRE EVERYTHING UP ───────────────────────────────────────────────────────

    function wireUpModalAndForm() {
        var modal = document.getElementById('tn-register-modal');
        if (!modal) return;

        if (modal.dataset.tnInit === '1') return;
        modal.dataset.tnInit = '1';

        var closeBtn = modal.querySelector('.tnModalClose');
        if (closeBtn) closeBtn.addEventListener('click', closeModal);

        modal.addEventListener('click', function (e) {
            if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
        });

        document.querySelectorAll('[data-open-tn-modal]').forEach(function (trigger) {
            trigger.addEventListener('click', function (e) {
                e.preventDefault();
                openModal();
            });
        });

        var form = document.getElementById('tnRegisterForm');
        if (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                handleFormSubmit();
            });
        }

        var registerAs = document.getElementById('tn-registerAs');
        if (registerAs) {
            registerAs.addEventListener('change', function (e) {
                updateRoleSpecificFieldsVisibility(e.target.value);
            });
            updateRoleSpecificFieldsVisibility(registerAs.value);
        }

    }

    window.openTnRegisterModal = function (e) { if (e && e.preventDefault) e.preventDefault(); openModal(); };
    window.closeTnRegisterModal = function (e) { if (e && e.preventDefault) e.preventDefault(); closeModal(); };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wireUpModalAndForm);
    } else {
        wireUpModalAndForm();
    }
</script>