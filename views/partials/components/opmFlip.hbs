<script>
    (function () {

        // 👇 Mobile condition (max-width: 768px)
        if (!window.matchMedia("(max-width: 768px)").matches) {
            return; // Desktop pe kuch bhi run nahi hoga
        }

        var section = document.querySelector('.cohortMeet');
        var cards = Array.prototype.slice.call(document.querySelectorAll('.cohortMeet .cohortRight .person .flip-card'));
        if (!section || !cards.length) return;

        var currentIndex = -1;
        var pool = [];
        var flipGap = 1400;
        var visibleDuration = 1400;
        var intervalId = null;
        var unflipTimeoutId = null;

        function refillPool() {
            pool = cards.map(function (_, idx) {
                return idx;
            });

            for (var i = pool.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                var temp = pool[i];
                pool[i] = pool[j];
                pool[j] = temp;
            }
        }

        function getNextIndex() {
            if (!pool.length) refillPool();
            if (pool[0] === currentIndex && pool.length > 1) {
                pool.push(pool.shift());
            }
            return pool.shift();
        }

        function runFlip() {
            if (currentIndex !== -1) {
                cards[currentIndex].classList.remove('is-flipped');
                cards[currentIndex].style.transform = '';
            }

            currentIndex = getNextIndex();
            cards[currentIndex].classList.add('is-flipped');
            cards[currentIndex].style.transform = 'rotateY(180deg)';

            if (unflipTimeoutId) {
                window.clearTimeout(unflipTimeoutId);
            }

            unflipTimeoutId = window.setTimeout(function () {
                cards[currentIndex].classList.remove('is-flipped');
                cards[currentIndex].style.transform = '';
                unflipTimeoutId = null;
            }, visibleDuration);
        }

        function stopFlips() {
            if (intervalId) {
                window.clearInterval(intervalId);
                intervalId = null;
            }
            if (unflipTimeoutId) {
                window.clearTimeout(unflipTimeoutId);
                unflipTimeoutId = null;
            }
            if (currentIndex !== -1) {
                cards[currentIndex].classList.remove('is-flipped');
                cards[currentIndex].style.transform = '';
            }
        }

        function startFlips() {
            if (intervalId) return;
            runFlip();
            intervalId = window.setInterval(runFlip, flipGap + visibleDuration);
        }

        if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        startFlips();
                    } else {
                        stopFlips();
                    }
                });
            }, { threshold: 0.25 });

            observer.observe(section);
        } else {
            startFlips();
        }

    })();
</script>