<script>
    $(document).ready(function () {
        let isInitialized = false;
        let isManualScroll = false;

        function getScrollOffset() {
            if (window.matchMedia("(max-width: 1023px)").matches) {
                return 225;
            } else if (window.matchMedia("(min-width: 1440px)").matches) {
                return 320;
            } else {
                return 210;
            }
        }

        function scrollToElement(id) {
            let targetElement = $(`#${id}`);
            if (targetElement.length) {
                let scrollOffset = getScrollOffset();
                isManualScroll = true;
                $('html, body').animate({
                    scrollTop: targetElement.offset().top - scrollOffset
                }, 600, function () {
                    isManualScroll = false;
                });
            }
        }

        function initialize() {
            $(".navigationBox .courseName").off('click').on('click', function () {
                let id = $(this).attr('data-rel');
                $(this).addClass('active').siblings().removeClass('active');
                $(`#${id}`).addClass('active').siblings().removeClass('active');
                scrollToElement(id);

                // On mobile, ensure tab also scrolls into view
                if (window.matchMedia("(max-width: 767px)").matches) {
                    this.scrollIntoView({
                        behavior: "smooth",
                        inline: "center",
                        block: "nearest"
                    });
                }
            });

            const boxes = document.querySelectorAll('.box');
            const options = {
                root: null,
                rootMargin: '0px',
                threshold: 0.3
            };

            const handleIntersection = (entries) => {
                if (isManualScroll) return;

                entries.forEach(entry => {
                    const boxId = entry.target.id;
                    const navLink = document.querySelector(`[data-rel="${boxId}"]`);

                    if (entry.isIntersecting && navLink) {
                        document.querySelectorAll(".navigationBox .courseName").forEach(sib => {
                            sib.classList.remove("active");
                        });
                        navLink.classList.add('active');

                        // New: Bring active nav link into view on mobile
                        if (window.matchMedia("(max-width: 767px)").matches) {
                            navLink.scrollIntoView({
                                behavior: "smooth",
                                inline: "center",
                                block: "nearest"
                            });
                        }
                    }
                });
            };

            const observer = new IntersectionObserver(handleIntersection, options);
            boxes.forEach(box => observer.observe(box));

            isInitialized = true;
        }

        initialize();

        $(window).resize(function () {
            if (!isInitialized) {
                initialize();
            }
        });
    });
</script>
