<script>
    $(document).ready(function () {
        // Initialize accordion state
        let isDesktop = window.innerWidth > 1024;

        // Helper functions
        function showTempText($el) {
            $el.removeClass('hide-temp');
        }

        function hideTempText($el) {
            $el.addClass('hide-temp');
        }

        // Initialize accordion based on screen size
        function initializeAccordion() {
            // Ensure all accordions are closed by default
            $(".faqunique").removeClass("active").find(".classRomFaqAns").hide();

            if (isDesktop) {
                // Desktop mode: hide extra content, show tempText
                $(".inclassDataParent .extra-content").hide();
                $(".viewMoreButton").html('View More <img src="https://images.mastersunion.link/uploads/26022025/v1/Vector.svg" alt="Icon">');
                $(".tempText").each(function () { showTempText($(this)); });
            } else {
                // Mobile mode: show extra content, hide tempText
                $(".inclassDataParent .extra-content").show();
                $(".viewMoreButton").html('View Less <img src="https://images.mastersunion.link/uploads/28022025/v1/Vector1.svg">');
                $(".tempText").each(function () { hideTempText($(this)); });
            }
        }

        // Initialize on page load
        initializeAccordion();

        // Accordion click handler - using more specific selector and preventing conflicts
        $(".faqunique .left").off("click.accordion").off("click").on("click.accordion", function (e) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            let parent = $(this).closest(".faqunique");
            let content = parent.find(".classRomFaqAns");

            if (parent.hasClass("active")) {
                // Close this accordion
                parent.removeClass("active");
                content.slideUp();
                if (isDesktop) {
                    parent.find(".tempText").each(function () { showTempText($(this)); });
                }
            } else {
                // Close other accordions and open this one
                $(".faqunique").not(parent).each(function () {
                    $(this).removeClass("active").find(".classRomFaqAns").slideUp();
                    if (isDesktop) {
                        $(this).find(".tempText").each(function () { showTempText($(this)); });
                    }
                });

                parent.addClass("active");
                content.slideDown({
                    complete: function () {
                        $('html, body').animate({ scrollTop: parent.offset().top - 230 }, 400);
                    }
                });

                if (isDesktop) {
                    parent.find(".tempText").each(function () { hideTempText($(this)); });
                }
            }

            // Prevent any other handlers from running
            return false;
        });

        // View More/Less button handler
        $(".viewMoreButton").off("click.viewMore").on("click.viewMore", function (e) {
            e.preventDefault();
            e.stopPropagation();

            let extraContent = $(this).prev(".inclassDataParent").find(".extra-content");
            let parentAccordion = $(this).closest(".faqunique");

            if (extraContent.is(":visible")) {
                // Hide extra content
                extraContent.slideUp();
                $(this).html('View More <img src="https://images.mastersunion.link/uploads/26022025/v1/Vector.svg" alt="Icon">');

                // Scroll to top of accordion when hiding content
                $('html, body').animate({ scrollTop: parentAccordion.offset().top - 230 }, 400);

                if (!isDesktop) {
                    // On mobile, also show tempText when hiding extra content
                    parentAccordion.find(".tempText").each(function () {
                        $(this).removeClass('hide-temp');
                    });
                }
            } else {
                // Show extra content
                extraContent.slideDown();
                $(this).html('View Less <img src="https://images.mastersunion.link/uploads/28022025/v1/Vector1.svg">');

                if (!isDesktop) {
                    // On mobile, hide tempText when showing extra content
                    parentAccordion.find(".tempText").each(function () {
                        $(this).addClass('hide-temp');
                    });
                }
            }
        });

        // Handle window resize
        $(window).off("resize.accordion").on("resize.accordion", function () {
            let newIsDesktop = window.innerWidth > 1024;
            if (newIsDesktop !== isDesktop) {
                isDesktop = newIsDesktop;
                initializeAccordion();
            }
        });

        // Tab switching functionality
        $(".faqtabs li").off("click.tabs").on("click.tabs", function () {
            let targetId = $(this).data("rel");
            let parentContent = $(this).closest(".content-section");

            // Remove active class from all tabs and content
            $(this).siblings().removeClass("active");
            parentContent.find(".content").removeClass("active");

            // Add active class to clicked tab and target content
            $(this).addClass("active");
            parentContent.find("#" + targetId).addClass("active");
        });
    });

    // Lottie player initialization
    document.addEventListener("DOMContentLoaded", function () {
        let elements = document.getElementsByTagName('lottie-player');
        for (let i = 0; i < elements.length; i++) {
            elements[i].addEventListener('play', (event) => {
                event.target.shadowRoot.querySelector('svg').style.transform = '';
            });
            elements[i].play();
        }
    });

    // Disable conflicting accordion scripts from layout files
    $(document).ready(function () {
        // Remove any conflicting click handlers from layout scripts
        $(".faqunique .left").off("click");
        $(".classRomFaqWrap.faqunique .left").off("click");

        // Ensure all accordions are closed by default
        $(".faqunique").removeClass("active").find(".classRomFaqAns").hide();

        // Ensure our accordion script takes precedence
        setTimeout(function () {
            $(".faqunique .left").off("click").on("click.accordion", function (e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();

                let parent = $(this).closest(".faqunique");
                let content = parent.find(".classRomFaqAns");

                if (parent.hasClass("active")) {
                    parent.removeClass("active");
                    content.slideUp();
                    if (window.innerWidth > 1024) {
                        parent.find(".tempText").each(function () {
                            $(this).removeClass('hide-temp');
                        });
                    }
                } else {
                    $(".faqunique").not(parent).each(function () {
                        $(this).removeClass("active").find(".classRomFaqAns").slideUp();
                        if (window.innerWidth > 1024) {
                            $(this).find(".tempText").each(function () {
                                $(this).removeClass('hide-temp');
                            });
                        }
                    });

                    parent.addClass("active");
                    content.slideDown({
                        complete: function () {
                            $('html, body').animate({ scrollTop: parent.offset().top - 230 }, 400);
                        }
                    });

                    if (window.innerWidth > 1024) {
                        parent.find(".tempText").each(function () {
                            $(this).addClass('hide-temp');
                        });
                    }
                }

                return false;
            });
        }, 100);
    });
</script>