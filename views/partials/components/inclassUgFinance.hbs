<script>
    // Desktop accordion functionality
    function runDesktopAccordionScript() {
        // Remove any previous handlers
        $(".classRomFaqWrap .left").off("click.desktopAccordion");
        $(".classRomFaqWrap .left").off("click.mobileAccordion");

        // Helper to show tempText
        function showTempText($el) {
            $el.removeClass('hide-temp');
        }
        function hideTempText($el) {
            $el.addClass('hide-temp');
        }

        // Desktop: close all accordions, hide extra content, show tempText
        $(".classRomFaqWrap").removeClass("active").find(".classRomFaqAns").hide();
        $(".inclassDataParent .extra-content").hide();
        $(".viewMoreButton").html('View More <img src="https://images.mastersunion.link/uploads/26022025/v1/Vector.svg" alt="Icon">');
        $(".tempText").each(function () { showTempText($(this)); });

        // Open the first accordion by default
        var $firstAcc = $(".classRomFaqWrap").first();
        $firstAcc.addClass("active").find(".classRomFaqAns").show();
        $firstAcc.find(".tempText").each(function () { hideTempText($(this)); });

        // Desktop accordion click
        $(".classRomFaqWrap .left").on("click.desktopAccordion", function () {
            if (window.innerWidth <= 1024) return;
            let parent = $(this).closest(".classRomFaqWrap");
            let content = parent.find(".classRomFaqAns");
            if (parent.hasClass("active")) {
                // Keep one accordion open at all times: clicking the open one does nothing
                return;
            } else {
                $(".classRomFaqWrap").each(function () {
                    $(this).removeClass("active").find(".classRomFaqAns").slideUp();
                    $(this).find(".tempText").each(function () { showTempText($(this)); });
                });
                parent.addClass("active");
                content.slideDown({
                    complete: function () {
                        $('html, body').animate({ scrollTop: parent.offset().top - 230 }, 400);
                    }
                });
                parent.find(".tempText").each(function () { hideTempText($(this)); });
            }
        });
    }

    // Mobile accordion functionality
    function runMobileAccordionScript() {
