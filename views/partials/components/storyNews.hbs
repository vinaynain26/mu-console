<script>
    document.addEventListener("DOMContentLoaded", () => {
        var slider = document.getElementById("sliderStory");
        let scrollAmount = 0;
        let animationFrame = null;

        function checkAndStartAutoScroll() {
            // Only auto-scroll on desktop (width > 800px)
            if (window.innerWidth > 800) {
                // Only initialize if not already initialized
                if (!slider.dataset.initialized) {
                    // Hide scrollbar but keep functionality
                    slider.style.msOverflowStyle = 'none'; // IE and Edge
                    slider.style.scrollbarWidth = 'none'; // Firefox
                    slider.style.overflow = 'scroll';
                    slider.style.overflow = '-webkit-scrollbar'; // Chrome and Safari (not standard)

                    // Clone the contents once to allow seamless scroll
                    slider.innerHTML += slider.innerHTML;
                    slider.dataset.initialized = 'true';
                }

                function autoScroll() {
                    if (window.innerWidth <= 800) {
                        // Stop scrolling if window is resized to mobile
                        cancelAnimationFrame(animationFrame);
                        animationFrame = null;
                        return;
                    }

                    scrollAmount += 0.80; // Adjust scroll speed here
                    slider.scrollLeft = scrollAmount;

                    // Reset scroll when it reaches half (original content width)
                    if (scrollAmount >= slider.scrollWidth / 2) {
                        scrollAmount = 0;
                    }

                    animationFrame = requestAnimationFrame(autoScroll);
                }

                // Start scrolling only if not already running
                if (!animationFrame) {
                    autoScroll();
                }

                // Pause on hover
                slider.addEventListener('mouseenter', () => {
                    if (animationFrame) {
                        cancelAnimationFrame(animationFrame);
                        animationFrame = null;
                    }
                });

                // Resume on mouse leave
                slider.addEventListener('mouseleave', () => {
                    if (window.innerWidth > 800 && !animationFrame) {
                        autoScroll();
                    }
                });
            } else {
                // Stop auto-scroll if on mobile
                if (animationFrame) {
                    cancelAnimationFrame(animationFrame);
                    animationFrame = null;
                }
            }
        }

        // Initial check
        checkAndStartAutoScroll();

        // Handle window resize
        window.addEventListener('resize', () => {
            if (window.innerWidth <= 800 && animationFrame) {
                // Stop scrolling on mobile
                cancelAnimationFrame(animationFrame);
                animationFrame = null;
            } else if (window.innerWidth > 800 && !animationFrame) {
                // Restart scrolling on desktop
                checkAndStartAutoScroll();
            }
        });
    });
</script>