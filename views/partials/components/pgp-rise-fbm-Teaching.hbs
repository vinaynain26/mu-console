    $(document).ready(function () {
    let isInitialized = false;
    let observer = null;

    function isMobile() {
        return window.matchMedia("(max-width: 767px)").matches;
    }

    function getScrollOffset() {
        if (window.matchMedia("(max-width: 1023px)").matches) {
            return 225;
        } else if (window.matchMedia("(min-width: 1440px)").matches) {
            return 320;
        } else {
            return 210;
        }
    }

    function scrollToElement(id) {
        let targetElement = $(`#${id}`);
        if (targetElement.length) {
            let scrollOffset = getScrollOffset();
            $('html, body').animate({
                scrollTop: targetElement.offset().top - scrollOffset
            }, 1000);
        }
    }

    function initialize() {
        if (isInitialized) return;

        $(".navigationBox .courseName").off('click').on('click', function () {
            let id = $(this).attr('data-rel');
            $(this).addClass('active').siblings().removeClass('active');
            $(`#${id}`).addClass('active').siblings().removeClass('active');
            scrollToElement(id);
        });

        const boxes = document.querySelectorAll('.box');
        const options = {
            root: null,
            rootMargin: '0px',
            threshold: 1
        };

        const handleIntersection = (entries) => {
            entries.forEach(entry => {
                const boxId = entry.target.id;
                const navLink = document.querySelector(`[data-rel="${boxId}"]`);

                if (entry.isIntersecting) {
                    if (navLink) {
                        document.querySelectorAll("#nav .courseName").forEach(sib => {
                            if (sib !== navLink) {
                                sib.classList.remove("active");
                            }
                        });
                        navLink.classList.add('active');
                    }
                } else {
                    if (navLink) {
                        navLink.classList.remove('active');
                    }
                }
            });
        };

        // Create new IntersectionObserver if not exists
        if (!observer) {
            observer = new IntersectionObserver(handleIntersection, options);
        }
        boxes.forEach(box => {
            observer.observe(box);
        });

        isInitialized = true;
    }

    function cleanup() {
        if (observer) {
            observer.disconnect();
            observer = null;
        }
        $(".navigationBox .courseName").off('click');
        isInitialized = false;
    }

    function handleResize() {
        cleanup();
        initialize();
    }

    $(window).on('resize', handleResize);

    // Initialize on page load based on initial screen size
    initialize();
});



