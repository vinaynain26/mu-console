        function esc(s) {
            return String(s == null ? "" : s).replace(/[&<>"]/g, c => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"
            }[c]));
        }

        function cardHTML(m) {
            return `
                <div class="cmtMasterCard">
                    <div class="cmtMasterCard__avatar">
                        <img class="cmtMasterCard__photo" src="${esc(m.photo)}" alt="${esc(m.name)}"
                             width="235" height="200" loading="lazy" decoding="async">
                    </div>
                    <div class="cmtMasterCard__body">
                        <div class="cmtMasterCard__identity">
                            <h3 class="cmtMasterCard__name">${esc(m.name)}</h3>
                            <p class="cmtMasterCard__title">${esc(m.title)}</p>
                        </div>
                        <div class="cmtMasterCard__logo">
                            <img src="${esc(m.logo)}" alt="" aria-hidden="true" loading="lazy" decoding="async">
                        </div>
                    </div>
                    <span class="cmtMasterCard__shine" aria-hidden="true"></span>
                </div>`;
        }

        var slider = document.getElementById("slider");
        var mob = document.getElementById("cmtMastersMob");
        var markup = cmtMasters.map(cardHTML).join("");

        if (slider) slider.innerHTML = markup;
        if (mob) mob.innerHTML = markup;

        if (!slider) return;

        // Hide scrollbar but keep functionality
        slider.style.msOverflowStyle = 'none'; // IE and Edge
        slider.style.scrollbarWidth = 'none'; // Firefox
        slider.style.overflow = '-moz-scrollbars-none'; // Firefox
        slider.style.overflow = 'scroll';
        slider.style.overflow = '-webkit-scrollbar'; // Chrome and Safari

        // Clone the contents once to allow seamless scroll
        slider.innerHTML += slider.innerHTML;

        let scrollAmount = 0;
        let animationFrame;

        function autoScroll() {
            scrollAmount += 0.80; // Adjust scroll speed here
            slider.scrollLeft = scrollAmount;

            // Reset scroll when it reaches half (original content width)
            if (scrollAmount >= slider.scrollWidth / 2) {
                scrollAmount = 0;
            }

            animationFrame = requestAnimationFrame(autoScroll);
        }

        // Start scrolling
        autoScroll();

        // Pause on hover
        slider.addEventListener('mouseenter', () => {
            cancelAnimationFrame(animationFrame);
        });

        // Resume on mouse leave
        slider.addEventListener('mouseleave', () => {
            autoScroll();
        });
    });
</script>
