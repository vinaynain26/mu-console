<style>
    /* ── CMT master card (scoped: cmtMaster*) ─────────────────────────────
       Dimensions come from the 3-line Figma variant so 2-line cards keep the
       same height and the logos line up across the rail. */
    .cmtMasterCard {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex: 0 0 auto;
        width: 235px;
        overflow: hidden;
        border: 1px solid #404040;
        border-radius: 8px;
        background: #090909;
        box-sizing: border-box;
    }

    .cmtMasterCard__avatar {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        flex-shrink: 0;
        background: linear-gradient(70.91deg, #0b0b0b 11.24%, #303030 93.06%);
    }

    .cmtMasterCard__photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        pointer-events: none;
    }

    .cmtMasterCard__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        width: 100%;
        padding: 16px 8px;
        border-top: 1px solid #404040;
        box-sizing: border-box;
    }

    .cmtMasterCard__identity {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        width: 100%;
    }

    .cmtMasterCard__name {
        margin: 0;
        font-family: var(--go-regular);
        font-size: 16px;
        font-weight: 400;
        line-height: 1.2;
        color: #ffffff;
    }

    .cmtMasterCard__title {
        margin: 0;
        font-family: var(--go-regular);
        font-size: 12px;
        font-weight: 400;
        line-height: 1.5;
        color: #d4d4d4;
        /* 12px * 1.5 * 3 lines - reserved so shorter cards match the tallest */
        min-height: 54px;
    }

    .cmtMasterCard__logo {
        position: relative;
        width: 200px;
        height: 35px;
        overflow: hidden;
        flex-shrink: 0;
        mix-blend-mode: luminosity;
    }

    .cmtMasterCard__logo img {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 138px;
        height: 35px;
        object-fit: contain;
        object-position: left bottom;
        pointer-events: none;
    }

    /* diagonal gloss across the top-left corner, clipped by the card */
    .cmtMasterCard__shine::before,
    .cmtMasterCard__shine::after {
        content: "";
        position: absolute;
        height: 505.76px;
        background: rgba(255, 255, 255, 0.3);
        transform: translate(-50%, -50%) rotate(43deg);
        pointer-events: none;
    }

    .cmtMasterCard__shine::before {
        left: -45.83px;
        top: -6.82px;
        width: 23px;
    }

    .cmtMasterCard__shine::after {
        left: -3.86px;
        top: -12.17px;
        width: 7.331px;
    }
</style>

<div class="mastersScroll mob-hide">
    <div class="marqueesliders" id="slider"></div>
</div>

<div class="mob-visible dsaiMastersMobile">
