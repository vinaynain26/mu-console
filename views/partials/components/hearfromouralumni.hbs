<script>
    var swiper = new Swiper(".souravS", {
        effect: "coverflow",
        centeredSlides: true,
        slidesPerView: "auto",
        coverflowEffect: {
            rotate: 0,
            stretch: 0,
            depth: 100,
            modifier: 3,
            slideShadows: true,
        },
        keyboard: {
            enabled: true,
        },
        spaceBetween: 100,
        loop: true,
        pagination: {
            el: ".mobile-pagination", // Init only one
            clickable: true,

        },
        navigation: {
            nextEl: ".souravS-Next",
            prevEl: ".souravS-Prev",
        },
        breakpoints: {
            320: { slidesPerView: 1.2, spaceBetween: 80 },
            480: { slidesPerView: 1.2, spaceBetween: 80 },
            768: { slidesPerView: 1.2, spaceBetween: 80 },
            1024: { slidesPerView: 2.5, spaceBetween: 70 },
            1280: { slidesPerView: 2, spaceBetween: 250 },
            1920: { slidesPerView: 1.8, spaceBetween: 320 },
        },
    });

    // 🔁 Clone bullets from mobile to desktop after init
    swiper.on('paginationRender', () => {
        const mobilePag = document.querySelector('.mobile-pagination');
        const desktopPag = document.querySelector('.desktop-pagination');

        if (mobilePag && desktopPag) {
            desktopPag.innerHTML = mobilePag.innerHTML;

            // Re-bind click events on desktop bullets
            const mobileBullets = mobilePag.querySelectorAll('span');
            const desktopBullets = desktopPag.querySelectorAll('span');
            desktopBullets.forEach((bullet, index) => {
                bullet.addEventListener('click', () => {
                    swiper.slideToLoop(index);
                });
            });
        }
    });

    swiper.emit('paginationRender'); // Force initial copy

</script>