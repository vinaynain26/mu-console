<script>
    $(document).ready(function () {
        $('.faqquestionWrap .faqanswer').not(':first').slideUp();
        $('.faqquestionWrap').off('click').on('click', function (event) {
            event.stopPropagation(); // Prevent event from propagating up the DOM tree
            let id = $(this).attr('data-rel');
            $(this).toggleClass('active').siblings().removeClass('active');
            $('#' + id).slideToggle().parent().siblings().find('.faqanswer').slideUp();
        });

  

    setTimeout (function(){
        if(isCountryCodeFound){ 
         $("#pgp-rise-tab1 div.faqquestionWrap").not('.hideFortheMENA.hide').first().addClass('active').siblings().removeClass('active');
        let activeId = $("#pgp-rise-tab1 div.faqquestionWrap").not('.hideFortheMENA.hide').first().attr('data-rel');
          $(`#${activeId}`).addClass('active').siblings().removeClass('active');
         $('#' + activeId).slideToggle().parent().siblings().find('.faqanswer').slideUp();
        }
    },2000)
    });
  
    $(".faqtabs li").click(function () {
        let id = $(this).attr('data-rel')
        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');
    });
</script>