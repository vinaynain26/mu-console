                        <script>
                            const tabs = document.querySelectorAll(".mobTab");
                            const tabContents = document.querySelectorAll(".tabContent");
                            const tabContainer = document.getElementById("tabContainer");

                            tabs.forEach((tab, index) => {
                                tab.addEventListener("click", () => {
                                    // Remove 'active' from all tabs
                                    tabs.forEach(t => {
                                        t.classList.remove("active");
                                        const span = t.querySelector(".mobTabSem");
                                        if (span) span.classList.remove("");
                                    });

                                    // Add 'active' to clicked tab and apply gradient to its span
                                    tab.classList.add("active");
                                    const activeSpan = tab.querySelector(".mobTabSem");
                                    if (activeSpan) activeSpan.classList.add("");

                                    // Center tab into view
                                    const tabWidth = tab.offsetWidth;
                                    const tabLeft = tab.offsetLeft;
                                    const containerWidth = tabContainer.offsetWidth;
                                    const scrollTo = tabLeft - (containerWidth / 2) + (tabWidth / 2);

                                    tabContainer.scrollTo({
                                        left: scrollTo,
                                        behavior: "smooth"
                                    });

                                    // Toggle content visibility
                                    tabContents.forEach(c => c.classList.remove("active"));
                                    if (tabContents[index]) tabContents[index].classList.add("active");
                                });
                            });




                        </script>

                    </div>

                    <script>
                        const semTabs = document.querySelectorAll('.tab');
                        const contentSections = document.querySelectorAll('.semester-content');
                        let isTabClicked = false; // Flag to track if a tab has been clicked

                        // Click event for semTabs
                        semTabs.forEach(tab => {
                            tab.addEventListener('click', () => {
                                isTabClicked = true; // Set flag when a tab is clicked
                                const sectionId = tab.getAttribute('data-tab');
                                const targetSection = document.querySelector(`.semester-content[data-section="${sectionId}"]`);

                                // Remove active class and textGradient from all tabs
                                semTabs.forEach(t => {
                                    t.classList.remove('active');
                                    const tagName = t.querySelector('.tagName');
                                    if (tagName) tagName.classList.remove('textGradient');
                                });

                                // Add active class and textGradient to clicked tab
                                tab.classList.add('active');
                                const tagName = tab.querySelector('.tagName');
                                if (tagName) tagName.classList.add('textGradient');

                                // Calculate the offset position
                                const offset = 140; // Adjust this value to your desired offset (e.g., height of sticky header or padding)
                                const sectionPosition = targetSection.getBoundingClientRect().top + window.scrollY;
                                const offsetPosition = sectionPosition - offset;

                                // Scroll to the section with offset
                                window.scrollTo({
                                    top: offsetPosition,
                                    behavior: 'smooth'
                                });

                                // Reset flag after scrolling is done (use setTimeout to delay)
                                setTimeout(() => {
                                    isTabClicked = false;
                                }, 500); // Adjust timeout to match the scroll animation time
                            });
                        });

                        // Scroll event to update active tab based on window scroll position
                        window.addEventListener('scroll', () => {
                            if (isTabClicked) return; // If a tab is clicked, don't run the scroll event logic

                            let currentSection = '1';

                            contentSections.forEach(section => {
                                const sectionTop = section.getBoundingClientRect().top;
                                // Check if the section is within the top 200px of the viewport
                                if (sectionTop <= 200 && sectionTop > -section.offsetHeight) {
                                    currentSection = section.getAttribute('data-section');
                                }
                            });

                            // Update active tab and textGradient
                            semTabs.forEach(tab => {
                                const tagName = tab.querySelector('.tagName');
                                tab.classList.remove('active');
                                if (tagName) tagName.classList.remove('textGradient');
                                if (tab.getAttribute('data-tab') === currentSection) {
                                    tab.classList.add('active');
                                    if (tagName) tagName.classList.add('textGradient');
                                }
                            });
                        });
                    </script>


            </section>