    function desktopCard(master) {
        return `
        <div class="newMasterBoxImg">
            <div class="newMasterImgBox">
                <img src="${master.imgUrl}" alt="${master.name}">
            </div>

            <div class="newMasterDetailsWrap">
                <h3>${master.name}</h3>
                <h4>${master.designation}</h4>
                <img class="tbmMasterLogo" src="${master.logoUrl}" alt="${master.name} logo">
            </div>
        </div>`;
    }


    function mobileCard(master) {
        return `
        <div class="newMasterBoxImg">
            <div class="newMasterImgBox">
                <img src="${master.imgUrl}" alt="${master.name}">
            </div>

            <div class="newMasterDetailsWrap">
                <h3>${master.name}</h3>
                <h4>${master.designation}</h4>
                <img class="tbmMasterLogo" src="${master.logoUrl}" alt="${master.name} logo">
            </div>
        </div>`;
    }


    document.querySelectorAll(".sustainMasters").forEach(component => {

        const desktopSlider = component.querySelector(".sliderTbm");
        const mobileSlider = component.querySelector(".sliderMobile");


        if(desktopSlider){
            desktopSlider.innerHTML = masters.map(desktopCard).join("");
        }


        if(mobileSlider){
            mobileSlider.innerHTML = masters.map(mobileCard).join("");
        }

    });



    document.querySelectorAll(".marqueesliders").forEach(slider => {


        slider.style.msOverflowStyle = 'none';
        slider.style.scrollbarWidth = 'none';
        slider.style.overflow = 'scroll';


        slider.innerHTML += slider.innerHTML;


        let scrollAmount = 0;
        let animationFrame;


        function autoScroll(){

            scrollAmount += 0.8;
            slider.scrollLeft = scrollAmount;


            if(scrollAmount >= slider.scrollWidth / 2){
                scrollAmount = 0;
            }


            animationFrame = requestAnimationFrame(autoScroll);
        }


        autoScroll();


        slider.addEventListener("mouseenter",()=>{
            cancelAnimationFrame(animationFrame);
        });


        slider.addEventListener("mouseleave",()=>{
            autoScroll();
        });


    });


})();
