<script>
    document.addEventListener("DOMContentLoaded", () => {
        const sliders = document.getElementsByClassName("marqueesliders");

        Array.from(sliders).forEach(slider => {
            // Hide scrollbar while keeping scroll functionality
            slider.style.msOverflowStyle = 'none'; // IE and Edge
            slider.style.scrollbarWidth = 'none'; // Firefox
            slider.style.overflow = 'scroll'; // General scroll behavior

            // Clone contents to make seamless scroll
            slider.innerHTML += slider.innerHTML;

            let scrollAmount = 0;
            let animationFrame;

            function autoScroll() {
                scrollAmount += 0.8; // Adjust speed here
                slider.scrollLeft = scrollAmount;

                // Reset scroll when halfway (original content)
                if (scrollAmount >= slider.scrollWidth / 2) {
                    scrollAmount = 0;
                }

                animationFrame = requestAnimationFrame(autoScroll);
            }

            // Start auto scroll
            autoScroll();

            // Pause on hover
            slider.addEventListener('mouseenter', () => {
                cancelAnimationFrame(animationFrame);
            });

            // Resume on mouse leave
            slider.addEventListener('mouseleave', () => {
                autoScroll();
            });
        });
    });
</script>