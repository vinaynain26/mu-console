<script>
    document.addEventListener("DOMContentLoaded", () => {
        const bottomNav = document.querySelector(".bottomNav");
        if (!bottomNav) return;

        const hiddenPaths = ['/ai-summit', '/ai-summit-form', '/ai-summit-award-form'];
        if (hiddenPaths.includes(window.location.pathname)) {
            bottomNav.style.display = 'none';
            return;
        }

        const crossBar = bottomNav.querySelector(".crossBar");
        const logosFoot = bottomNav.querySelectorAll(".logosFoot:not(.crossBar)");
        let autoCloseTimeout = null;

        // Add index to each logo for staggered animation
        logosFoot.forEach((logo, index) => {
            logo.style.setProperty('--animation-delay', `${index * 0.05}s`);
        });

        const expandNav = () => {
            bottomNav.classList.add("is-expanded");
            logosFoot.forEach((logo, index) => {
                logo.style.transitionDelay = `${(index + 1) * 0.05}s`;
            });
        };

        const collapseNav = () => {
            // Clear any pending auto-close timeout
            if (autoCloseTimeout) {
                clearTimeout(autoCloseTimeout);
                autoCloseTimeout = null;
            }
            bottomNav.classList.remove("is-expanded");
            logosFoot.forEach((logo) => {
                logo.style.transitionDelay = '0s';
            });
        };

        // Check if device is mobile and expand by default
        const isMobile = () => {
            return window.innerWidth <= 768 || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        };

        // Check if current path should not expand by default
        const shouldNotExpandByDefault = () => {
            const pathname = window.location.pathname;
            return pathname === '/sharktank' || pathname === '/sharktank2';
        };

        // Expand on mobile by default (except on sharktank pages)
        if (isMobile() && !shouldNotExpandByDefault()) {
            expandNav();
            // Auto-close after 4 seconds on mobile only
            autoCloseTimeout = setTimeout(() => {
                if (bottomNav.classList.contains("is-expanded")) {
                    collapseNav();
                }
            }, 4000);
        }

        bottomNav.addEventListener("click", (event) => {
            const target = event.target;
            const clickedElement = target.closest('button, a');
            
            // If clicked on a button or anchor tag (except crossBar)
            if (clickedElement && clickedElement !== crossBar) {
                if (bottomNav.classList.contains("is-expanded")) {
                    collapseNav();
                }
                return;
            }
            
            // If clicked on bottomNav itself (not on button/a), expand it
            if (!bottomNav.classList.contains("is-expanded")) {
                expandNav();
            }
        });

        crossBar?.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
            collapseNav();
        });

        // Close when clicking outside the bottomNav when it's expanded
        document.addEventListener("click", (event) => {
            if (bottomNav.classList.contains("is-expanded")) {
                if (!bottomNav.contains(event.target)) {
                    collapseNav();
                }
            }
        });
    });
</script>


