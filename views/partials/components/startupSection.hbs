                                    fill="white" />
                            </svg>

                            <svg class="arrow arrowClone" width="22" height="23" viewBox="0 0 22 23" fill="none"
                                xmlns="https://www.w3.org/2000/svg">
                                <path
                                    d="M5.91691 5.56611L18.5625 18.1676L17.6719 19.0625L5.02633 6.46104L5.91691 5.56611Z"
                                    fill="white" />
                                <path
                                    d="M4.77534 16.3021C7.37528 12.9931 7.57722 8.26954 5.15397 4.82159C5.20445 4.77107 4.35884 5.66779 4.37146 5.65516C7.76654 8.02957 12.4994 7.81486 15.7557 5.21311L14.6072 3.9375C12.247 6.67818 7.89275 6.75395 5.04038 4.69529C5.053 4.69529 4.19477 5.56675 4.25787 5.52886C6.68112 8.1685 6.40346 12.9047 3.4375 14.9886L4.78796 16.3147L4.77534 16.3021Z"
