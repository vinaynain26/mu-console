<style>
    .transitionMaster.hidden {
        display: none;
    }

    .loadWrapper {
        transition: opacity 0.3s ease, transform 0.3s ease;
        position: relative;
        margin-top: 52px !important;
        min-height: 52px;
        margin-bottom: 32px;

        .btnBlack {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
    }

    .btnBlack.loadBtn svg {
        display: inline-block;
        transition: transform 0.3s ease;
        /* smooth effect */
    }

    .btnBlack.loadBtn:hover svg {
        transform: translateY(3px);
        /* halki si niche */
    }

    .btnBlack.viewLessBtn svg {
        display: inline-block;
        transition: transform 0.3s ease;
        /* smooth effect */
    }

    .btnBlack.viewLessBtn:hover svg {
        transform: translateY(-3px);
        /* halki si niche */
    }

    .loadWrapper.fade-out {
        opacity: 0;
        transform: translateY(-10px);
    }

    .loadWrapper.fade-in {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 767px) {
        .transitionMaster {
            display: block !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const items = document.querySelectorAll(".transitionMaster");
        const loadBtn = document.querySelector(".loadBtn");
        const viewLessBtn = document.querySelector(".viewLessBtn");
        const loadWrapper = document.querySelector(".loadWrapper");
        const viewLessWrapper = document.querySelector(".viewLessWrapper");
        const bootcampWrapper = document.querySelector('.bootcampMastersWrapper');
        const loopMasterSection = document.querySelector('.loopMaster'); // parent section

        const showCount = 10; // initially visible cards

        // Initially hide cards beyond showCount
        items.forEach((item, index) => {
            if (index >= showCount) item.classList.add("hidden");
        });

        // Load More button
        loadBtn.addEventListener("click", function () {
            loadWrapper.classList.add("fade-out");
            loadWrapper.style.display = "none";

            // Show all cards
            items.forEach((item) => item.classList.remove("hidden"));

            // Show View Less button
            viewLessWrapper.style.display = "block";
            viewLessWrapper.classList.add("fade-in");
        });

        // View Less button
        viewLessBtn.addEventListener("click", function () {
            viewLessWrapper.classList.add("fade-out");
            viewLessWrapper.style.display = "none";

            if (bootcampWrapper && loopMasterSection) {
                // Animate wrapper sliding inside section
                bootcampWrapper.style.transition = "transform 0.6s ease";
                const wrapperTopRelative = bootcampWrapper.offsetTop - loopMasterSection.offsetTop;
                bootcampWrapper.style.transform = `translateY(-${wrapperTopRelative}px)`;

                // Hide extra cards immediately after transform
                items.forEach((item, index) => {
                    if (index >= showCount) item.classList.add("hidden");
                });

                // Reset transform so layout stays natural
                setTimeout(() => {
                    bootcampWrapper.style.transition = "none";
                    bootcampWrapper.style.transform = "none";
                }, 600);

                // Scroll section slightly below top (20px gap)
                const sectionTop = loopMasterSection.getBoundingClientRect().top + window.scrollY;
                window.scrollTo({
                    top: sectionTop + 100, // 20px gap
                    behavior: "smooth"
                });
            }

            // Show Load More button immediately
            loadWrapper.style.display = "block";
            loadWrapper.classList.remove("fade-out");
            loadWrapper.classList.add("fade-in");
        });
    });
</script>


