<script>
  document.querySelectorAll('.swipero').forEach((el) => {
    new Swiper(el, {
        spaceBetween: 32,
        speed: 3000,
        direction: 'horizontal',
        autoplay: { delay: 0 },
        loop: true,
        slidesPerView: 1.5,
        freeMode: true,
        breakpoints: {
            640: { slidesPerView: 2 },
            768: { slidesPerView: 3 },
            1024: { slidesPerView: 4 },
        }
    });
});
   
</script>