  .mobNavBtn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
  }



  .mobNavBtn:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .mobNavBtn:active {
    transform: scale(0.94);
  }

  .mobNavBtn:disabled {
    opacity: 0.3;
    cursor: default;
    transform: none;
  }

  .mobPrevBtn img {
    transform: rotate(180deg);
  }

  /* SLIDES VIEWPORT (peek effect) */
  .mobSlideViewport {
    overflow: visible;
    width: 100%;
  }

  .mobSlidesTrack {
    display: flex;
    gap: 16px;
    transition: transform 0.5s cubic-bezier(0.77, 0, 0.18, 1);
    will-change: transform;
  }

  /* BASE SLIDE STYLES — each slide can override inner layout freely */
  .mobSlide {
    flex-shrink: 0;
    width: calc(100% - 48px);
    /* 48px peek from next slide */
    border-radius: 20px;
    border: 1px solid #2c2c2c;
    background: #121212;
    padding: 16px 8px;
    box-sizing: border-box;
    transition: border 0.2s;
    max-height: 640px;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }



  /* ========== NEW PAGINATION: 3 VISIBLE DOTS + SMOOTH SCROLL ========== */
  .mobPaginationWrapper {
    margin-top: 24px;
    display: flex;
    justify-content: center;
  }

  /* Fixed window — only 3 dots wide visible */
  .mobDotsViewport {

    overflow: hidden;
    padding: 10px 0;
    /* ✅ room for pulse glow */

  }

  .mobDotsTrack {
    display: flex;
    gap: 32px;
    align-items: flex-end;
    transition: transform 0.45s cubic-bezier(0.77, 0, 0.18, 1);
    will-change: transform;
  }

  .mobDotItemNew {
    flex-shrink: 0;
    width: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    cursor: pointer;
    transition: opacity 0.3s;
    opacity: 0.4;
  }

  .mobDotItemNew.active,
  .mobDotItemNew.past {
    opacity: 1;
  }

  .mobDotItemNew .dot-label {
    font-size: 12px;
    font-weight: 400;
    font-family: var(--go-regular);
    color: #A3A3A3;

    text-align: center;
    line-height: 120%;
    transition: color 0.3s, font-weight 0.3s;
  }

  .mobDotItemNew.active .dot-label {
    color: #FFF;
    font-weight: 600;
    font-size: 14px;
  }

  .mobDotItemNew .dot-circle {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #7f7f7f;
    transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
    flex-shrink: 0;
    z-index: 10;

  }

  .mobDotItemNew.past .dot-circle {
    background: #e8722a;
    opacity: 1;
  }

  .mobDotItemNew.active .dot-circle {
    background: #e8722a;
    transform: scale(1.5);
    animation: mobDotPulse 1.8s ease-out infinite;
  }

  @keyframes mobDotPulse {
    0% {
      box-shadow: 0 0 0 0px rgba(232, 114, 42, 0.5);
    }

    60% {
      box-shadow: 0 0 0 6px rgba(232, 114, 42, 0);
    }

    100% {
      box-shadow: 0 0 0 0px rgba(232, 114, 42, 0);
    }
  }

  .mobDotsTrack {
    display: flex;
    gap: 50px;
    align-items: flex-end;
    transition: transform 0.45s cubic-bezier(0.77, 0, 0.18, 1);
    will-change: transform;
    position: relative;
  }

  /* Line behind dots */
  /* Full grey line — spans all dots */
  .mobDotsTrack::before {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 40px;
    width: calc(100% - 80px);
    /* ✅ full span from first to last dot center */
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    z-index: 0;
  }

  /* Orange progress — pixel based, not % */
  .mobDotsTrack::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 40px;
    height: 2px;
    background: #e8722a;
    width: var(--dots-progress, 0px);
    /* ✅ px value, not % */
    transition: width 0.45s cubic-bezier(0.77, 0, 0.18, 1);
    z-index: 0;
  }

  .mobDotItemNew .dot-circle {
    position: relative;
    z-index: 10;
    /* ✅ dots sit above the line */
  }

  .mobDotsTrack::before,
  .mobDotsTrack::after {
    z-index: -1;
    /* ✅ forces lines behind all dot circles */
  }

  .labelContainers {
    position: absolute;
    bottom: 10px;
    right: 10px;

    font-family: "Fraunces 72pt";
    font-size: 12px;
    line-height: 150%;
    font-weight: 400;
    border-radius: 50px;
    padding: 2px 10px;
    color: var(--white);

  }

  .orange {
    background-color: #E38330;
  }

  .green {
    background-color: #1C7C54;
  }

  .yellow {
    background-color: #F1BA3E;
    color: var(--black);
  }

  .blue {
    background-color: #39B6D8;
  }

  .cityLastMob img {
    height: 100%;
    width: 100%;
  }

  .mobSlide img {
    width: 100%;

  }

  .cityNameAndLogoMob img {
    width: 22px;
    height: 22px;
  }
</style>

<script>
  (function () {
    const section = document.getElementById('customJourneySection');
    if (!section) return;

    const slidesTrack = document.getElementById('staticSlidesTrack');
    const slides = Array.from(slidesTrack.querySelectorAll('.mobSlide'));
    const totalSlides = slides.length;
    if (totalSlides === 0) return;

    // ── City names ──
    const cityNames = slides.map(slide => {
      const heading = slide.querySelector('.cityNameMob');
      return heading ? heading.innerText.trim() : 'City';
    });

    // ── DOM refs ──
    const prevBtn = section.querySelector('.mobPrevBtn');
    const nextBtn = section.querySelector('.mobNextBtn');
    const dotsRowContainer = document.getElementById('dynamicDotsRow');
    const viewport = section.querySelector('.mobSlideViewport');

    // ── State ──
    let currentIndex = 0;
    let dotElements = [];
    let touchStartX = 0;
    let touchStartY = 0;
    let isSwiping = false;

    // ── Constants ──
    const DOT_WIDTH = 80;
    const DOT_GAP = 50;
    const DOT_STEP = DOT_WIDTH + DOT_GAP; // 92px per dot
    const VISIBLE = 3;
    const PEEK = 48; // matches width: calc(100% - 48px) on .mobSlide

    // ── Build dots once ──
    function buildDots() {
      dotsRowContainer.innerHTML = '';
      dotElements = [];

      cityNames.forEach((city, idx) => {
        const item = document.createElement('div');
        item.className = 'mobDotItemNew';
        item.innerHTML = `
                    <span class="dot-label">${city}</span>
                    <div class="dot-circle"></div>
                `;
        item.addEventListener('click', () => goToSlide(idx));
        dotsRowContainer.appendChild(item);
        dotElements.push(item);
      });

      // ✅ Explicit width so ::before/::after resolve 100% against full track
      const trackWidth = (totalSlides * DOT_STEP) - DOT_GAP;
      dotsRowContainer.style.width = trackWidth + 'px';
    }

    function updateDotsTransform() {
      let offset;

      if (currentIndex === totalSlides - 1) {
        // ✅ Real DOM widths — flush to right edge, no gap
        const trackWidth = dotsRowContainer.offsetWidth;
        const viewportWidth = dotsRowContainer.parentElement.offsetWidth;
        offset = -(trackWidth - viewportWidth);
      } else if (currentIndex === 0) {
        offset = 0;
      } else {
        let firstVisible = currentIndex - 1;
        firstVisible = Math.max(0, firstVisible);
        firstVisible = Math.min(totalSlides - VISIBLE, firstVisible);
        offset = -(firstVisible * DOT_STEP);
      }

      dotsRowContainer.style.transform = `translateX(${offset}px)`;

      const filledPx = currentIndex * DOT_STEP;
      dotsRowContainer.style.setProperty('--dots-progress', filledPx + 'px');
    }

    // ── Update dot active/past classes + nav buttons ──
    function updateDotsActiveState() {
      dotElements.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === currentIndex);
        dot.classList.toggle('past', idx < currentIndex);
      });

      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex === totalSlides - 1;

      updateDotsTransform();
    }

    // ── Move slides track ──
    function updateCarouselTransform() {
      const activeSlide = slides[currentIndex];
      if (!activeSlide || !slidesTrack) return;

      const isFirst = currentIndex === 0;
      const isLast = currentIndex === totalSlides - 1;

      if (isLast) {
        // Last slide — pull back so previous card peeks from left
        slidesTrack.style.transform = `translateX(-${activeSlide.offsetLeft - PEEK}px)`;
      } else if (isFirst) {
        // First slide — no offset, next card peeks from right naturally
        slidesTrack.style.transform = `translateX(0px)`;
      } else {
        // Middle slides — standard offset
        slidesTrack.style.transform = `translateX(-${activeSlide.offsetLeft}px)`;
      }
    }

    // ── Go to slide ──
    function goToSlide(newIndex) {
      if (newIndex < 0) newIndex = 0;
      if (newIndex >= totalSlides) newIndex = totalSlides - 1;
      if (newIndex === currentIndex) return;
      currentIndex = newIndex;
      updateCarouselTransform();
      updateDotsActiveState();
    }

    // ── Prev / Next buttons ──
    if (prevBtn) prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));

    // ── Touch swipe — horizontal only, no page scroll interference ──
    [viewport, slidesTrack].forEach(el => {
      if (!el) return;

      el.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
        isSwiping = false;
      }, { passive: true });

      el.addEventListener('touchmove', (e) => {
        const diffX = Math.abs(touchStartX - e.changedTouches[0].clientX);
        const diffY = Math.abs(touchStartY - e.changedTouches[0].clientY);

        // Only register as swipe if horizontal movement dominates
        if (!isSwiping && diffX > diffY && diffX > 8) {
          isSwiping = true;
        }
      }, { passive: true });

      el.addEventListener('touchend', (e) => {
        if (!isSwiping) return; // ignore vertical scrolls
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 60) {
          goToSlide(currentIndex + (diff > 0 ? 1 : -1));
        }
        isSwiping = false;
      }, { passive: true });
    });

    // ── Recalculate on resize ──
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateCarouselTransform();
        updateDotsTransform();
      }, 100);
    });

    // ── Wait for images before setting initial transform ──
    const images = slidesTrack.querySelectorAll('img');
    let loadedCount = 0;
    function onImageLoad() {
      loadedCount++;
      if (loadedCount === images.length) updateCarouselTransform();
    }
    images.forEach(img => {
      if (img.complete) onImageLoad();
      else img.addEventListener('load', onImageLoad);
    });

    // ── ResizeObserver for dynamic layout shifts ──
    const ro = new ResizeObserver(() => {
      updateCarouselTransform();
      updateDotsTransform();
    });
    ro.observe(slidesTrack);

    // ── Init ──
    buildDots();
    updateCarouselTransform();
    updateDotsActiveState();

  })();
</script>


