<!-- JAVASCRIPT — Swiper Functionality -->
<!-- ============================================================ -->
<script>
  (function () {

    // ── CONFIG: Add / update city labels to match your 10 slides ──
    const cityLabels = [
      'Delhi',
      'Jalandhar',
      'Mundra &\nAhmedabad',
      'Mumbai',
      'Goa',
      'Bengaluru',
      'Darjeeling',
      'Lucknow',
    ];

    // ── STATE ──
    let current = 0;
    const total = cityLabels.length;

    // ── DOM REFS ──
    const track = document.querySelector('.slidesTrack');
    const prevBtn = document.querySelector('.prevBtn');
    const nextBtn = document.querySelector('.nextBtn');
    const dotsWrap = document.querySelector('.timelineDots');
    const progressEl = document.querySelector('.timelineProgress');

    // ── BUILD TIMELINE DOTS ──
    cityLabels.forEach((label, i) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'dotWrapper' + (i === 0 ? ' active' : '');
      wrapper.innerHTML = `<div class="dot"></div><span class="dotLabel">${label.replace('\n', '<br>')}</span>`;
      wrapper.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(wrapper);
    });
    //RENDER
    function render() {
      // Move slides
      track.style.transform = `translateX(-${current * 100}%)`;

      // Update dots
      dotsWrap.querySelectorAll('.dotWrapper').forEach((el, i) => {
        el.classList.toggle('active', i === current);
        el.classList.toggle('past', i < current);
      });

      // ✅ Fill progress only up to active dot center
      const pct = total <= 1 ? 0 : (current / (total - 1)) * 100;
      progressEl.style.width = pct + '%';

      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;
    }

    // ── NAVIGATION ──
    function goTo(index) {
      current = Math.max(0, Math.min(total - 1, index));
      render();
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    // ── KEYBOARD ──
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });

    // ── TOUCH / SWIPE ──
    let startX = 0;
    let isDragging = false;

    track.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
      isDragging = false;
    }, { passive: true });

    // ── INIT ──
    render();

  })();
</script>




