<script>
    let currentFilter = "all";

    const MASTER_FILTER = {
        "all": {
            currentPage: 1,
            hasMoreMasters: true,
            firstPageLoaded: false

        },
        "VisitingFaculty": {
            currentPage: 1,
            hasMoreMasters: true,
            firstPageLoaded: false
        },
        "Practitioner": {
            currentPage: 1,
            hasMoreMasters: true,
            firstPageLoaded: false
        },
        "Resident": {
            currentPage: 1,
            hasMoreMasters: true,
            firstPageLoaded: false
        }
    }




    $(document).ready(function () {
        loadAndBindFilteredMasters(MASTER_FILTER.all.currentPage);
    });

    async function loadAndBindFilteredMasters(page, type = 'all') {
        console.log("Type Received,", type);
        const CDNBaseURL = "https://cdn.mastersunion.org/assets/img/newmu";
        const imageExtension = "-M.webp"
        const res = await fetch(`{{apiBaseURL}}/api/getMastersNewTheme?limit=10&page=${page}${type !== 'all' ? `&type=${type}` : ''}`);
        if (!res.ok) return;
        const MasterUGdata = await res.json();
        const mastersArray = MasterUGdata?.masters || [];
        MASTER_FILTER[type].hasMoreMasters = MasterUGdata.pageInfo.hasMoreMasters;



        const masterDataHTML = MasterUGdata?.masters?.map((item, index) => {
            const masterName = `${item.title ? item.title.trim() : ""} ${item.firstName ? item.firstName.trim() : ""} ${item.lastName ? item.lastName.trim() : ""}`;
            return `
            <div class="masterBox">
                <div class="masterImage">
                    <img   src=${index % 2 === 0 ? item.masterPhotoLight : item.masterPhotoDark}  alt="${masterName}">
                </div>
                <span class="masterName">${masterName}</span>
                <span class="masterDesignation">${item.designation}</span><br/>
                <span class="masterDesignation">${item.companyName}</span>
                <hr class="lineSpace">
                <span class="masterExperience">${item?.teaching || ""} </span>
            </div>`;
        }).join('');

        console.log(`#${type}Masters`);
        const el = document.querySelector(`#${type}Masters`);
        if (el) {
            el.innerHTML += masterDataHTML;
        }

        MASTER_FILTER[type].currentPage = page;
        MASTER_FILTER[type].hasMoreMasters = MasterUGdata.pageInfo.hasMoreMasters;
        MASTER_FILTER[type].firstPageLoaded = true;

        if (MASTER_FILTER[type].hasMoreMasters) {
            document.querySelector("#loadMoreMastersBtnDiv")?.classList?.remove("hide");
        } else {
            document.querySelector("#loadMoreMastersBtnDiv")?.classList?.add("hide");
        }

    }


    function loadMoreFilteredMasters() {
        loadAndBindFilteredMasters(MASTER_FILTER[currentFilter].currentPage + 1, currentFilter);
    }

    document.querySelectorAll("#masterTabsUl li").forEach(function (element) {
        element.addEventListener("click", function () {
            let id = this.getAttribute('data-rel');
            this.classList.add('active');
            let siblings = Array.from(this.parentNode.children).filter(function (child) {
                return child !== this;
            }, this);
            siblings.forEach(function (sibling) {
                sibling.classList.remove('active');
            });
            currentFilter = id.split("-")[1];

            if (currentFilter === "Resident") {
                document.querySelector("#loadMoreMastersBtnDiv")?.classList?.add("hide");
                return;
            }
            if (!MASTER_FILTER[currentFilter].firstPageLoaded) {
                loadAndBindFilteredMasters(MASTER_FILTER[currentFilter].currentPage, currentFilter);
            }

            if (MASTER_FILTER[currentFilter].hasMoreMasters) {
                document.querySelector("#loadMoreMastersBtnDiv")?.classList?.remove("hide");
            } else {
                document.querySelector("#loadMoreMastersBtnDiv")?.classList?.add("hide");
            }
        });
    });
</script>