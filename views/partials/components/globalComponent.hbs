    {{!-- lazy loading script --}}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.globalCard').forEach(card => {
                const playButton = card.querySelector('.masterPlay');
                const video = card.querySelector('.cardVideo');
                const source = video.querySelector('source');

                // Store actual src in data-src and remove src for lazy loading
                if (source && source.src) {
                    source.setAttribute('data-src', source.src);
                    source.removeAttribute('src');
                }

                // Optional: preload only metadata
                video.preload = 'metadata';

                // On play button click, set src and play
                playButton.addEventListener('click', () => {
                    if (source && !video.src) {
                        source.src = source.getAttribute('data-src');
                        video.load(); // Start loading video
                    }

                    // Small timeout to ensure load() starts
                    setTimeout(() => {
                        video.play().catch(err => console.warn('Video play failed:', err));
                    }, 50);
                });
            });
        });
    </script>
    {{!--
    lazy loading script ends --}}


    <script>
        var swiper = new Swiper(".globalTbmSwiper", {
            initialSlide: 2,
            centeredSlides: true,
            slidesPerView: 1.5,

            navigation: {
                nextEl: ".globalTbmSwiper-Next",
                prevEl: ".globalTbmSwiper-Prev",
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },

            effect: "coverflow",
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 100,
                modifier: 1,
                slideShadows: false,
                scale: 0.9,
            },

            breakpoints: {
                0: {
                    slidesPerView: 1.4,
                    loop: true   // ✅ mobile par loop on
                },
                768: {
                    slidesPerView: 1.4,
                    loop: false  // ✅ tablet par loop off
                },
                1024: {
                    slidesPerView: 2,
                    loop: false
                },
                1366: {
                    slidesPerView: 2,
                    loop: false
                },
                1600: {
                    slidesPerView: 2,
                    loop: false
                },
            },

            on: {
                init: function () {
                    this.el.swiper = this;
                },
                slideChange: function () {
                    if (typeof pauseAllVideos === 'function') {
                        pauseAllVideos();
                    }
                }
            }
        });
    </script>

    <style>
