  // Function to parse deadline date from text format like "Deadline 23rd June '25" or "Round 4: 16th July '25"
  function parseDeadlineDate(deadlineText) {
    // Match "Round 4: 16th July '25", "Round 3 : 20th July '25", "Deadline 23rd March '25", etc.
    const dateMatch = deadlineText.match(
      /(?:Round\s*\d+[:]?|Deadline)?\s*(\d{1,2})(?:st|nd|rd|th)?\s+(January|February|March|April|May|June|July|August|September|October|November|December)\s*(?:,)?\s*(?:'|'’)?(\d{2}|\d{4})/i,
    );
    if (dateMatch) {
      const day = parseInt(dateMatch[1]);
      const month = dateMatch[2];
      let year = parseInt(dateMatch[3]);
      if (year < 100) year += 2000;
      const monthNames = [
        "january",
        "february",
        "march",
        "april",
        "may",
        "june",
        "july",
        "august",
        "september",
        "october",
        "november",
        "december",
      ];
      const monthIndex = monthNames.indexOf(month.toLowerCase());
      if (monthIndex !== -1) {
        // Use end-of-day so the deadline day itself stays "Open".
        // Card should only flip to "Application Closed" after the deadline day ends.
        return new Date(year, monthIndex, day, 23, 59, 59, 999);
      }
    }
    return null;
  }

  // Function to check if deadline has passed
  function isDeadlinePassed(deadlineText) {
    // Don't change "Closing soon" or "Application Closed" texts
    if (
      deadlineText.includes("Closing soon") ||
      deadlineText === "Application Closed"
    ) {
      return false;
    }

    const deadlineDate = parseDeadlineDate(deadlineText);
    if (deadlineDate) {
      const now = new Date();
      return deadlineDate < now;
    }

    return false;
  }

  // Function to get display deadline text
  function getDisplayDeadline(program) {
    if (isDeadlinePassed(program.deadline)) {
      return "Application Closed";
    }
    return program.deadline;
