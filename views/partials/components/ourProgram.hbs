  // Smooth tab switching based on scroll position with improved UX
  function updateActiveTab() {
    // Always remove 'active' from all tab buttons before setting the new one
    const tabButtons = document.querySelectorAll(".programFilters .filter-btn");
    tabButtons.forEach((btn) => btn.classList.remove("active"));

    const container = document.querySelector(".mobile-programs-container");
    if (!container) return;

    // Skip if programmatic scroll is happening
    if (container.getAttribute("data-programmatic-scroll") === "true") {
      return;
    }

    const containerRect = container.getBoundingClientRect();
    const containerCenter = containerRect.left + containerRect.width / 2;

    // Get all program cards
    const cards = container.querySelectorAll(".ProgrammeCardMob");
    let activeCategory = "ug";
    let minDistance = Infinity;

    cards.forEach((card) => {
      const cardRect = card.getBoundingClientRect();
      const cardCenter = cardRect.left + cardRect.width / 2;
      const distance = Math.abs(cardCenter - containerCenter);
      const category = card.getAttribute("data-category");

      if (distance < minDistance && distance < 250) {
        minDistance = distance;
        activeCategory = category;
      }
    });

    // Now set only the correct one as active
    tabButtons.forEach((btn) => {
      if (btn.getAttribute("data-filter") === activeCategory) {
        btn.classList.add("active");
        btn.style.transform = "scale(1.02)";
        // Scroll the active tab into view horizontally
        scrollActiveTabIntoView();
        setTimeout(() => {
          btn.style.transform = "scale(1)";
        }, 250);
      } else {
        btn.style.transform = "scale(1)";
      }
    });
  }

  // Smooth scroll to section when tab is clicked with improved UX
  function scrollToSection(category) {
    const container = document.querySelector(".mobile-programs-container");

    if (!container) return;

    // Find the first card of the selected category
    const allCards = container.querySelectorAll(".ProgrammeCardMob");
    let targetCard = null;

    for (let card of allCards) {
      if (card.getAttribute("data-category") === category) {
        targetCard = card;
        break; // Get the first card of this category
      }
    }

    if (targetCard) {
      // Completely disable scroll-based tab updates during programmatic scroll
      container.setAttribute("data-programmatic-scroll", "true");

      // Scroll to the exact position of the first card of the category
      const scrollLeft = targetCard.offsetLeft - container.offsetLeft;

      container.scrollTo({
        left: Math.max(0, scrollLeft),
        behavior: "smooth",
      });

      // Re-enable scroll-based tab updates after scroll completes
      setTimeout(() => {
        container.removeAttribute("data-programmatic-scroll");
      }, 1500); // Longer duration to ensure scroll is complete
    }
  }

  // Function to scroll active tab into view (horizontally only)
  function scrollActiveTabIntoView() {
    const activeTab = document.querySelector(
      ".programFilters .filter-btn.active",
    );
    const tabContainer = document.querySelector(".programFilters");

    if (activeTab && tabContainer) {
      const tabLeft = activeTab.offsetLeft;
      const tabWidth = activeTab.offsetWidth;
      const containerWidth = tabContainer.offsetWidth;
      const scrollLeft = tabContainer.scrollLeft;

      // Calculate if tab is out of view
      const tabRight = tabLeft + tabWidth;
      const visibleLeft = scrollLeft;
      const visibleRight = scrollLeft + containerWidth;

      // Scroll horizontally to center the active tab
      if (tabLeft < visibleLeft || tabRight > visibleRight) {
        const scrollTo = tabLeft - containerWidth / 2 + tabWidth / 2;
        tabContainer.scrollTo({
          left: Math.max(0, scrollTo),
          behavior: "smooth",
        });
      }
    }
  }

  // Initialize mobile filters with optimized scroll functionality
  function initializeMobileFilters() {
    const mobileFilters = document.querySelectorAll(
      ".programFilters .filter-btn",
    );
    const container = document.querySelector(".mobile-programs-container");

    // Tab click handler with improved UX
    mobileFilters.forEach((filter) => {
      filter.addEventListener("click", function () {
        const filterValue = this.getAttribute("data-filter");
        const container = document.querySelector(".mobile-programs-container");

        // Prevent multiple rapid clicks
        if (this.classList.contains("clicking")) {
          return;
        }

        this.classList.add("clicking");

        // Remove 'active' from all tabs before setting the new one
        mobileFilters.forEach((btn) => {
          btn.classList.remove("active");
        });

        this.classList.add("active");

        // Scroll the active tab into view horizontally
        scrollActiveTabIntoView();

        setTimeout(() => {
          this.style.transform = "scale(1)";
          this.classList.remove("clicking");
        }, 300);

        // Set programmatic scroll flag
        if (container) {
          container.setAttribute("data-programmatic-scroll", "true");
        }

        // Scroll to section immediately
        scrollToSection(filterValue);

        // After scroll completes, remove flag and update active tab
        setTimeout(() => {
          if (container) {
            container.removeAttribute("data-programmatic-scroll");
            updateActiveTab();
          }
        }, 1500); // Match the scroll duration in scrollToSection
      });
    });

    // Smooth scroll handler with improved throttling and debouncing
    if (container) {
      let ticking = false;
      let scrollTimeout;
      let lastScrollLeft = 0;
      let isUserScrolling = false;

      container.addEventListener("scroll", function () {
        // Skip if this is a programmatic scroll
        if (container.getAttribute("data-programmatic-scroll") === "true") {
          return;
        }
        updateActiveTab();
      });
    }
  }

  // Initialize everything
  function initializeEverything() {
    renderAllPrograms();

    // Initialize scroll functionality after content is rendered
    setTimeout(() => {
      initializeMobileFilters();
      updateActiveTab(); // Set initial active tab
      scrollActiveTabIntoView(); // Scroll active tab into view horizontally on load
    }, 100);
  }

  // Initialize when DOM is ready
  document.addEventListener("DOMContentLoaded", function () {
    initializeEverything();
  });

  // Handle window resize with debouncing
  let resizeTimeout;
  window.addEventListener("resize", function () {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      updateActiveTab();
    }, 250);
  });
</script>

