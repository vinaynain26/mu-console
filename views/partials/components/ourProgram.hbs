  // Render desktop content
  function renderDesktopContent() {
    // Render UG programs
    const ugWrapper = document.querySelector("#ugTab1 .swiper-wrapper");
    if (ugWrapper) {
      ugWrapper.innerHTML = programsData.undergraduate
        .map((program) => createDesktopCard(program))
        .join("");
    }

    // Render PGP programs
    const pgpWrapper = document.querySelector("#ugTab2 .swiper-wrapper");
    if (pgpWrapper) {
      pgpWrapper.innerHTML = programsData.postgraduate
        .map((program) => createDesktopCard(program))
        .join("");
    }

    // Render Executive programs
    const executiveWrapper = document.querySelector("#ugTab3 .swiper-wrapper");
    if (executiveWrapper) {
      executiveWrapper.innerHTML = programsData.executive
        .map((program) => createDesktopCard(program))
        .join("");
    }
    // Render Certificate programs
    const certificateWrapper = document.querySelector(
      "#ugTab4 .swiper-wrapper",
    );
    if (certificateWrapper) {
      certificateWrapper.innerHTML = programsData.certificate
        .map((program) => createDesktopCard(program))
        .join("");
    }
    // Render Short Term programs
    const shortTermWrapper = document.querySelector("#ugTab5 .swiper-wrapper");
    if (shortTermWrapper) {
      shortTermWrapper.innerHTML = programsData.shortTerm
        .map((program) => createDesktopCard(program))
        .join("");
    }
    // Render Immersions programs
    const immersionsWrapper = document.querySelector("#ugTab6 .swiper-wrapper");
    if (immersionsWrapper) {
      immersionsWrapper.innerHTML = programsData.immersions
        .map((program) => createDesktopCard(program))
        .join("");
    }
  }

  // Create desktop program card HTML
  function createDesktopCard(program) {
    return `
            <div class="programmeRightContent swiper-slide">
                <div class="programmePara">
                    <h2 class="go-BlockHeading">${program.title.includes(" in ")
        ? program.title.split(" in ")[0] +
        ' in <span class="font-medium">' +
        program.title.split(" in ")[1] +
        "</span>"
        : program.title.includes(": ")
          ? program.title.split(": ")[0] +
          ': <span class="font-medium">' +
          program.title.split(": ")[1] +
          "</span>"
          : program.title
      }</h2>
                    <p class="programmeCardPara">${program.description}</p>
                </div>

                <div class="programImageParent">
                    <img  src="${program.image}" alt="${program.title}">
                    ${program.videoId
        ? `
                    <div class="masterPlay" onclick="openPopup('${program.videoId}');">
                        <img  src="https://files.mastersunion.link/resources/svg/homePlayIcon.svg" alt="icon">
                    </div>
                    `
        : ""
      }
                </div>

                <div class="campusDiviParent">
                    <div class="programFlexi">
                        <img class="campusImage" src="https://images.mastersunion.link/uploads/23062025/v2/GreyColorIcon.svg" alt="icon">
                        <div class="campusBoxContent">
                            <p class="campusHeading">${program.format}</p>
                            <p class="campusPara">${program.formatDetails}</p>
                        </div>
                    </div>

                    <div class="programFlexi">
                        <img class="campusImage" src="https://images.mastersunion.link/uploads/23062025/v3/GreyColorIcon.svg" alt="icon">
                        <div class="campusBoxContent">
                            <p class="campusHeading">${program.eligibility.includes("Work") ? "Eligibility" : "Eligibility"}</p>
                            <p class="campusPara">${program.eligibilityDetails || program.eligibility}</p>
                        </div>
                    </div>

                    <div class="programFlexi">
                        <img class="campusImage" src="https://images.mastersunion.link/uploads/23062025/v4/GreyColorIcon.svg"alt="icon">
                        <div class="campusBoxContent">
                            <p class="campusHeading">${program.duration}</p>
                            <p class="campusPara">${program.durationDetails}</p>
                        </div>
                    </div>

                    <div class="programFlexi">
                        <img class="campusImage" src="https://images.mastersunion.link/uploads/23062025/v5/GreyColorIcon.svg" alt="icon">
                        <div class="campusBoxContent">
                            <p class="campusHeading">
                                ${["pg-in-ui-ux-and-product-design", "pgp-sustainability-and-business-management"].includes(program.id) ? "Admission Status" : "Deadline"}
                            </p>
                            <p class="campusPara">
                                ${["pg-in-ui-ux-and-product-design", "pgp-sustainability-and-business-management"].includes(program.id) ? "Applications Open" : getDisplayDeadline(program)}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="deadlineParent">
                    <a href="${program.link}" class="btnBlack borderGradient hoverWhiteEffect">
                        Explore Programme
                        <span class="arrowWrap">
                            <svg class="arrow arrow1" xmlns="https://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                                <path d="M16.0831 5.06611L3.4375 17.6676L4.32808 18.5625L16.9737 5.96104L16.0831 5.06611Z" fill="white"></path>
                                <path d="M17.2247 15.8021C14.6247 12.4931 14.4228 7.76954 16.846 4.32159C16.7955 4.27107 17.6412 5.16779 17.6285 5.15516C14.2335 7.52957 9.50055 7.31486 6.24431 4.71311L7.39283 3.4375C9.75297 6.17818 14.1073 6.25395 16.9596 4.19529C16.947 4.19529 17.8052 5.06675 17.7421 5.02886C15.3189 7.6685 15.5965 12.4047 18.5625 14.4886L17.212 15.8147L17.2247 15.8021Z" fill="white"></path>
                            </svg>
                            <svg class="arrow arrow2" xmlns="https://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                                <path d="M16.0831 5.06611L3.4375 17.6676L4.32808 18.5625L16.9737 5.96104L16.0831 5.06611Z" fill="white"></path>
                                <path d="M17.2247 15.8021C14.6247 12.4931 14.4228 7.76954 16.846 4.32159C16.7955 4.27107 17.6412 5.16779 17.6285 5.15516C14.2335 7.52957 9.50055 7.31486 6.24431 4.71311L7.39283 3.4375C9.75297 6.17818 14.1073 6.25395 16.9596 4.19529C16.947 4.19529 17.8052 5.06675 17.7421 5.02886C15.3189 7.6685 15.5965 12.4047 18.5625 14.4886L17.212 15.8147L17.2247 15.8021Z" fill="white"></path>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        `;
  }
</script>

