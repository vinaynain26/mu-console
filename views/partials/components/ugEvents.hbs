<script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>



<section class="eventsMU new homeEvents  ">
    <div class="container">
        <h2 class="sectionHeading font-white mb30">Upcoming Events</h2>
    </div>
    <div class="container">
        <div class="swiper eventSlider events">
            <div class="swiper-wrapper" id="latestEvents">

            </div>
        </div>
    </div>
</section>


<script>
    //events
    getLatestEvents();
    function getLatestEvents() {
        $.ajax({
            url: '{{apiBaseURL}}/api/getLatestEvents',
        }).done(function (response) {
            if (response.IsSuccess == true) {
                bindLatestEvents(response.Data);
            }
        });
    }
    function convertTime12to24(time12h) {
        var [time, modifier] = time12h.split(' ');

        var [hours, minutes] = time.split(':');

        if (hours === '12') {
            hours = '00';
        }

        if (modifier === 'PM') {
            hours = parseInt(hours, 10) + 12;
        }

        return `${hours}:${minutes}`;
    }
    function bindLatestEvents(events) {
        events.forEach(event => {
            if (event.eventCourseType === "UG") {
                var time = convertTime12to24(event.fromTime);
                if (event.isBigEvent) {
                    time = "11:59";
                }
                console.log(event, 'event')
                var eventHtml = `<div class="swiper-slide eventSlide">
                    <div class="eventImg">
                        <img   src="${event.carouselImage}" alt="">
                    </div>
                    <div class="eventData">
                        <div class="eventHeading">${event.title}</div>
                        <div class="eventText">Registrations open
                        </div>
                        <div class="eventTag">Apply by: ${event.isBigEvent && event.fromDate != event.eventDate ? moment(event.fromDate).format('Do MMM YYYY') + " - " + moment(event.eventDate).format('Do MMM YYYY') :
                        moment(event.eventDate).format('Do MMM YYYY') + ", " + event.fromTime}</div>
                        <hr class="lineBreaker">
                        <a class="registerLink " target="_blank" href="/events/${event.slug}">
                            Register Now
                            <svg width="25" height="24" viewBox="0 0 25 24" fill="none"
                                xmlns="https://www.w3.org/2000/svg">
                                <path
                                    d="M8.58984 16.59L13.1698 12L8.58984 7.41L9.99984 6L15.9998 12L9.99984 18L8.58984 16.59Z"
                                    fill="url(#paint0_linear_2_24161)" />
                                <defs>
                                    <linearGradient id="paint0_linear_2_24161" x1="12.2948" y1="6" x2="12.2948" y2="18"
                                        gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#39B6D8" />
                                        <stop offset="0.5" stop-color="#F7D344" />
                                        <stop offset="1" stop-color="#E38330" />
                                    </linearGradient>
                                </defs>
                            </svg>
                        </a>
                    </div>
                </div>`
            }
            //var eventHtml = ` <div class="experienceBox swiper-slide">
            //        <img   src=${event.carouselImage} alt="carousal">
            //        <div class="experienceDetails">
            //            <h4 class="heading-6">${event.title}</h4>
            //            <div class="expericeDateDetails mt-10">
            //                <span class="ytag">${event.isBigEvent && event.fromDate != event.eventDate ? moment(event.fromDate).format('Do MMM YYYY') + " - " + moment(event.eventDate).format('Do MMM YYYY') :
            //        moment(event.eventDate).format('Do MMM YYYY') + ", " + event.fromTime}</span>
            //                <span class="ytag">${event.eventLocation}</span>
            //            </div>
            //            <p class="text-3 mt-10 mtopBtnHome">${event.description}</p>
            //            <div class="heroButtonGroup mt-25">
            //                 ${event.isRegistrationOpen === false || !moment(event.eventDate.split('T')[0] + "T" + time + ":00").isAfter() ? `<button class="exploreBtnRed disabledButton">Registration Closed</button>` :
            //        `<a target="_blank" href="/events/${event.slug}" class="exploreBtnRed">Register Now</a>`}   
            //            </div>
            //        </div>
            //    </div>`

            $('#latestEvents').append(eventHtml)

        })
