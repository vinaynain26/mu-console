<script>
    $(".urbanCampus .tab-menu li a").on("click", function () {
        var target = $(this).attr("data-rel");
        console.log("target: ", target);
        $(this).parent("li").siblings().find("a").removeClass("active");
        console.log($(this));
        // $('.tab-teaser .tab-menu li a').removeClass('active');
        $(this).addClass("active");
        $("#" + target)
            .fadeIn("slow")
            .siblings(".tab-box")
            .hide();
        return false;
    });


    document.addEventListener("DOMContentLoaded", () => {
        console.log("SettingTimeout");
        setTimeout(lazyLoadIFrames, 3000);
    });

    function lazyLoadIFrames() {
        const iframes = document.querySelectorAll("#iframe_embedded");
        iframes.forEach(lazyFrame => {
            console.log("binding");
            lazyFrame.setAttribute('src', lazyFrame.getAttribute('data-src'));
            lazyFrame.classList.remove('lazyload');
        });
    }  
</script>