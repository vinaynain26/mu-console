<script>
    $(document).ready(function () {
        let isVisible = false;

        $('.exploreBtn').click(function (e) {
            e.stopPropagation();

            if (!isVisible) {
                $('.cityWrapper').css({
                    display: 'block',
                    opacity: 0
                }).animate({
                    opacity: 1
                }, 300);
                isVisible = true;
            } else {
                $('.cityWrapper').animate({
                    opacity: 0
                }, 300, function () {
                    $(this).css('display', 'none');
                });
                isVisible = false;
            }
        });

        $(document).click(function () {
            if (isVisible) {
                $('.cityWrapper').animate({
                    opacity: 0
                }, 300, function () {
                    $(this).css('display', 'none');
                    isVisible = false;
                });
            }
        });

        $('.cityWrapper').click(function (e) {
            e.stopPropagation();
        });

        $('.exploreBtn').on('click', function () {
            $(this).find('.dropdownIcon').toggleClass('rotated');
        });

        $(".toCohortBox").click(function () {
            scrollTab($(this))
            let id = $(this).attr('data-rel')
            $('#classprofile-menu').addClass('active').siblings().removeClass('active');
            $(`#${id}`).addClass('active').siblings().removeClass('active');
        });
    });
</script>

