                        ];


        const container = document.getElementById("cityContainer");
        const searchInput = document.getElementById('citySearch');

        function renderStates(searchValue) {
            container.innerHTML = ''; 
            const filteredStates = states.filter(state => state.toLowerCase().includes(searchValue.toLowerCase()));
            
            if(filteredStates.length === 0){
                const noState = document.createElement("p");
                noState.textContent = "No State Found"
                noState.className = "stateDivi";
                container.appendChild(noState)
            }
            else{
                filteredStates.forEach(state => {
                    const stateDiv = document.createElement("div");
                    stateDiv.className = "stateDivi";
                    stateDiv.textContent = state;
                    stateDiv.onclick = () => handleStateClick(state);
                    container.appendChild(stateDiv);
                });
            }
        }

        searchInput.addEventListener('input', function() {
            const searchValue = searchInput.value;
            renderStates(searchValue);
        });

       function handleStateClick(currState) {
  let displayState = currState;

  if (displayState === "Haryana (excluding Gurugram & Faridabad)") displayState = "Haryana";
  if (displayState === "Uttar Pradesh (excluding Noida & Ghaziabad)") displayState = "Uttar Pradesh";

  if (displayState === "All") {
    state = "";
  } else {
    state = encodeURIComponent(displayState);
  }

