                                            ${student?.resume_url ? `<a href=${student?.resume_url} target="_blank"><img   src="https://files.mastersunion.link/resources/img/cohortcv.png" alt="cv_icon"></a>` : ''}
                                    
                                        </div>
                                    </div>
                                    <hr class="lineSpace">
                                    <div>
                                    <p class="cohortCompany">${school}, ${student.grade12_city}</p>
                                    <p>${student.display_about}</p>
                                    </div>
                                </div>
                            `;
                            const el = document.createElement("div");
                            el.classList.add("box2col")
                            el.classList.add("gap15")
                            el.innerHTML = html;
                            divEl.appendChild(el);
                              loadMoreBtn2029.innerHTML = `View All  <img
                            src="https://images.mastersunion.link/uploads/28022025/v1/Frame13213165113.svg">`
                        });
                    }

                    loadMoreBtn2029.dataset.page = page;
                    isDataFetching2029 = false;
                    if (!res.Data.hasMoreProfiles) {
                        loadMoreBtn2029.classList.add("hide");
                    }
                }).catch(err => {
                    isDataFetching2029 = false;
                });

        }

        $("#loadMoreProfile2029").on("click", function () { 
            hasClickedLoadMore2029 = true;
            showCohortProfile2029(+this.dataset.page + 1);
            loadMoreBtn2029.classList.add("hide");
        });


        window.addEventListener('scroll', function () {
            const scrollTop = window.scrollY;
            const scrollHeight = document.documentElement.scrollHeight;
            const clientHeight = document.documentElement.clientHeight;
            const scrollPercentage = (scrollTop / (scrollHeight - clientHeight)) * 100;

            if (scrollPercentage >= 30 && hasClickedLoadMore && CURRENT_COHORT === "class2027" && !isDataFetching) {
                showCohortProfile(+loadMoreBtn.dataset.page + 1);
            } else if (scrollPercentage >= 30 && hasClickedLoadMore2028 && CURRENT_COHORT === "class2028" && !isDataFetching2028) {
                showCohortProfile2028(+loadMoreBtn2028.dataset.page + 1);
            }else if (scrollPercentage >= 30 && hasClickedLoadMore2029 && CURRENT_COHORT === "class2029" && !isDataFetching2029) {
                showCohortProfile2029(+loadMoreBtn2029.dataset.page + 1);
            }
        });
        // Remove automatic click to prevent hiding dropdown options
        // btn2027.click();
        
        // Load initial data for 2027 cohort
       const activeTab = document.querySelector('.cohordLi.active');

if (activeTab) {
  CURRENT_COHORT = activeTab.dataset.rel;

  if (CURRENT_COHORT === 'class2027') showCohortProfile(1);
  if (CURRENT_COHORT === 'class2028') showCohortProfile2028(1);
  if (CURRENT_COHORT === 'class2029') showCohortProfile2029(1);
}

   })
</script>


