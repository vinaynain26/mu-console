  // Function to parse deadline date from text
  function parseDeadlineDate(deadlineText) {
    // Extract date from deadline text like "Round 2 Deadline: 30th June, 2025" or "R4 Deadline:  16th July '25"
    const dateMatch = deadlineText.match(
      /(\d{1,2})(?:st|nd|rd|th)?\s+(January|February|March|April|May|June|July|August|September|October|November|December),?\s+(?:'|'?)(\d{2}|\d{4})?/i,
    );
    if (dateMatch) {
      const day = parseInt(dateMatch[1]);
      const month = dateMatch[2];
      const yearStr = dateMatch[3];
      let year = yearStr ? parseInt(yearStr) : new Date().getFullYear();
      // If year is two digits, convert to 20xx
      if (yearStr && year < 100) {
        year += 2000;
      }

      // Convert month name to number (0-11)
      const monthNames = [
        "january",
        "february",
        "march",
        "april",
        "may",
        "june",
        "july",
        "august",
        "september",
        "october",
        "november",
        "december",
      ];
      const monthIndex = monthNames.indexOf(month.toLowerCase());

      if (monthIndex !== -1) {
        return new Date(year, monthIndex, day);
      }
    }
    return null;
  }

  // Parse "Starts on 2nd March" or "Round 3 Starts on 2nd March" – returns date or null
  function parseStartDate(deadlineText) {
    if (!/starts?\s+on/i.test(deadlineText)) return null;
    const dateMatch = deadlineText.match(
      /(\d{1,2})(?:st|nd|rd|th)?\s+(January|February|March|April|May|June|July|August|September|October|November|December)/i,
    );
    if (!dateMatch) return null;
    const day = parseInt(dateMatch[1]);
    const month = dateMatch[2];
    const monthNames = [
      "january",
      "february",
      "march",
      "april",
      "may",
      "june",
      "july",
      "august",
      "september",
      "october",
      "november",
      "december",
    ];
    const monthIndex = monthNames.indexOf(month.toLowerCase());
    if (monthIndex === -1) return null;
    const year = new Date().getFullYear();
    return new Date(year, monthIndex, day);
  }

  // Function to check admission status
  function getAdmissionStatus(deadlineText) {
    if (
      deadlineText === "Admissions Closed" ||
      deadlineText === "Applications Closed" ||
      deadlineText.includes("Closing soon")
    ) {
      return "closed";
    }

    if (deadlineText.toLowerCase().includes("starting soon")) {
      return "starting_soon";
    }

    if (deadlineText.toLowerCase().includes("coming soon")) {
      return "coming_soon";
    }

    // "Round 3 Starts on 2nd March" – disable Apply Now until that date
    const startDate = parseStartDate(deadlineText);
    if (startDate) {
      const now = new Date();
      now.setHours(0, 0, 0, 0);
      const startDay = new Date(
        startDate.getFullYear(),
        startDate.getMonth(),
        startDate.getDate(),
      );
      return startDay > now ? "starting_soon" : "active";
    }

    const deadlineDate = parseDeadlineDate(deadlineText);
    if (deadlineDate) {
      const now = new Date();
      return deadlineDate < now ? "closed" : "active";
    }
    return "active";
  }

