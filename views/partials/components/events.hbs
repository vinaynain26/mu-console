<script>
  $(document).ready(function () {
    // Hide all content initially
    $(".headingRight.commonEventsBtn").hide().removeClass("active");

    // Find the already active tab
    let activeTab = $(".faqtabs.commonEvents li.active");
    if (activeTab.length) {
      let activeId = activeTab.attr("data-rel");
      $(`.headingRight.commonEventsBtn[data-rel='${activeId}']`)
        .addClass("active")
        .show();
    }

    // On clicking a tab
    $(".faqtabs.commonEvents li").click(function () {
      let id = $(this).attr("data-rel");

      // Ignore tabs containing 'inside' in data-rel
      if (id.includes("inside")) return;

      // Set active class on tab
      $(this).addClass("active").siblings().removeClass("active");

      // Show corresponding content
      $(".headingRight.commonEventsBtn").removeClass("active").hide();
      $(`.headingRight.commonEventsBtn[data-rel='${id}']`)
        .addClass("active")
        .show();
    });
  });
</script>

<script>
