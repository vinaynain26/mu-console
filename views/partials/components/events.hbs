  function getLatestEvents() {
    $.ajax({
      url: "{{apiBaseURL}}/api/getUpcomingEventsMastersunion?limit=30",
    }).done(function (response) {
      if (response.IsSuccess == true) {
        if (
          !response.Data.upcomingEvents ||
          response.Data.upcomingEvents.length === 0
        ) {
          // Hide the Events tab and its content if no events
          $('li[data-rel="Eventtab41"]').hide();
          $("#Eventtab41").hide();

          // If Events tab was active, switch to another tab (e.g., Admissions)
          if ($('li[data-rel="Eventtab41"]').hasClass("active")) {
            $('li[data-rel="Eventtab43"]').addClass("active");
            $("#Eventtab43").addClass("active");
          }
        } else {
          bindLatestEvents(response.Data.upcomingEvents);
        }
      }
    });
  }

  function convertTime12to24(time12h) {
    var [time, modifier] = time12h.split(" ");

    var [hours, minutes] = time.split(":");

    if (hours === "12") {
      hours = "00";
    }

    if (modifier === "PM") {
      hours = parseInt(hours, 10) + 12;
    }

    return `${hours}:${minutes}`;
  }

