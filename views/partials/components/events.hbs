  // Process admissions data - check deadlines and sort
  function processAdmissionsData() {
    const processedData = rawAdmissionsData.map((admission) => {
      const status = getAdmissionStatus(admission.admissionsDate);

      return {
        ...admission,
        status: status,
        isDeadlinePassed: status === "closed",
        displayDate: admission.admissionsDate,
        deadlineDate: parseDeadlineDate(admission.admissionsDate),
      };
    });

    // Sort: active programs first (by deadline date), then closed programs
    processedData.sort((a, b) => {
      // If both are closed, keep original order
      if (a.isDeadlinePassed && b.isDeadlinePassed) {
        return 0;
      }
      // If only a is closed, move it to end
      if (a.isDeadlinePassed && !b.isDeadlinePassed) {
        return 1;
      }
      // If only b is closed, move it to end
      if (!a.isDeadlinePassed && b.isDeadlinePassed) {
        return -1;
      }
      // If both are active, sort by deadline date
      if (a.deadlineDate && b.deadlineDate) {
        return a.deadlineDate - b.deadlineDate;
      }
      return 0;
    });

    return processedData;
  }

