<script>
  var swiper = new Swiper(".mastersScrollerStudent", {
    slidesPerView: "auto",
    centeredSlides: true,
    spaceBetween: 20,
    loop: true,
    speed: 300,
    autoplay: {
      delay: 2500,
      disableOnInteraction: false,
      pauseOnMouseEnter: true,
    },
    grabCursor: true,
    navigation: {
      nextEl: ".mastersScrollerStudent-next",
      prevEl: ".mastersScrollerStudent-prev",
    },
    breakpoints: {
      0: { slidesPerView: 1.2, spaceBetween: 20 },
      768: { slidesPerView: 2.3, spaceBetween: 20 },
      1024: { slidesPerView: 3.5, spaceBetween: 20 },
      1366: { slidesPerView: 4.2, spaceBetween: 20 },
      1440: { slidesPerView: 4.2, spaceBetween: 20 },
      1600: { slidesPerView: 4.2, spaceBetween: 20 },
      1920: { slidesPerView: 4.5, spaceBetween: 20 },
    },
  });

  const boxes = document.querySelectorAll(".newMasterImgBox");
  let flippedBox = null;

  function isTouchDevice() {
    return window.matchMedia("(pointer: coarse)").matches;
  }

  boxes.forEach((box) => {
    const card = box.querySelector(".cardInner");

    if (isTouchDevice()) {
      // MOBILE - click toggles flip (flip back works), one at a time
      box.addEventListener("click", () => {
        if (flippedBox === box) {
          card.classList.toggle("rotated");
          if (!card.classList.contains("rotated")) {
            flippedBox = null;
            swiper.autoplay.start();
          }
        } else {
          card.classList.add("rotated");
          if (flippedBox && flippedBox !== box) {
            flippedBox.querySelector(".cardInner").classList.remove("rotated");
          }
          flippedBox = box;
          swiper.autoplay.stop();
        }
      });
    } else {
      // DESKTOP - hover flips and unflips cards
      box.addEventListener("mouseenter", () => {
        boxes.forEach((b) => {
          if (b !== box) b.querySelector(".cardInner").classList.remove("rotated");
        });
        card.classList.add("rotated");
      });

      box.addEventListener("mouseleave", () => {
        card.classList.remove("rotated");
      });
    }
  });
</script>
