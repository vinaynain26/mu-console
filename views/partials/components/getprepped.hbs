<script>
    $(document).ready(function () {
        // Show the first tab and corresponding content by default
        $(".faqtabs.getprepped li:first").addClass("active"); // Set the first tab as active
        $(".headingRight.getpreppedBtn:first").addClass("active").show(); // Show the first content div

        // When a tab is clicked
        $(".faqtabs.getprepped li").click(function (event) {
            let id = $(this).attr("data-rel");

            // Avoid action if the tab contains "inside"
            if (id.includes("inside")) return;

            // Update active index and classes
            $(this).addClass("active").siblings().removeClass("active"); // Set active on clicked tab
            $(`#${id}`).addClass("active").siblings().removeClass("active"); // Set active content

            // Hide all headingRight divs and show the one matching the clicked tab's data-rel
            $(".headingRight.getpreppedBtn").removeClass("active").hide(); // Hide all
            $(`.headingRight.getpreppedBtn[data-rel='${id}']`).addClass("active").show(); // Show the matched div
        });
    });


</script>