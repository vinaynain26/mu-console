</section>


<script>
    $(document).ready(function () {
        function adjustScrolling() {
            var parentOffset = $('.mission').offset().top;
            console.log(`parentOffset is ${parentOffset}`);
            var windowHeight = $(window).height();
            var isMobile = $(window).width() <= 767;

            $(window).scroll(function () {
                var scrollPosition = $(window).scrollTop();
                //console.log(`scroll position is ${scrollPosition}`);

                var sectionHeight = $('.mission').outerHeight();
                //console.log(`section height is ${sectionHeight}`);

                // Scroll values for desktop
                var desktopScrollPosition1 = 1155;
                var desktopScrollPosition2 = 1040;

                // Scroll values for mobile
                var mobileScrollPosition1 = 1320; 
                var mobileScrollPosition2 = 1264;

                var scrollPosition1 = isMobile ? mobileScrollPosition1 : desktopScrollPosition1;
                var scrollPosition2 = isMobile ? mobileScrollPosition2 : desktopScrollPosition2;

                // Adjust element visibility based on scroll position
                if (scrollPosition > scrollPosition1) {
                  //  console.log("Scroll position reached for hiding element");
                    $('#makeHidden').addClass('hidden');
                } else {
                    $('#makeHidden').removeClass('hidden');
                }

                if (scrollPosition >= scrollPosition2) {
                    $('#fxCld1').removeClass('active');
                    $('#fxCld2').addClass('active');
                    $('.mission').addClass('darkTheme');
                    $('.missionButtonWrap').addClass('active');
                } else {
                    $('#fxCld1').addClass('active');
                    $('#fxCld2').removeClass('active');
                    $('.mission').removeClass('darkTheme');
                    $('.missionButtonWrap').removeClass('active');
                }

                if (scrollPosition >= scrollPosition2) {
                    $('#scroll1Btn').off('click').click(function () {
                        $('#fxCld2').removeClass('active');
                        $('.mission').removeClass('darkTheme');
                        $('#fxCld1').addClass('active');
                        $('.missionButtonWrap').removeClass('active');
                    });
                }

                if (scrollPosition >= scrollPosition2) {
                    $('#scroll2Btn').off('click').click(function () {
                        $('#fxCld1').removeClass('active');
                        $('.mission').addClass('darkTheme');
                        $('#fxCld2').addClass('active');
                        $('.missionButtonWrap').addClass('active');
                    });
                }
            });
        }

        adjustScrolling();

        $(window).resize(function () {
            adjustScrolling();
        });
    });
</script>