 <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll(".careerTabUl li");
            const images = document.querySelectorAll(".higherStudiesLeft .tabimgages");

            // Hide all images and show only the first by default
            function initializeImages() {
                images.forEach((imgDiv, index) => {
                    imgDiv.style.display = index === 0 ? "block" : "none";
                });
            }

            // Remove active class from all tabs
            function clearActiveTabs() {
                tabs.forEach(tab => tab.classList.remove("active"));
            }

            // Show image based on clicked tab index
            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => {
                    clearActiveTabs();
                    tab.classList.add("active");

                    images.forEach((imgDiv, i) => {
                        imgDiv.style.display = i === index ? "block" : "none";
                    });
                });
            });

            // Initialize view
            initializeImages();
        });
    </script>