                                <script>
                                    // Infinite smooth scroll for both carousels
                                    document.addEventListener('DOMContentLoaded', function () {
                                        function setupInfiniteScroll(trackId, direction = 'left', speed = 40) {
                                            const track = document.getElementById(trackId);
                                            if (!track) {
                                                console.log('Track not found:', trackId);
                                                return;
                                            }

                                            console.log('Setting up scroll for:', trackId);

                                            // Disable CSS animations and set up for JavaScript control
                                            track.style.animation = 'none';
                                            track.style.transition = 'none';

                                            // Wait for images to load to get accurate width
                                            const images = track.querySelectorAll('img');
                                            let loadedImages = 0;

                                            function checkImagesLoaded() {
                                                loadedImages++;
                                                if (loadedImages === images.length) {
                                                    startScroll();
                                                }
                                            }

                                            // If no images, start immediately
                                            if (images.length === 0) {
                                                startScroll();
                                                return;
                                            }

                                            images.forEach(img => {
                                                if (img.complete) {
                                                    checkImagesLoaded();
                                                } else {
                                                    img.addEventListener('load', checkImagesLoaded);
                                                    img.addEventListener('error', checkImagesLoaded); // Handle failed loads
                                                }
                                            });

                                            function startScroll() {
                                                console.log('Starting scroll for:', trackId);
                                                let pos = 0;
                                                let lastTimestamp = null;

                                                // Get the actual width of the first child
                                                const firstChild = track.children[0];
                                                if (!firstChild) {
                                                    console.log('No children found in track');
                                                    return;
                                                }

                                                const itemWidth = firstChild.offsetWidth || firstChild.getBoundingClientRect().width;
                                                const totalItems = track.children.length;
                                                const totalWidth = itemWidth * totalItems;
                                                const pxPerSecond = speed;

                                                console.log('Item width:', itemWidth, 'Total items:', totalItems, 'Total width:', totalWidth);

                                                function step(timestamp) {
                                                    if (!lastTimestamp) lastTimestamp = timestamp;
                                                    const elapsed = timestamp - lastTimestamp;
                                                    lastTimestamp = timestamp;

                                                    // Move at a constant speed regardless of frame rate
                                                    let delta = (pxPerSecond * elapsed) / 1000;

                                                    if (direction === 'left') {
                                                        pos -= delta;
                                                        if (Math.abs(pos) >= totalWidth) {
                                                            pos = 0;
                                                        }
                                                    } else {
                                                        pos += delta;
                                                        if (pos >= totalWidth) {
                                                            pos = 0;
                                                        }
                                                    }

                                                    track.style.transform = `translateX(${pos}px)`;
                                                    requestAnimationFrame(step);
                                                }
                                                requestAnimationFrame(step);
                                            }
                                        }

                                        // Wait a bit more to ensure everything is loaded
                                        setTimeout(() => {
                                            console.log('Starting marquee animations...');
                                            // Left moves left, right moves right
                                            setupInfiniteScroll('jobSwiperTrackLeft', 'left', 40);
                                            setupInfiniteScroll('jobSwiperTrackRight', 'right', 40);
                                        }, 500);
                                    });
                                </script>

