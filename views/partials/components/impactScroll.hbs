<script>
    function replaceWithVideo(container) {
        const videoId = container.getAttribute('data-video');

        const iframe = document.createElement('iframe');
        iframe.width = "100%";
        iframe.height = "315";
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.frameBorder = "0";
        iframe.allow = "autoplay; encrypted-media";
        iframe.allowFullscreen = true;

        container.innerHTML = '';
        container.appendChild(iframe);
    }

    function resetContainerToImage(container) {
        const imgSrc = container.getAttribute('data-img');

        container.innerHTML = ''; // Clear everything
        const img = document.createElement('img');
        img.src = imgSrc;
        img.style.display = "block";
        img.onclick = () => replaceWithVideo(container);
        container.appendChild(img);
    }

    function initializeVideoContainers() {
        const containers = $(".impactRight .video-container");

        // Reset all containers to images
        containers.each(function () {
            resetContainerToImage(this);
        });

        // Hide all containers
        containers.hide();

        // Always show the first container
        containers.first().show();

        return containers;
    }

    $(document).ready(function () {
        let containers = initializeVideoContainers();
        let currentIndex = 0;
        let isInitialized = false;

        // Add a small delay to prevent immediate scroll events from interfering
        setTimeout(() => {
            isInitialized = true;
        }, 100);

        $(window).on("scroll", function () {
            // Don't process scroll events until properly initialized
            if (!isInitialized) return;

            let newIndex = 0; // Always default to first
            let foundActiveBox = false;

            $(".impactLeftBox").each(function (index) {
                let boxTop = $(this).offset().top - $(window).scrollTop();

                // Only update newIndex if we find a box in the active zone
                // and we haven't found one yet (to prevent the last one from winning)
                if (boxTop <= 350 && boxTop >= -200 && !foundActiveBox) {
                    newIndex = index;
                    foundActiveBox = true;
                }
            });

            // Only update if the index has actually changed
            if (currentIndex !== newIndex) {
                // Reset all containers to images
                containers.each(function () {
                    resetContainerToImage(this);
                });

                // Hide all containers
                containers.hide();

                // Show the container at the new index (with bounds checking)
                const targetIndex = Math.min(newIndex, containers.length - 1);
                $(containers[targetIndex]).show();
                currentIndex = newIndex;
            }
        });

        // Handle tab visibility changes
        $(document).on('visibilitychange', function () {
            if (!document.hidden) {
                // When tab becomes visible again, reset to first video
                setTimeout(() => {
                    containers = initializeVideoContainers();
                    currentIndex = 0;
                }, 50);
            }
        });

        // Handle window focus events (additional safety)
        $(window).on('focus', function () {
            setTimeout(() => {
                containers = initializeVideoContainers();
                currentIndex = 0;
            }, 50);
        });
    });
</script>