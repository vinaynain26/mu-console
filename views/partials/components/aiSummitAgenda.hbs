    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = Array.from(document.querySelectorAll('.summitAgendaTab'));
            const panels = Array.from(document.querySelectorAll('.summitAgendaPanel'));
            const tabsContainer = document.querySelector('.summitAgendaTabs');

            function centerTab(tab) {
                if (!tabsContainer || window.innerWidth > 767) return;
                const containerRect = tabsContainer.getBoundingClientRect();
                const tabRect = tab.getBoundingClientRect();
                const scrollLeft = tabsContainer.scrollLeft
                    + (tabRect.left - containerRect.left)
                    - (containerRect.width / 2)
                    + (tabRect.width / 2);
                tabsContainer.scrollTo({ left: scrollLeft, behavior: 'smooth' });
            }

            function activate(tabId, clickedTab) {
                tabs.forEach(t => {
                    const isActive = t.getAttribute('data-agenda-tab') === tabId;
                    t.classList.toggle('active', isActive);
                    t.setAttribute('aria-selected', isActive ? 'true' : 'false');
                });

                panels.forEach(p => {
                    const isActive = p.getAttribute('data-agenda-panel') === tabId;
                    p.classList.toggle('active', isActive);
                    if (isActive) p.removeAttribute('hidden');
                    else p.setAttribute('hidden', '');
                });

                if (clickedTab) centerTab(clickedTab);
            }

            tabs.forEach(t => t.addEventListener('click', () => activate(t.getAttribute('data-agenda-tab'), t)));

            // Center the initially active tab on mobile
            const activeTab = tabsContainer && tabsContainer.querySelector('.summitAgendaTab.active');
            if (activeTab) setTimeout(() => centerTab(activeTab), 100);
        });
    </script>
