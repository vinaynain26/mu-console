<style>
    .worldClassSection {
        background: linear-gradient(to bottom, var(--white) 50%, var(--black) 50%);
        border-bottom: 1px solid var(--black5);

        .worldClassWrapper {
            display: flex;
            flex-direction: column;
            gap: 32px;
            align-items: flex-start;
        }


        .navigationWrapper {
            width: 100%;
            margin-bottom: 0;
            margin-top: 0;
        }

        .navigationWrapper ul {
            padding: 16px 30px;
            width: 100%;
            background: var(--black);
            display: flex;
            align-items: center;
            gap: 60px;
            justify-content: space-around;
            background: var(--grey17);
            margin-top: 30px;
            border-radius: 12px;
            margin-top: 0;
        }

        .content-section {
            width: 100%;
            margin-top: 24px;
        }

        .worldHeadingWrapper {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;

        }

        .worldCampusFrame {
            width: 100%;
            position: relative;
            background: var(--black);
            border-radius: 8px;
            overflow: hidden;
        }

        .worldCampusFrame iframe {
            height: 65vh;
            border-radius: 8px;
            width: 100%;
            display: block;
        }

        .worldCampusLoader {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: var(--white);
            background: var(--black);
            border-radius: 8px;
            pointer-events: none;
        }

        .worldCampusFrame.is-loaded .worldCampusLoader {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s;
        }
    }


    @media (max-width: 767px) {
        .worldClassSection {
            .worldHeadingWrapper {
                flex-direction: column;
                gap: 18px;
                align-items: flex-start;
            }

            .navigationWrapper {
                margin-top: 0;
            }

            .navigationWrapper ul {
                margin-top: 0;
                overflow:auto;
            }

            .tabs li{
                min-width:max-content;
            }
        }
    }
</style>

<script>
    /**
     * The campus tours are all WebGL (Matterport + krpano). Mobile GPUs cap how
     * many live WebGL contexts a page may hold, and the browser silently drops
     * the oldest ones when that cap is hit -- which is what surfaces as krpano's
     * "graphics context lost" error. So: keep exactly one tour loaded at a time,
     * start it only once the section is near the viewport, and tear the old one
     * down on every tab switch.
     */
    (function () {
        var SMALL_SCREEN = "(max-width: 1024px)";

        function initCampusTours(section) {
            if (section.dataset.campusToursInit === "1") return;
            section.dataset.campusToursInit = "1";

            var panes = Array.prototype.slice.call(
                section.querySelectorAll(".worldCampusFrame")
            );
            if (!panes.length) return;

            function paneById(id) {
                for (var i = 0; i < panes.length; i++) {
                    if (panes[i].id === id) return panes[i];
                }
                return null;
            }

            function activePane() {
                return section.querySelector(".worldCampusFrame.active") || panes[0];
            }

            function unload(pane) {
                var iframe = pane.querySelector("iframe");
                if (!iframe || !iframe.getAttribute("src")) return;
                // Swapping in a fresh node destroys the tour's document (and its
                // WebGL context) right away, and -- unlike src="about:blank" --
                // leaves no session-history entry to break the back button.
                var fresh = iframe.cloneNode(false);
                fresh.removeAttribute("src");
                iframe.parentNode.replaceChild(fresh, iframe);
                pane.classList.remove("is-loaded");
            }

            function load(pane) {
                if (!pane) return;
                var iframe = pane.querySelector("iframe");
                if (!iframe || iframe.getAttribute("src")) return;
                for (var i = 0; i < panes.length; i++) {
                    if (panes[i] !== pane) unload(panes[i]);
                }
                iframe.addEventListener("load", function () {
                    pane.classList.add("is-loaded");
                });
                iframe.setAttribute("src", iframe.getAttribute("data-src"));
            }

            section.addEventListener("click", function (event) {
                var target = event.target;
                if (!target || !target.closest) return;
                var tab = target.closest(".faqtabs li[data-rel]");
                if (!tab || !section.contains(tab)) return;
                load(paneById(tab.getAttribute("data-rel")));
            });

            if (!("IntersectionObserver" in window)) {
                load(activePane());
                return;
            }

            new IntersectionObserver(
                function (entries) {
                    for (var i = 0; i < entries.length; i++) {
                        if (entries[i].isIntersecting) {
                            load(activePane());
                        } else if (window.matchMedia(SMALL_SCREEN).matches) {
                            // Hand the GPU back on phones/tablets so other media
                            // further down these long pages still gets a context.
                            panes.forEach(unload);
                        }
                    }
                },
                { rootMargin: "300px 0px" }
            ).observe(section);
        }

        function initAll() {
            var sections = document.querySelectorAll(".worldClassSection");
            for (var i = 0; i < sections.length; i++) initCampusTours(sections[i]);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initAll);
        } else {
            initAll();
        }
    })();
</script>
