                        <img class="arrow arrow1"
                            src="https://images.mastersunion.link/uploads/18022025/v1/Frame1321316511.svg" alt="arrow">
                        <img class="arrow arrow2"
                            src="https://images.mastersunion.link/uploads/18022025/v1/Frame1321316511.svg" alt="arrow">
                    </span>

                </a>
            </div>

            <nav class="navigationWrapper ">
                <ul class="tabs faqtabs">
                    <li class="active" data-rel="urban-campus5">CDS Tower </li>
                    <li class="" data-rel="urban-campus55">CDS Tower - 2nd Floor </li>
                    <li class="" data-rel="urban-campus1">Tower A </li>
                    <li class="" data-rel="urban-campus2"> Tower C</li>
                    <li class="" data-rel="urban-campus3"> Auditorium </li>
                    <li class="" data-rel="urban-campus4"> Food Court</li>
