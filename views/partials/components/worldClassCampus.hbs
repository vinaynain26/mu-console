                            allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer; magnetometer; vr"></iframe>
                        <div class="worldCampusLoader" aria-hidden="true">Loading 360&deg; tour&hellip;</div>
                    </div>

                    <div class="worldCampusFrame content" id="urban-campus55">
                        <iframe width="100%" height="400px" title="CDS Tower - 2nd Floor 360&deg; tour"
                            data-src="https://my.matterport.com/show/?m=zjAw7AksqvZ" frameborder="0" allowfullscreen
                            allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer; magnetometer; vr"></iframe>
                        <div class="worldCampusLoader" aria-hidden="true">Loading 360&deg; tour&hellip;</div>
                    </div>


                    <div class="worldCampusFrame content" id="urban-campus1">
                        <iframe width="100%" height="400px" title="Tower A 360&deg; tour"
                            data-src="https://my.matterport.com/show/?m=fvbzUtwNH1B" frameborder="0" allowfullscreen
                            allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer; magnetometer; vr"></iframe>
                        <div class="worldCampusLoader" aria-hidden="true">Loading 360&deg; tour&hellip;</div>
                    </div>

                    <div class="worldCampusFrame content" id="urban-campus2">
                        <iframe width="100%" height="400px" title="Tower C 360&deg; tour"
                            data-src="https://my.matterport.com/show/?m=jQcZmR1BxFc&play=1&brand=1" frameborder="0"
                            allowfullscreen
                            allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer; magnetometer; vr"></iframe>
                        <div class="worldCampusLoader" aria-hidden="true">Loading 360&deg; tour&hellip;</div>
                    </div>

                    <div class="worldCampusFrame content" id="urban-campus3">
                        <iframe width="100%" height="400px" title="Auditorium 360&deg; tour"
                            data-src="https://s3.mastersunion.link/assets/mu-vr/index.html" frameborder="0"
