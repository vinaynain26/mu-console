<script>
    document.addEventListener("DOMContentLoaded", () => {
        var slider = document.getElementById("slider");

        // Hide scrollbar but keep functionality
        slider.style.msOverflowStyle = 'none'; // IE and Edge
        slider.style.scrollbarWidth = 'none'; // Firefox
        slider.style.overflow = 'scroll';

        // Clone the contents once to allow seamless scroll
        slider.innerHTML += slider.innerHTML;

        let scrollAmount = 0;
        let animationFrame;

        function autoScroll() {
            scrollAmount += 0.60; // Adjust scroll speed here
            slider.scrollLeft = scrollAmount;

            // Reset scroll when it reaches half (original content width)
            if (scrollAmount >= slider.scrollWidth / 2) {
                scrollAmount = 0;
            }

            animationFrame = requestAnimationFrame(autoScroll);
        }

        // Start scrolling
        autoScroll();

        // Pause on hover
        slider.addEventListener('mouseenter', () => {
            cancelAnimationFrame(animationFrame);
        });

        // Resume on mouse leave
        slider.addEventListener('mouseleave', () => {
            autoScroll();
        });
    });
</script>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        var slider = document.getElementById("sliderReverse");

        // Hide scrollbar but keep functionality
        slider.style.msOverflowStyle = 'none';
        slider.style.scrollbarWidth = 'none';
        slider.style.overflow = 'scroll';

        // Clone the contents once to allow seamless scroll
        slider.innerHTML += slider.innerHTML;

        let scrollAmount = 0;
        let animationFrame;
        let started = false;

        function initAndStart() {
            // Start from the end of the first half (right side)
            scrollAmount = slider.scrollWidth / 2;
            slider.scrollLeft = scrollAmount;
            if (!started) {
                started = true;
                autoScroll();
            }
        }

        function autoScroll() {
            scrollAmount -= 0.60; // Scroll right-to-left (opposite direction)

            // When we've scrolled back to the start, jump to the middle again
            if (scrollAmount <= 0) {
                scrollAmount = slider.scrollWidth / 2;
            }

            slider.scrollLeft = scrollAmount;
            animationFrame = requestAnimationFrame(autoScroll);
        }

        // Wait for images to load so scrollWidth is accurate
        window.addEventListener('load', initAndStart);

        // Fallback: also try after a short delay in case load already fired
        setTimeout(initAndStart, 100);

        // Pause on hover
        slider.addEventListener('mouseenter', () => {
            cancelAnimationFrame(animationFrame);
        });

        // Resume on mouse leave
        slider.addEventListener('mouseleave', () => {
            autoScroll();
        });
    });
</script>

