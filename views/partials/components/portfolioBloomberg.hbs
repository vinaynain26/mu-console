        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Make sure jQuery is loaded before running this script
                if (typeof jQuery === 'undefined') {
                    console.error("jQuery is not loaded! Please include jQuery before this script.");
                    return;
                }

                let disableScrollDetect = false;

                function isMobile() {
                    return $(window).width() <= 768;
                }

                // Function to center an element in its container
                function centerElementInContainer(element, container) {
                    if (!element.length || !container.length) return;

                    // Calculate the position that would center the element
                    const elementOffset = element.offset().left;
                    const elementWidth = element.outerWidth();
                    const containerOffset = container.offset().left;
                    const containerWidth = container.width();

                    // Calculate the scroll position that would center the element
                    const scrollLeft = elementOffset - containerOffset - (containerWidth / 2) + (elementWidth / 2);

                    // Faster animation for desktop, keep original for mobile
                    const animationDuration = isMobile() ? 300 : 100;

                    // Animate to that position
                    container.animate({
                        scrollLeft: container.scrollLeft() + scrollLeft
                    }, animationDuration);
                }

                // Calculate how much of an element is visible in the viewport
                function getVisibilityPercentage(element) {
                    const rect = element.getBoundingClientRect();
                    const windowHeight = window.innerHeight;

                    // If the element is not in the viewport at all
                    if (rect.bottom <= 0 || rect.top >= windowHeight) {
                        return 0;
                    }

                    // Calculate the visible height of the element
                    const visibleHeight = Math.min(rect.bottom, windowHeight) - Math.max(rect.top, 0);
                    const elementHeight = rect.height;

                    // Calculate the percentage of the element that is visible
                    return (visibleHeight / elementHeight) * 100;
                }

                // Desktop click: portfolioStepWrapper
                $(".portfolioStepWrapper").on("click", function (e) {
                    if (isMobile()) return;
                    e.preventDefault();

                    disableScrollDetect = true;

                    $(".portfolioStepWrapper").removeClass("active");
                    $(this).addClass("active");

                    // Center the active item in its container
                    centerElementInContainer($(this), $(this).parent());

                    var target = $(this).attr("data-target");
                    if ($(target).length) {
                        $("html, body").animate(
                            {
                                scrollTop: $(target).offset().top - 200,
                            },
                            800,
                            function () {
                                setTimeout(function () {
                                    disableScrollDetect = false;
                                }, 100);
                            }
                        );
                    } else {
                        console.error("Target not found:", target);
                        disableScrollDetect = false;
                    }
                });

                // Mobile click: faqHeadingItem
                $(".faqHeadingItem").on("click", function (e) {
                    if (!isMobile()) return;
                    e.preventDefault();

                    disableScrollDetect = true;

                    $(".faqHeadingItem").removeClass("active");
                    $(this).addClass("active");

                    // Center the active item in its container
                    centerElementInContainer($(this), $(this).parent());

                    var target = $(this).attr("data-rel");
                    if ($("#" + target).length) {
                        $("html, body").animate(
                            {
                                scrollTop: $("#" + target).offset().top - 300,
                            },
                            800,
                            function () {
                                setTimeout(function () {
                                    disableScrollDetect = false;
                                }, 100);
                            }
                        );
                    } else {
                        console.error("Target not found:", target);
                        disableScrollDetect = false;
                    }
                });

                // Scroll Detection - optimize desktop, keep mobile unchanged
                let scrollTimer;
                $(window).on("scroll", function () {
                    if (disableScrollDetect) return;

                    clearTimeout(scrollTimer);

                    // Use a shorter delay for desktop
                    const throttleDelay = isMobile() ? 50 : 10;

                    scrollTimer = setTimeout(function () {
                        var scrollPos = $(window).scrollTop();
                        let mobileActiveChanged = false;
                        let desktopActiveChanged = false;
                        let newMobileActiveElement = null;
                        let newDesktopActiveElement = null;

                        // For mobile: COMPLETELY NEW APPROACH
                        if (isMobile()) {
                            // Track which section has the highest visibility
                            let mostVisibleSection = null;
                            let highestVisibility = 0;

                            // Check each section
                            $("[id^='out']").each(function () {
                                var sectionId = $(this).attr("id");
                                var visibilityPercentage = getVisibilityPercentage(this);

                                // If this section is more visible than the current most visible
                                if (visibilityPercentage > highestVisibility) {
                                    highestVisibility = visibilityPercentage;
                                    mostVisibleSection = sectionId;
                                }
                            });

                            // If we found a visible section
                            if (mostVisibleSection && highestVisibility > 10) { // At least 10% visible
                                const activeItem = $(".faqHeadingItem[data-rel='" + mostVisibleSection + "']");

                                if (!activeItem.hasClass("active")) {
                                    $(".faqHeadingItem").removeClass("active");
                                    activeItem.addClass("active");
                                    mobileActiveChanged = true;
                                    newMobileActiveElement = activeItem;
                                }
                            }
                        }
                        // For desktop: OPTIMIZED VERSION
                        else {
                            // Find the section whose top is within 350px from the viewport top
                            let closestSection = null;
                            let minOffset = Infinity;

                            $(".classRomFaqWrapNew.steps").each(function () {
                                var sectionId = $(this).attr("id");
                                var sectionTop = $(this).offset().top;
                                var offsetFromTop = sectionTop - scrollPos;
                                // Check if section is within 0 to 350px from top
                                if (offsetFromTop >= 0 && offsetFromTop <= 350) {
                                    if (offsetFromTop < minOffset) {
                                        minOffset = offsetFromTop;
                                        closestSection = sectionId;
                                    }
                                }
                            });

                            if (closestSection) {
                                const activeItem = $(".portfolioStepWrapper[data-target='#" + closestSection + "']");

                                if (!activeItem.hasClass("active")) {
                                    // Apply active class immediately
                                    $(".portfolioStepWrapper").removeClass("active");
                                    activeItem.addClass("active");
                                    desktopActiveChanged = true;
                                    newDesktopActiveElement = activeItem;
                                }
                            }
                        }

                        // If active item changed, center it in the container
                        if (mobileActiveChanged && newMobileActiveElement) {
                            centerElementInContainer(newMobileActiveElement, newMobileActiveElement.parent());
                        }
                        if (desktopActiveChanged && newDesktopActiveElement) {
                            centerElementInContainer(newDesktopActiveElement, newDesktopActiveElement.parent());
                        }
                    }, throttleDelay);
                });

                // Trigger scroll event on page load and resize
                $(window).trigger("scroll");

                $(window).on("resize", function () {
                    $(window).trigger("scroll");
                });
            });
        </script>