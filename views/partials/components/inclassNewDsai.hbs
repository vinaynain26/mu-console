<script>
    // Desktop accordion functionality
    function runDesktopAccordionScript() {
        // Remove any previous handlers
        $(".classRomFaqWrap .left").off("click.desktopAccordion");
        $(".classRomFaqWrap .left").off("click.mobileAccordion");

        // Helper to show tempText
        function showTempText($el) {
            $el.removeClass('hide-temp');
        }
        function hideTempText($el) {
            $el.addClass('hide-temp');
        }

        // Desktop: close all accordions, hide extra content, show tempText
        $(".classRomFaqWrap").removeClass("active").find(".classRomFaqAns").hide();
        $(".inclassDataParent .extra-content").hide();
        $(".viewMoreButton").html('View More <img src="https://images.mastersunion.link/uploads/26022025/v1/Vector.svg" alt="Icon">');
        $(".tempText").each(function () { showTempText($(this)); });

        // Open the first accordion by default
        var $firstAcc = $(".classRomFaqWrap").first();
        $firstAcc.addClass("active").find(".classRomFaqAns").show();
        $firstAcc.find(".tempText").each(function () { hideTempText($(this)); });

        // Desktop accordion click
        $(".classRomFaqWrap .left").on("click.desktopAccordion", function () {
            if (window.innerWidth <= 1024) return;
            let parent = $(this).closest(".classRomFaqWrap");
            let content = parent.find(".classRomFaqAns");
            if (parent.hasClass("active")) {
                // Keep one accordion open at all times: clicking the open one does nothing
                return;
            } else {
                $(".classRomFaqWrap").each(function () {
                    $(this).removeClass("active").find(".classRomFaqAns").slideUp();
                    $(this).find(".tempText").each(function () { showTempText($(this)); });
                });
                parent.addClass("active");
                content.slideDown({
                    complete: function () {
                        $('html, body').animate({ scrollTop: parent.offset().top - 230 }, 400);
                    }
                });
                parent.find(".tempText").each(function () { hideTempText($(this)); });
            }
        });
    }

    // Mobile accordion functionality
    function runMobileAccordionScript() {
        // Remove any previous handlers
        $(".classRomFaqWrap .left").off("click.desktopAccordion");
        $(".classRomFaqWrap .left").off("click.mobileAccordion");

        // Helper to show tempText
        function showTempText($el) {
            $el.removeClass('hide-temp');
        }
        function hideTempText($el) {
            $el.addClass('hide-temp');
        }

        // Mobile: close all accordions, show extra content, show tempText
        $(".classRomFaqWrap").removeClass("active").find(".classRomFaqAns").hide();
        $(".inclassDataParent .extra-content").show();
        $(".tempText").removeClass('hide-temp');
        $(".viewMoreButton").html('View Less <img src="https://images.mastersunion.link/uploads/28022025/v1/Vector1.svg">');

        // Open the first accordion by default
        var $firstAcc = $(".classRomFaqWrap").first();
        $firstAcc.addClass("active").find(".classRomFaqAns").show();
        $firstAcc.find(".tempText").each(function () { hideTempText($(this)); });

        // Mobile accordion click
        $(".classRomFaqWrap .left").on("click.mobileAccordion", function () {
            if (window.innerWidth > 1024) return;
            let parent = $(this).closest(".classRomFaqWrap");
            let content = parent.find(".classRomFaqAns");
            if (parent.hasClass("active")) {
                // Keep one accordion open at all times: clicking the open one does nothing
                return;
            } else {
                $(".classRomFaqWrap").each(function () {
                    $(this).removeClass("active").find(".classRomFaqAns").slideUp();
                    $(this).find(".tempText").each(function () { showTempText($(this)); });
                });
                parent.addClass("active");
                content.slideDown({
                    complete: function () {
                        $('html, body').animate({ scrollTop: parent.offset().top - 230 }, 400);
                    }
                });
                parent.find(".tempText").each(function () { hideTempText($(this)); });
            }
        });
        // Add this inside runMobileAccordionScript()
        // (after the mobile accordion click handler)
        $(".viewMoreButton").off("click.mobileViewMore");
        $(".viewMoreButton").on("click.mobileViewMore", function () {
            if (window.innerWidth > 1024) return; // Only for mobile
            let parentAccordion = $(this).closest(".classRomFaqWrap");
            let extraContent = $(this).prev(".inclassDataParent").find(".extra-content ");
            if (extraContent.is(":visible")) {
                // Hide extra content and show tempText
                extraContent.slideUp();
                parentAccordion.find(".tempText").each(function () {
                    $(this).removeClass('hide-temp');
                });
                $(this).html('View More <img src="https://images.mastersunion.link/uploads/26022025/v1/Vector.svg" alt="Icon">');
                // Scroll to top of accordion when hiding content
                $('html, body').animate({ scrollTop: parentAccordion.offset().top - 230 }, 400);
            } else {
                // Show extra content and hide tempText
                extraContent.slideDown();
                parentAccordion.find(".tempText").each(function () {
                    $(this).addClass('hide-temp');
                });
                $(this).html('View Less <img src="https://images.mastersunion.link/uploads/28022025/v1/Vector1.svg">');
            }
        });
    }

    $(document).ready(function () {
        let lastMode = null;
        function setAccordionMode() {
            if (window.innerWidth > 1024) {
                if (lastMode !== 'desktop') {
                    runDesktopAccordionScript();
                    lastMode = 'desktop';
                }
            } else {
                if (lastMode !== 'mobile') {
                    runMobileAccordionScript();
                    lastMode = 'mobile';
                }
            }
        }
        setAccordionMode();
        $(window).on('resize', function () {
            setAccordionMode();
        });
    });

    $(window).trigger('scroll');

    document.addEventListener("DOMContentLoaded", function () {
        let elements = document.getElementsByTagName('lottie-player');
        for (let i = 0; i < elements.length; i++) {
            elements[i].addEventListener('play', (event) => {
                event.target.shadowRoot.querySelector('svg').style.transform = '';
            });
            elements[i].play();
        }
    });
</script>