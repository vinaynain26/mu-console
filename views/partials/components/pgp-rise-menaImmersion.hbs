<script>
document.addEventListener('DOMContentLoaded', function () {
    const navItems = document.querySelectorAll('.courseName');

    // Scroll on click with 200px offset from top
    navItems.forEach(item => {
        item.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = item.getAttribute('data-rel');
            const targetSection = document.getElementById(targetId);
            if (targetSection) {
                const topOffset = targetSection.getBoundingClientRect().top + window.pageYOffset - 200;
                window.scrollTo({
                    top: topOffset,
                    behavior: 'smooth'
                });
            }
        });
    });

    // Intersection Observer with 200px offset
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.id;
                navItems.forEach(item => {
                    item.classList.toggle('active', item.getAttribute('data-rel') === id);
                });
            }
        });
    }, {
        root: null,
        rootMargin: '-200px 0px -60% 0px', // top offset
        threshold: 0
    });

    // Observe each section
    ['teaching1', 'teaching2', 'teaching4'].forEach(id => {
        const section = document.getElementById(id);
        if (section) {
            observer.observe(section);
        }
    });
});
</script>
