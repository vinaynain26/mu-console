    ;

  const container = document.getElementById("opportunityWrapper");
  const VISIBLE_TEAM_COUNT = 15;

  data.forEach((person, index) => {
    const box = document.createElement("div");
    box.className = index < VISIBLE_TEAM_COUNT ? "masterBox" : "masterBox isTeamHidden";
    box.innerHTML = `
      <img  src="${person.image}" alt="${person.name}">
      <div class="opprName new flexbox">${person.name}</div>
      <div class="lightmastername">${person.designation}</div>
      <hr class="lineSpace">
      <div class="opprDesignation">
        <div class="opprDesignation new">${person.bio}</div>
      </div>
    `;
    container.appendChild(box);
  });

  (function () {
    const toggleWrap = document.querySelector(".careerTeamToggleWrap");
    const toggleBtn = document.getElementById("careerTeamToggleBtn");

    if (!toggleWrap || !toggleBtn || data.length <= VISIBLE_TEAM_COUNT) return;

    const toggleLabel = toggleBtn.querySelector(".careerTeamToggleLabel");
    const overflowBoxes = Array.from(container.querySelectorAll(".masterBox.isTeamHidden"));
    const mobileQuery = window.matchMedia("(max-width: 767px)");

    const setCollapsed = (isCollapsed) => {
      overflowBoxes.forEach(box => box.classList.toggle("isTeamHidden", isCollapsed));
      toggleBtn.setAttribute("aria-expanded", String(!isCollapsed));
      toggleLabel.textContent = isCollapsed ? "View More" : "View Less";
    };

    // Mobile shows the full list with no toggle; desktop starts collapsed at VISIBLE_TEAM_COUNT.
    const syncViewport = () => {
      const isMobile = mobileQuery.matches;
      toggleWrap.classList.toggle("isVisible", !isMobile);

      if (isMobile) {
        overflowBoxes.forEach(box => box.classList.remove("isTeamHidden"));
        toggleBtn.setAttribute("aria-expanded", "false");
        toggleLabel.textContent = "View More";
        return;
      }

      setCollapsed(true);
    };

    toggleBtn.addEventListener("click", function () {
      if (mobileQuery.matches) return;

      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      setCollapsed(isExpanded);

      if (isExpanded) {
        container.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    if (typeof mobileQuery.addEventListener === "function") {
      mobileQuery.addEventListener("change", syncViewport);
    } else if (typeof mobileQuery.addListener === "function") {
      mobileQuery.addListener(syncViewport);
    }

    syncViewport();
  })();
</script>