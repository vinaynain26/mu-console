<script>
    document.addEventListener("DOMContentLoaded", () => {
        const sliders = document.querySelectorAll(".marqueesliders");

        function initSlider(slider) {
            if (slider.dataset.marqueeReady) return;
            slider.dataset.marqueeReady = "1";
            // Hide scrollbar
            slider.style.msOverflowStyle = "none";
            slider.style.scrollbarWidth = "none";
            slider.style.overflowX = "scroll";
            slider.style.whiteSpace = "nowrap";

            // Duplicate content for infinite scroll
            slider.innerHTML += slider.innerHTML;

            let scrollAmount = 0;
            let animationFrame;

            function autoScroll() {
                scrollAmount += 0.8;
                if (scrollAmount >= slider.scrollWidth / 2) {
                    scrollAmount = 0;
                }
                slider.scrollLeft = scrollAmount;
                animationFrame = requestAnimationFrame(autoScroll);
            }

            function pauseScroll() {
                cancelAnimationFrame(animationFrame);
            }

            function resumeScroll() {
                cancelAnimationFrame(animationFrame);
                animationFrame = requestAnimationFrame(autoScroll);
            }

            slider.pauseScroll = pauseScroll;
            slider.resumeScroll = resumeScroll;

            resumeScroll(); // Start scroll on load

            // === Desktop: Hover to Flip and Pause ===
            const cards = slider.querySelectorAll(".newMasterImgBox");
            cards.forEach((box) => {
                const card = box.querySelector(".cardInner");

                box.addEventListener("mouseenter", () => {
                    pauseScroll();
                    cards.forEach((b) => {
                        if (b !== box) b.querySelector(".cardInner").classList.remove("rotated");
                    });
                    card.classList.add("rotated");
                });

                box.addEventListener("mouseleave", () => {
                    card.classList.remove("rotated");
                    resumeScroll();
                });
            });
        }

        {{!--
          This marquee lives inside .mob-hide, so on mobile it is display:none.
          Initialising it there doubled ~42 offscreen card images into the DOM and
          left an rAF loop spinning forever (scrollWidth is 0 when hidden, so
          scrollAmount reset every frame). Only set it up once it's actually visible.
        --}}
        const desktopMQ = window.matchMedia("(min-width: 769px)");

        function syncSliders() {
            if (!desktopMQ.matches) return;
            sliders.forEach(initSlider);
        }

        syncSliders();
        desktopMQ.addEventListener("change", syncSliders);

        // ✅ === Mobile: Tap to Flip in .dsaiMastersMobile ===
        if (window.matchMedia("(pointer: coarse)").matches) {
            const boxes = document.querySelectorAll(".dsaiMastersMobile .newMasterImgBox");
            let flippedBox = null;

            boxes.forEach((box) => {
                const card = box.querySelector(".cardInner");

                box.addEventListener("click", (e) => {
                    e.stopPropagation();

                    // Toggle this card
                    if (flippedBox === box) {
                        card.classList.toggle("rotated");
                        if (!card.classList.contains("rotated")) {
                            flippedBox = null;
                        }
                        return;
                    }

                    // Flip new one and unflip old
                    if (flippedBox) {
                        flippedBox.querySelector(".cardInner").classList.remove("rotated");
                    }

                    card.classList.add("rotated");
                    flippedBox = box;
                });
            });

            // Tap outside to unflip
            document.addEventListener("click", (e) => {
                if (flippedBox && !flippedBox.contains(e.target)) {
                    flippedBox.querySelector(".cardInner").classList.remove("rotated");
                    flippedBox = null;
                }
            });
        }
    });
</script>

