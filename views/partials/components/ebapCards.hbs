<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slider = document.getElementById("sliderebap");

        if (slider) {
            // Hide scrollbar while keeping scroll functionality
            slider.style.msOverflowStyle = 'none'; // IE and Edge
            slider.style.scrollbarWidth = 'none'; // Firefox
            slider.style.overflow = 'hidden'; // Hide overflow for smooth effect
            slider.style.display = 'flex'; // Flexbox for better control

            // Clone contents multiple times for seamless scroll
            const originalContent = slider.innerHTML;
            slider.innerHTML = originalContent + originalContent + originalContent;

            // Get the width of one set of cards
            const cardWidth = slider.scrollWidth / 3;

            let scrollAmount = 0;
            let animationFrame;
            let isPaused = false;

            function autoScroll() {
                if (!isPaused) {
                    scrollAmount += 0.8; // Adjust speed here

                    // Seamless reset without visible jump
                    if (scrollAmount >= cardWidth) {
                        scrollAmount = 0;
                    }

                    slider.scrollLeft = scrollAmount;
                }

                animationFrame = requestAnimationFrame(autoScroll);
            }

            // Start auto scroll
            autoScroll();

            // Pause on hover
            slider.addEventListener('mouseenter', () => {
                isPaused = true;
            });

            // Resume on mouse leave
            slider.addEventListener('mouseleave', () => {
                isPaused = false;
            });
        }
    });
</script>