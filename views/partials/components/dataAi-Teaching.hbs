<script>
    //second nav bar

    $(document).ready(function () {
        const tabs = $(".Teachingseondtabs .list");

        // Function to scroll the active tab into view
        function scrollToActiveTab() {
            $(".Teachingseondtabs .list.active")[0]?.scrollIntoView({
                behavior: "smooth",
                inline: "center",
                block: "nearest"
            });
        }

        // On Click
        tabs.on("click", function () {
            tabs.removeClass("active"); // Remove active class from all tabs
            $(this).addClass("active"); // Add active class to clicked tab
            scrollToActiveTab(); // Scroll active tab into view
        });

        // On Scroll
        $(window).on("scroll", function () {
            $(".Teachingseondtabs .list a").each(function () {
                const sectionId = $(this).attr("href");
                const section = $(sectionId);

                if (section.length) {
                    const offsetTop = section.offset().top - 100; // Adjust offset as needed
                    const offsetBottom = offsetTop + section.outerHeight();
                    const scrollPosition = $(window).scrollTop();

                    if (scrollPosition >= offsetTop && scrollPosition < offsetBottom) {
                        tabs.removeClass("active"); // Remove active class from all tabs
                        $(this).parent().addClass("active"); // Add active class to the current tab
                        scrollToActiveTab(); // Scroll active tab into view
                    }
                }
            });
        });
    });


    //second nav bar end

</script>