                                    if (!isMobileDevice()) {
                                        const popupId = `videoPopup_${instanceId}`;
                                        const videoPopup = document.getElementById(popupId);
                                        if (videoPopup && videoPopup.classList.contains('active')) {
                                            closeVideoPopup();
                                        }
                                    }
                                });

                                // Store methods in instance
                                instance.togglePlayPause = togglePlayPause;
                            }
                            
                            // Initialize function that handles timing
                            function initializeInstance() {
                                // Try to find container
                                container = findAndInitContainer();
                                if (container) {
                                    init();
                                } else {
                                    // If not found, try again after a short delay
                                    // This handles cases where DOM is still being constructed
                                    setTimeout(function() {
                                        container = findAndInitContainer();
                                        if (container) {
                                            init();
                                        } else {
                                            // Last attempt - wait a bit more for dynamic content
                                            setTimeout(function() {
                                                container = findAndInitContainer();
                                                if (container) init();
                                            }, 50);
                                        }
                                    }, 10);
                                }
                            }
                            
                            // Initialize on DOM ready
                            if (document.readyState === 'loading') {
                                document.addEventListener("DOMContentLoaded", function() {
                                    initializeInstance();
                                });
                            } else {
                                // DOM already loaded, but wait a tick to ensure all scripts are parsed
                                if (window.requestAnimationFrame) {
                                    requestAnimationFrame(function() {
                                        initializeInstance();
                                    });
                                } else {
                                    setTimeout(initializeInstance, 0);
                                }
                            }
                        })();
                    </script>
