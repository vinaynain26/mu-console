<div class="homepage">
    <section class="tetrStartupSection ">
        <div class="container">
            <div class="startUpWrapBlock">
                <div class="leftWrapStartup">


                    <div class="swiper startupVideoSec" data-tetr-instance data-tetr-init>
                        <div class="swiper-wrapper" data-tetr-name-list></div>

                        <button class="btnBlack mob-visible" data-tetr-play-mobile>

                            <svg xmlns="https://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22"
                                fill="none">
                                <path
                                    d="M20.625 11.0001C20.6256 10.7666 20.5657 10.537 20.4513 10.3336C20.3368 10.1301 20.1717 9.95976 19.9719 9.83904L7.59 2.26451C7.38125 2.13668 7.14215 2.0669 6.89741 2.06237C6.65267 2.05783 6.41116 2.11872 6.19781 2.23873C5.9865 2.35688 5.81047 2.52918 5.68783 2.73792C5.56518 2.94665 5.50035 3.18429 5.5 3.42639L5.5 18.5737C5.50035 18.8158 5.56518 19.0535 5.68783 19.2622C5.81047 19.4709 5.9865 19.6432 6.19781 19.7614C6.41116 19.8814 6.65267 19.9423 6.89741 19.9378C7.14215 19.9332 7.38125 19.8634 7.59 19.7356L19.9719 12.1611C20.1717 12.0404 20.3368 11.87 20.4513 11.6665C20.5657 11.4631 20.6256 11.2335 20.625 11.0001Z"
                                    fill="white" />
                            </svg>

                            Watch Video
                        </button>
                    </div>

                    <script>
                        (function() {
                            // Generate unique instance ID first
                            const instanceId = 'tetr_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
                            
                            // Function to find and initialize container
                            function findAndInitContainer() {
                                // Find the container for this instance - look for the nearest uninitialized swiper
                                let container = null;
                                const script = document.currentScript;
                                
                                if (script) {
                                    // Method 1: Look in the immediate parent (leftWrapStartup)
                                    let parent = script.parentElement;
                                    if (parent) {
                                        // Check if parent or its siblings have the swiper
                                        const swiper = parent.querySelector('.startupVideoSec[data-tetr-init]:not([data-instance-id])');
                                        if (swiper) {
                                            container = swiper;
                                        } else {
                                            // Check in the startUpWrapBlock
                                            const wrapBlock = parent.closest('.startUpWrapBlock');
                                            if (wrapBlock) {
                                                const swiper = wrapBlock.querySelector('.startupVideoSec[data-tetr-init]:not([data-instance-id])');
                                                if (swiper) {
                                                    container = swiper;
                                                }
                                            }
                                        }
                                    }
                                    
                                    // Method 2: If still not found, traverse up the DOM tree
                                    if (!container && script.parentElement) {
                                        let current = script.parentElement;
                                        let depth = 0;
                                        while (current && depth < 5) {
                                            const swiper = current.querySelector('.startupVideoSec[data-tetr-init]:not([data-instance-id])');
                                            if (swiper) {
                                                container = swiper;
                                                break;
                                            }
                                            current = current.parentElement;
                                            depth++;
                                        }
                                    }
                                }
                                
                                // Method 3: Fallback - find first uninitialized instance (but only if script context failed)
                                if (!container) {
                                    // Get all uninitialized instances
                                    const uninitialized = document.querySelectorAll('.startupVideoSec[data-tetr-init]:not([data-instance-id])');
                                    if (uninitialized.length > 0) {
                                        // Try to find the one closest to this script
                                        if (script && script.parentElement) {
                                            const scriptParent = script.parentElement.closest('.startUpWrapBlock, .tetrStartupSection');
                                            if (scriptParent) {
                                                // Find swiper within the same section
                                                for (let i = 0; i < uninitialized.length; i++) {
                                                    if (scriptParent.contains(uninitialized[i])) {
                                                        container = uninitialized[i];
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                        // If still not found, take the first one
                                        if (!container) {
                                            container = uninitialized[0];
                                        }
                                    }
                                }
                                
                                if (!container) return null;
                                
                                // Set instance ID on container to mark it as initialized
                                container.setAttribute('data-instance-id', instanceId);
                                return container;
                            }
                            
                            // Initialize instance storage
                            if (!window.tetrInstances) {
                                window.tetrInstances = {};
                            }
                            
                            // Global function to initialize all uninitialized instances (fallback)
                            if (!window.initAllTetrInstances) {
                                window.initAllTetrInstances = function() {
                                    const uninitialized = document.querySelectorAll('.startupVideoSec[data-tetr-init]:not([data-instance-id])');
                                    uninitialized.forEach(function(swiper) {
                                        // This will be handled by individual script tags
                                        // But we can add a marker to help identify them
                                        if (!swiper.hasAttribute('data-init-attempted')) {
                                            swiper.setAttribute('data-init-attempted', 'true');
                                        }
                                    });
                                };
                            }
                            
                            const instance = {
                                id: instanceId,
                                isAutoplayManuallyPaused: false,
                                isVideoChanging: false,
                                swiper: null,
                                xDown: null,
                                yDown: null,
                                xDiff: 0,
                                yDiff: 0,
                                touchStartTime: 0
                            };
                            
                            window.tetrInstances[instanceId] = instance;
                            
                            let container = null;

                            function isMobileDevice() {
                                return window.innerWidth <= 768 || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                            }

                            function updateSliderContent() {
                                if (!instance.swiper) return;

                                const contentContainer = container.closest('.startUpWrapBlock').querySelector('[data-tetr-content-container]');
                                if (!contentContainer) return;

                                const contentElements = contentContainer.querySelectorAll('.slider-content');
                                let activeIndex = instance.swiper.activeIndex;

                                if (instance.swiper.params.loop) {
                                    activeIndex = instance.swiper.realIndex;
                                }

                                contentElements.forEach(element => {
                                    element.classList.remove('active');
                                });

                                if (contentElements[activeIndex]) {
                                    contentElements[activeIndex].classList.add('active');
                                }
                            }

                            function togglePlayPause(videoId, posterId, buttonId) {
                                const video = document.getElementById(videoId);
                                const poster = document.getElementById(posterId);
                                const buttonIcon = document.getElementById(buttonId);

                                if (!video || !poster || !buttonIcon) return;

                                if (video.paused || video.ended) {
                                    pauseAllVideos();
                                    stopSwiperAutoplay();

                                    if (isMobileDevice()) {
                                        showVideoPopup(video.querySelector('source').src);
                                    } else {
                                        video.style.display = "block";
                                        poster.style.display = "none";
                                        video.play();
                                    }

                                    video.classList.add("playing");
                                    buttonIcon.src = "https://images.mastersunion.link/uploads/27062025/v1/MainButton4.svg";

                                    if (!isMobileDevice()) {
                                        video.onended = () => {
                                            resetVideoState(video, poster, buttonIcon);
                                            resumeSwiperAutoplay();
                                        };
                                    }
                                } else {
                                    resetVideoState(video, poster, buttonIcon);
                                    if (isMobileDevice()) {
                                        closeVideoPopup();
                                    }
                                    resumeSwiperAutoplay();
                                }
                            }

                            function showVideoPopup(videoUrl) {
                                if (!isMobileDevice()) return;

                                const popupId = `videoPopup_${instanceId}`;
                                let videoPopup = document.getElementById(popupId);

                                if (!videoPopup) {
                                    videoPopup = document.createElement('div');
                                    videoPopup.id = popupId;
                                    videoPopup.className = 'popup tetr-video-popup';
                                    videoPopup.setAttribute('data-instance-id', instanceId);
                                    videoPopup.innerHTML = `
            <div class="popupBody">
                <div class="floatingClose">
                    <img src="https://files.mastersunion.link/resources/svg/close.svg" alt="icon" onclick="window.tetrInstances['${instanceId}'].closePopup();">
                </div>
                <div class="video-navigation">
                    <div class="prev-video prev" id="prevVideo_${instanceId}">
                        <img src="https://images.mastersunion.link/uploads/20022025/v1/black_arrow.svg" class="" alt="Previous">
                    </div>
                    <div class="next-video" id="nextVideo_${instanceId}">
                        <img src="https://images.mastersunion.link/uploads/20022025/v1/black_arrow.svg" alt="Next">
                    </div>
                </div>
                <div class="video-container-wrapper">
                    <div class="custom-video-area" id="custom-video-player_${instanceId}">
                        <video class="iframeHero" controls autoplay playsinline>
                            <source src="${videoUrl}" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                    </div>
                    <div class="video-transition-overlay"></div>
                </div>
            </div>
        `;
                                    document.body.appendChild(videoPopup);

                                    document.getElementById(`prevVideo_${instanceId}`).addEventListener('click', function () {
                                        changeVideoWithAnimation('prev');
                                    });

                                    document.getElementById(`nextVideo_${instanceId}`).addEventListener('click', function () {
                                        changeVideoWithAnimation('next');
                                    });
                                } else {
                                    updatePopupVideo();
                                }

                                $(`#${popupId}`).addClass("active");
                                $("body").css("overflow", "hidden");
                                addVideoPopupSwipeControls();
                            }

                            function changeVideoWithAnimation(direction) {
                                if (!isMobileDevice()) return;
                                if (instance.isVideoChanging) return;
                                instance.isVideoChanging = true;

                                const popupId = `videoPopup_${instanceId}`;
                                const videoPopup = document.getElementById(popupId);
                                if (!videoPopup) return;

                                const videoContainer = videoPopup.querySelector('.video-container-wrapper');
                                const overlay = videoContainer.querySelector('.video-transition-overlay');

                                overlay.style.display = 'block';
                                overlay.style.opacity = '0';

                                requestAnimationFrame(() => {
                                    overlay.style.opacity = '1';

                                    setTimeout(() => {
                                        if (direction === 'next') {
                                            instance.swiper.slideNext();
                                        } else {
                                            instance.swiper.slidePrev();
                                        }

                                        updatePopupVideo();

                                        setTimeout(() => {
                                            overlay.style.opacity = '0';
                                            setTimeout(() => {
                                                overlay.style.display = 'none';
                                                instance.isVideoChanging = false;
                                            }, 300);
                                        }, 100);
                                    }, 300);
                                });
                            }

                            function updatePopupVideo() {
                                if (!isMobileDevice()) return;
                                if (!instance.swiper) return;

                                const activeSlide = instance.swiper.slides[instance.swiper.activeIndex];
                                const activeVideo = activeSlide.querySelector('.videoPlayLeft');
                                if (activeVideo) {
                                    const videoUrl = activeVideo.querySelector('source').src;
                                    const videoContainer = document.getElementById(`custom-video-player_${instanceId}`);
                                    if (videoContainer) {
                                        videoContainer.innerHTML = `
                <video class="iframeHero" controls autoplay playsinline>
                    <source src="${videoUrl}" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            `;
                                    }
                                }
                            }

                            function addVideoPopupSwipeControls() {
                                if (!isMobileDevice()) return;

                                const popupId = `videoPopup_${instanceId}`;
                                const popup = document.getElementById(popupId);
                                if (!popup) return;

                                popup.removeEventListener('touchstart', handleTouchStart);
                                popup.removeEventListener('touchmove', handleTouchMove);
                                popup.removeEventListener('touchend', handleTouchEnd);

                                popup.addEventListener('touchstart', handleTouchStart);
                                popup.addEventListener('touchmove', handleTouchMove);
                                popup.addEventListener('touchend', handleTouchEnd);
                            }

                            function handleTouchStart(evt) {
                                const firstTouch = evt.touches[0];
                                instance.xDown = firstTouch.clientX;
                                instance.yDown = firstTouch.clientY;
                                instance.touchStartTime = Date.now();
                                instance.xDiff = 0;
                                instance.yDiff = 0;
                            }

                            function handleTouchMove(evt) {
                                if (!instance.xDown || !instance.yDown) return;

                                const xUp = evt.touches[0].clientX;
                                const yUp = evt.touches[0].clientY;

                                instance.xDiff = instance.xDown - xUp;
                                instance.yDiff = instance.yDown - yUp;

                                if (Math.abs(instance.xDiff) > Math.abs(instance.yDiff)) {
                                    evt.preventDefault();
                                }
                            }

                            function handleTouchEnd(evt) {
                                if (!instance.xDown || !instance.yDown) return;

                                if (Math.abs(instance.xDiff) > Math.abs(instance.yDiff) && Math.abs(instance.xDiff) > 50) {
                                    const touchDuration = Date.now() - instance.touchStartTime;

                                    if (touchDuration < 300) {
                                        if (instance.xDiff > 0) {
                                            changeVideoWithAnimation('next');
                                        } else {
                                            changeVideoWithAnimation('prev');
                                        }
                                    }
                                }

                                instance.xDown = null;
                                instance.yDown = null;
                            }

                            function closeVideoPopup() {
                                if (!isMobileDevice()) return;

                                const popupId = `videoPopup_${instanceId}`;
                                const videoPopup = document.getElementById(popupId);
                                if (videoPopup) {
                                    const videoContainer = document.getElementById(`custom-video-player_${instanceId}`);

                                    const popupVideo = videoContainer ? videoContainer.querySelector('video') : null;
                                    if (popupVideo) {
                                        popupVideo.pause();
                                        popupVideo.currentTime = 0;
                                    }

                                    $(`#${popupId}`).removeClass("active");
                                    $("body").css("overflow", "visible");
                                }

                                pauseAllVideos();
                                resumeSwiperAutoplay();
                            }

                            instance.closePopup = closeVideoPopup;

                            function resetVideoState(video, poster, buttonIcon) {
                                video.pause();
                                video.currentTime = 0;
                                video.style.display = "none";
                                video.classList.remove("playing");
                                poster.style.display = "block";
                                buttonIcon.src = "https://images.mastersunion.link/uploads/16062025/v2/MainButton.svg";
                            }

                            function stopSwiperAutoplay() {
                                if (!instance.swiper) return;
                                instance.swiper.autoplay.stop();
                                instance.swiper.params.autoplay.disableOnInteraction = true;
                                instance.isAutoplayManuallyPaused = true;
                            }

                            function resumeSwiperAutoplay() {
                                if (!instance.swiper) return;
                                instance.swiper.params.autoplay.disableOnInteraction = false;
                                instance.swiper.autoplay.start();
                                instance.isAutoplayManuallyPaused = false;
                            }

                            function pauseAllVideos() {
                                const videos = container.querySelectorAll(".videoPlayLeft");
                                const posters = container.querySelectorAll(".videoPoster");
                                const buttons = container.querySelectorAll(".playButton");

                                videos.forEach((video) => {
                                    video.pause();
                                    video.currentTime = 0;
                                    video.style.display = "none";
                                    video.classList.remove("playing");
                                });

                                posters.forEach((poster) => {
                                    poster.style.display = "block";
                                });

                                buttons.forEach((button) => {
                                    button.src = "https://images.mastersunion.link/uploads/16062025/v2/MainButton.svg";
                                });
                            }

                            // Expose togglePlayPause globally with instance ID
                            window[`togglePlayPauseTetr_${instanceId}`] = togglePlayPause;

                            function init() {
                                // Find container if not already found
                                if (!container) {
                                    container = findAndInitContainer();
                                    if (!container) {
                                        console.warn('TetrDSAI: Container not found for instance', instanceId);
                                        return;
                                    }
                                }
                                
                                // Verify container is still valid and not already initialized by another instance
                                if (container.hasAttribute('data-instance-id') && container.getAttribute('data-instance-id') !== instanceId) {
                                    console.warn('TetrDSAI: Container already initialized by another instance');
                                    // Try to find another uninitialized container
                                    container = findAndInitContainer();
                                    if (!container) return;
                                }
                                
                                // Ensure container is marked with this instance ID
                                if (!container.hasAttribute('data-instance-id')) {
                                    container.setAttribute('data-instance-id', instanceId);
                                }
                                
                                // Debug log (can be removed in production)
                                if (window.DEBUG_TETR) {
                                    console.log('TetrDSAI: Initializing instance', instanceId, 'with container', container);
                                }
                                
                                const names = [
                                    {
                                        name: "/20072025/v2/image20250720T201044.121",
                                        url: "https://files.mastersunion.link/gif/1stv.mp4",
                                    },
                                    {
                                        name: "/20072025/v1/tprojects61",
                                        url: "https://files.mastersunion.link/gif/lastvid3.mp4",
                                    },
                                    {
                                        name: "/24072025/v1/tprojects62",
                                        url: "https://files.mastersunion.link/gif/24072025/v1/videoplayback.mp4",
                                    },
                                    {
                                        name: "/20072025/v2/image20250720T201156.093",
                                        url: "https://files.mastersunion.link/gif/3rdv.mp4",
                                    },
                                    {
                                        name: "/16092025/v1/Frame1618873475",
                                        url: "https://files.mastersunion.link/uploads/16092025/v1/ashwin.mp4",
                                    },
                                    {
                                        name: "/13012026/v2/arjunImg",
                                        url: "https://files.mastersunion.link/uploads/13012026/v1/arjun.mp4",
                                    },
                                ];

                                const mappedArray = names.map((item, index) => ({
                                    img: `https://images.mastersunion.link/uploads${item.name}.webp`,
                                    url: item.url,
                                    index,
                                }));

                                const nameList = container.querySelector('[data-tetr-name-list]');
                                if (!nameList) return;

                                mappedArray.forEach((item, index) => {
                                    const videoId = `videoPlay_${instanceId}_${index}`;
                                    const posterId = `postervideo_${instanceId}_${index}`;
                                    const buttonId = `buttonIcon_${instanceId}_${index}`;

                                    const slide = document.createElement("div");
                                    slide.classList.add("swiper-slide");
                                    slide.innerHTML = `
            <video playsinline class="videoPlayLeft" id="${videoId}" style="display: none;">
                <source src="${item.url}" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            <img id="${posterId}" class="videoPoster" src="${item.img}" alt="">
            <span class="floatingButton">
                <img class="playButton" onclick="window.tetrInstances['${instanceId}'].togglePlayPause('${videoId}', '${posterId}', '${buttonId}')" id="${buttonId}"
                src="https://images.mastersunion.link/uploads/16062025/v2/MainButton.svg" alt="">
            </span>
        `;
                                    nameList.appendChild(slide);
                                });

                                instance.swiper = new Swiper(container, {
                                    loop: true,
                                    centeredSlides: true,
                                    slidesPerView: 1.2,
                                    spaceBetween: 0,
                                    initialSlide: 3,
                                    autoplay: {
                                        delay: 3000,
                                        disableOnInteraction: false,
                                    },
                                    on: {
                                        slideChange: () => {
                                            pauseAllVideos();
                                            updateSliderContent();

                                            const popupId = `videoPopup_${instanceId}`;
                                            const videoPopup = document.getElementById(popupId);
                                            if (isMobileDevice() && videoPopup && videoPopup.classList.contains('active') && !instance.isVideoChanging) {
                                                updatePopupVideo();
                                            }
                                        },
                                        slideChangeTransitionEnd: () => {
                                            updateSliderContent();
                                        },
                                        touchEnd: () => {
                                            const popupId = `videoPopup_${instanceId}`;
                                            const videoPopup = document.getElementById(popupId);
                                            if (!isMobileDevice() || !videoPopup || !videoPopup.classList.contains('active')) {
                                                resumeSwiperAutoplay();
                                            }
                                        },
                                    },
                                });

                                // Verify swiper was initialized
                                if (!instance.swiper) {
                                    console.error('TetrDSAI: Failed to initialize Swiper for instance', instanceId);
                                    return;
                                }

                                if (window.DEBUG_TETR) {
                                    console.log('TetrDSAI: Swiper initialized successfully for instance', instanceId);
                                }

                                setTimeout(() => {
                                    updateSliderContent();
                                }, 100);

                                const mobileBtn = container.closest('.startUpWrapBlock').querySelector('[data-tetr-play-mobile]');
                                if (mobileBtn) {
                                    mobileBtn.addEventListener("click", function () {
                                        const activeSlide = instance.swiper.slides[instance.swiper.activeIndex];
                                        const video = activeSlide.querySelector(".videoPlayLeft");
                                        const poster = activeSlide.querySelector(".videoPoster");
                                        const buttonIcon = activeSlide.querySelector(".playButton");

                                        if (video && video.paused) {
                                            pauseAllVideos();
                                            stopSwiperAutoplay();

                                            if (isMobileDevice()) {
                                                showVideoPopup(video.querySelector('source').src);
                                            } else {
                                                video.style.display = "block";
                                                poster.style.display = "none";
                                                video.play();

                                                video.onended = () => {
                                                    resetVideoState(video, poster, buttonIcon);
                                                    resumeSwiperAutoplay();
                                                };
                                            }

                                            video.classList.add("playing");
                                            buttonIcon.src = "https://images.mastersunion.link/uploads/27062025/v1/MainButton4.svg";
                                        }
                                    });
                                }

                                const desktopBtn = container.closest('.startUpWrapBlock').querySelector('[data-tetr-play-desktop]');
                                if (desktopBtn) {
                                    desktopBtn.addEventListener("click", function () {
                                        const activeSlide = instance.swiper.slides[instance.swiper.activeIndex];
                                        const video = activeSlide.querySelector(".videoPlayLeft");
                                        const poster = activeSlide.querySelector(".videoPoster");
                                        const buttonIcon = activeSlide.querySelector(".playButton");

                                        if (video && video.paused) {
                                            pauseAllVideos();
                                            stopSwiperAutoplay();

                                            video.style.display = "block";
                                            poster.style.display = "none";
                                            video.play();

                                            video.onended = () => {
                                                resetVideoState(video, poster, buttonIcon);
                                                resumeSwiperAutoplay();
                                            };

                                            video.classList.add("playing");
                                            buttonIcon.src = "https://images.mastersunion.link/uploads/27062025/v1/MainButton4.svg";
                                        }
                                    });
                                }

                                // Add CSS only once
                                if (!document.getElementById('tetr-video-styles')) {
                                    const style = document.createElement('style');
                                    style.id = 'tetr-video-styles';
                                    style.textContent = `
        @media (max-width: 768px) {
            .tetr-video-popup .video-navigation {
                position: absolute;
                width: 110%;
                height: 100%;
                top: 0;
                left: -5%;
                z-index: 10;
                pointer-events: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            
            .tetr-video-popup .prev-video,
            .tetr-video-popup .next-video {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                pointer-events: auto;
                transition: all 0.3s ease;
            }
            
            .tetr-video-popup .prev-video img,
            .tetr-video-popup .next-video img {
                width: 90%;
                opacity: 0.8;
            }
            
            .tetr-video-popup .video-container-wrapper {
                position: relative;
                width: 100%;
                height: 100%;
            }
            
            .tetr-video-popup .video-transition-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.7);
                display: none;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 5;
            }
            
            @keyframes swipeHint {
                0% { transform: translateX(0); opacity: 0.7; }
                50% { transform: translateX(-20px); opacity: 1; }
                100% { transform: translateX(0); opacity: 0.7; }
            }
            
            .tetr-video-popup .popupBody::after {
                content: 'Swipe to navigate';
                position: absolute;
                bottom: 20px;
                left: 50%;
                transform: translateX(-50%);
                color: white;
                padding: 8px 16px;
                border-radius: 20px;
                font-size: 14px;
                opacity: 0.7;
                animation: swipeHint 2s infinite;
                pointer-events: none;
                z-index: 20;
            }
        }
        
        @media (min-width: 769px) {
            .tetr-video-popup {
                display: none !important;
            }
        }
        
        .slider-content {
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            position: absolute;
            top: 0;
            left: 0;
