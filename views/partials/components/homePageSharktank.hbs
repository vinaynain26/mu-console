<script>
    (function () {
        const COMPONENT_SELECTOR = '.sharkiTop';
        const DESKTOP_SWIPER_SELECTOR = '.mob-hide .swiper-container';
        const INIT_ATTR = 'data-sharktank-initialized';
        const VISIBLE_BULLETS_LIMIT = 6;

        function updatePaginationActive(swiper, visibleBulletsCount) {
            const pagination = swiper.pagination;
            if (!pagination || !pagination.bullets || !pagination.bullets.length) {
                return;
            }

            for (let i = 0; i < visibleBulletsCount; i++) {
                if (pagination.bullets[i]) {
                    pagination.bullets[i].classList.remove('swiper-pagination-bullet-active');
                }
            }

            const bulletIndex = ((swiper.realIndex % visibleBulletsCount) + visibleBulletsCount) % visibleBulletsCount;
            if (pagination.bullets[bulletIndex]) {
                pagination.bullets[bulletIndex].classList.add('swiper-pagination-bullet-active');
            }
        }

        function initDesktopSwiper(component) {
            if (!component || component.getAttribute(INIT_ATTR) === 'true') {
                return;
            }

            const sliderEl = component.querySelector(DESKTOP_SWIPER_SELECTOR);
            if (!sliderEl || sliderEl.classList.contains('swiper-container-initialized')) {
                component.setAttribute(INIT_ATTR, 'true');
                return;
            }

            const paginationEl = sliderEl.querySelector('.swiper-pagination');
            const totalSlides = sliderEl.querySelectorAll('.swiper-wrapper > .swiper-slide').length;
            const uniqueSlides = Math.max(1, Math.floor(totalSlides / 3));
            const visibleBulletsCount = Math.min(uniqueSlides, VISIBLE_BULLETS_LIMIT);
            const initialSlide = uniqueSlides + 2;

            const nextEl = component.querySelector('.s-next');
            const prevEl = component.querySelector('.s-prev');

            const swiperConfig = {
                slidesPerView: 3,
                loop: true,
                loopedSlides: uniqueSlides,
                loopAdditionalSlides: uniqueSlides,
                centeredSlides: true,
                spaceBetween: 40,
                initialSlide: initialSlide,
                speed: 800,
               autoplay: {
                   delay: 2000,
                   disableOnInteraction: false,
                   pauseOnMouseEnter: true
               },
                pagination: {
                    el: paginationEl,
                    clickable: true,
                    type: 'bullets',
                    dynamicBullets: false
                },
                on: {
                    init: function () {
                        const swiper = this;
                        const pagination = swiper.pagination;

                        if (pagination && pagination.bullets) {
                            pagination.bullets.forEach(function (bullet, index) {
                                if (index >= visibleBulletsCount) {
                                    bullet.style.display = 'none';
                                    return;
                                }

                                bullet.setAttribute('data-rel', index);
                                bullet.onclick = null;
                                bullet.addEventListener('click', function (event) {
                                    event.preventDefault();
                                    event.stopPropagation();

                                    const currentBulletIndex = parseInt(this.getAttribute('data-rel'), 10);
                                    if (!Number.isNaN(currentBulletIndex)) {
                                        swiper.slideToLoop(currentBulletIndex);
                                    }
                                    return false;
                                }, true);
                            });
                        }

                        setTimeout(function () {
                            updatePaginationActive(swiper, visibleBulletsCount);
                        }, 100);
                    },
                    slideChange: function () {
                        updatePaginationActive(this, visibleBulletsCount);
                    },
                    slideChangeTransitionEnd: function () {
                        updatePaginationActive(this, visibleBulletsCount);
                    },
                    realIndexChange: function () {
                        updatePaginationActive(this, visibleBulletsCount);
                    }
                },
                breakpoints: {
                    0: {
                        slidesPerView: 1.1
                    },
                    768: {
                        slidesPerView: 1.1
                    },
                    1024: {
                        slidesPerView: 3.4
                    },
                    1366: {
                        slidesPerView: 3.4
                    },
                    1440: {
                        slidesPerView: 3.4
                    },
                    1600: {
                        slidesPerView: 3.8
                    },
                    1920: {
                        slidesPerView: 3.8
                    }
                }
            };

            if (nextEl && prevEl) {
                swiperConfig.navigation = {
                    nextEl: nextEl,
                    prevEl: prevEl
                };
            }

            new Swiper(sliderEl, swiperConfig);
            component.setAttribute(INIT_ATTR, 'true');
        }

        document.querySelectorAll(COMPONENT_SELECTOR).forEach(function (component) {
            initDesktopSwiper(component);
        });
    })();
</script>