                    width: 1200px;
                    gap: 20px;
                    /*border-bottom: 1px solid var(--grey3);                                                                           
                    padding-bottom: 40px;*/
                }

                .stateContent {
                    display: flex;
                    flex-direction: column;
                    gap: 20px;
                    width: fit-content;
                    /* dynamic width based on cards */
                    flex-shrink: 0;
                }

