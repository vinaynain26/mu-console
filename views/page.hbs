<script>
    $(document).ready(function () {
        // Detect viewport width
        var viewportWidth = $(window).width();

        // -------- CLICK HANDLER (Scroll to #toTop3) --------
        $('.seondtabs li').on('click', function (e) {
            e.preventDefault();

            // Default offset
            var offsetValue = 80;

            $('html, body').animate({
                scrollTop: $('#toTop3').offset().top - offsetValue
            }, 800);
        });


        // -------- SCROLL HANDLER (Sticky Apply Btn) --------
        $(window).on('scroll', function () {
            var stickyHeaderOffset = $('#stickyHeader').offset().top;
            var scrollPosition = $(window).scrollTop();

            // Default threshold
            var triggerOffset = 48;

            // For small screens, tweak trigger
            if (viewportWidth >= 320 && viewportWidth <= 390) {
                triggerOffset = 30; // earlier trigger on small screens
            }

            if (scrollPosition >= stickyHeaderOffset - triggerOffset) {
                $('#secontnavApplyBtn').removeClass('stickyBtnHidden');
            } else {
                $('#secontnavApplyBtn').addClass('stickyBtnHidden');
            }
        });
    });
</script>

