        <script>
            document.addEventListener('DOMContentLoaded', function () {

                const section = document.getElementById('immersionDeckSection');
                const arcFill = document.getElementById('immersionDeckArcFill');
                const cards = [...document.querySelectorAll('.immersionDeckCard')];
                const flows = [...document.querySelectorAll('.immersionDeckFlow')];
                const texts = [...document.querySelectorAll('.immersionDeckText')];
                const content = document.getElementById('immersionDeckContent');

                if (!section || !arcFill || typeof gsap === 'undefined') return;

                gsap.registerPlugin(ScrollTrigger);

                /* ── Scale content to fit viewport ── */
                function scaleImmersionDeck() {
                    const viewportH = window.innerHeight;
                    const headerEl = document.querySelector('.immersionDeckHeader');
                    const headerH = headerEl ? headerEl.offsetHeight + 80 : 140;
                    const availableH = viewportH - headerH;
                    const scale = Math.min(1, availableH / 700);
                    const deadSpace = 700 - 700 * scale;

                    content.style.transform = `scale(${scale})`;
                    content.style.transformOrigin = 'bottom center';
                    content.style.marginTop = `-${deadSpace}px`;
                    content.style.marginBottom = '0px';
                }

                scaleImmersionDeck();

                let resizeTimer;
                window.addEventListener('resize', () => {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(() => {
                        scaleImmersionDeck();
                        ScrollTrigger.refresh();
                    }, 150);
                });

                /* ── Arc setup ── */
                const arcLen = arcFill.getTotalLength();
                arcFill.style.strokeDasharray = arcLen;
                arcFill.style.strokeDashoffset = arcLen;

                /* ── Reset all to initial hidden state ── */
                gsap.set('.immersionDeckHeader', { opacity: 0, y: 24, filter: 'blur(8px)' });
                gsap.set(cards, { opacity: 0 });
                gsap.set(flows, { opacity: 0 });
                gsap.set(texts, { opacity: 0, y: 20, filter: 'blur(6px)' });

                cards.forEach(c => c.classList.remove('active'));
                flows.forEach(f => f.classList.remove('active'));

                /* ── Entry animation ── */
                let entryDone = false;

                const entryTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: section,
                        start: 'top 50%',
                        once: true,
                    },
                    onComplete: () => { entryDone = true; }
                });

                entryTl
                    .to('.immersionDeckHeader', {
                        opacity: 1, y: 0, filter: 'blur(0px)',
                        duration: 1.2, ease: 'power2.out',
                    })
                    .to(cards, {
                        opacity: 1, duration: 0.75, stagger: 0.18, ease: 'power2.out',
                    }, '-=1.1')
                    .to(flows, {
                        opacity: 1, duration: 0.9, stagger: 0.14, ease: 'power2.out',
                    }, '-=0.5')
                    .to(texts, {
                        opacity: 1, y: 0, filter: 'blur(0px)',
                        duration: 0.9, stagger: 0.14, ease: 'power2.out',
                    }, '-=0.4');

                /* ── Progress applicator ── */
                let lastOffset = -1;
                let lastActiveIndex = -2;

                function applyProgress(p) {
                    p = Math.max(0, Math.min(1, p));

                    /* Only write the SVG offset when it changes by a visible amount */
                    const offset = Math.round(arcLen * (1 - p));
                    if (offset !== lastOffset) {
                        arcFill.style.strokeDashoffset = offset;
                        lastOffset = offset;
                    }

                    /* Only touch the DOM classes when the active card actually changes */
                    const activeIndex = Math.min(Math.floor(p * 4), 3);
                    if (activeIndex !== lastActiveIndex) {
                        lastActiveIndex = activeIndex;
                        cards.forEach((card, i) => card.classList.toggle('active', i <= activeIndex));
                        flows.forEach((flow, i) => flow.classList.toggle('active', i <= activeIndex));
                    }
                }

                /* ── Scrub trigger ── */
                const scrubST = ScrollTrigger.create({
                    trigger: section,
                    start: 'top top',
                    end: 'bottom bottom',
                    scrub: 1,
                    onUpdate: (self) => {
                        applyProgress(self.progress);
                    }
                });

                /* ── Recalculate positions once late-loading images change layout ── */
                function refreshImmersionDeck() {
                    scaleImmersionDeck();
                    ScrollTrigger.refresh();
                }

                window.addEventListener('load', refreshImmersionDeck);

                flows.forEach(flow => {
                    const img = flow.querySelector('img');
                    if (img && !img.complete) {
                        img.addEventListener('load', refreshImmersionDeck, { once: true });
                    }
                });

                function restoreImmersionDeckOnTabVisible() {
                    lastOffset = -1;
                    lastActiveIndex = -2;

                    if (entryDone) {
                        gsap.set(cards, { opacity: 1 });
                        gsap.set(flows, { opacity: 1 });
                        gsap.set(texts, { opacity: 1, y: 0, filter: 'blur(0px)' });
                        gsap.set('.immersionDeckHeader', { opacity: 1, y: 0, filter: 'blur(0px)' });
                    }

                    requestAnimationFrame(() => {
                        ScrollTrigger.refresh();
                        applyProgress(scrubST.progress);
                    });
                }

                document.addEventListener('visibilitychange', () => {
                    if (document.hidden) return;
                    restoreImmersionDeckOnTabVisible();
                });

                window.addEventListener('pageshow', (e) => {
                    if (!e.persisted) return;
                    restoreImmersionDeckOnTabVisible();
                });

            });
        </script>

        
