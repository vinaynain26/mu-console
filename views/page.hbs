    ];

    async function getPgpRiseStudents() {
        const res = await fetch("https://api.mastersunion.org/api/getPgpRiseProfiles");
        students = await res.json();
        students_RiseCohort1 = students.filter(s => s.cohort === "1").sort((a, b) => a.display_index - b.display_index);
        students_RiseCohort2 = students.filter(s => s.cohort === "2").sort((a, b) => a.display_index - b.display_index);
        students_RiseCohort3 = students.filter(s => s.cohort === "3").sort((a, b) => a.display_index - b.display_index);
        bindPGPStudents();
        $("#loadMorePgpDiv").removeClass("hide");


    }

    var device;

    if (window.innerWidth < 767) {
        device = 1800;
    } else if (window.innerWidth > 787) {
        device = 1100;
