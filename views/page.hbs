        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Check if device is mobile
                const isMobile = window.innerWidth <= 768 || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

                if (!isMobile) return; // Exit if not mobile

                const stickWrapper = document.querySelector('.stickWrapper');
                const progressBar = document.querySelector('.custom-progressMob');
                const dots = document.querySelectorAll('.custom-dotMob');
                const dotContentTexts = document.querySelectorAll('.dotContentTextMob');
                const stickSection = document.querySelector('.stickSection');

                if (!stickWrapper || !progressBar || !stickSection) return;

                // Initialize progress bar to 0
                progressBar.style.width = '0%';

                // Remove initial active classes
                dots.forEach(dot => {
                    dot.classList.remove('active', 'passed');
                });
                dotContentTexts.forEach(text => {
                    text.classList.remove('active');
                });

                // Calculate total scrollable width
                const totalScrollWidth = stickWrapper.scrollWidth - stickWrapper.clientWidth;

                // Variables for scroll tracking
                let isHorizontalScrollComplete = false;

                // Function to update progress bar
                function updateProgressBar() {
                    const scrollLeft = stickWrapper.scrollLeft;
                    const scrollPercentage = (scrollLeft / totalScrollWidth) * 100;

                    // Update progress bar width (start from 0)
                    progressBar.style.width = Math.min(scrollPercentage, 100) + '%';

                    // Check if horizontal scroll is complete (95% threshold for better UX)
                    isHorizontalScrollComplete = scrollPercentage >= 95;

                    // Calculate dot positions based on progress bar width
                    const progressBarWidth = parseFloat(progressBar.style.width);
                    const dotPositions = [0, 25, 50, 75]; // 4 dots at 0%, 25%, 50%, 75%

                    // Update dots based on progress bar reaching them
                    dots.forEach((dot, index) => {
                        dot.classList.remove('active', 'passed');

                        // If progress bar has reached or passed this dot position
                        // For first dot, only add passed class if progress is above 0%
                        if (progressBarWidth >= dotPositions[index]) {
                            if (index === 0 && progressBarWidth > 0) {
                                dot.classList.add('passed');
                            } else if (index > 0) {
                                dot.classList.add('passed');
                            }
                        }

                        // If progress bar is exactly at this dot position (with small tolerance)
                        if (progressBarWidth >= dotPositions[index] - 2 && progressBarWidth < dotPositions[index] + 2) {
                            // For first dot (index 0), only activate if progress is above 0%
                            if (index === 0 && progressBarWidth > 0) {
                                dot.classList.add('active');
                            } else if (index > 0) {
                                dot.classList.add('active');
                            }
                        }
                    });

                    // Update content text based on which section we're in
                    // Only activate text when progress bar reaches the corresponding dot
                    dotContentTexts.forEach((text, index) => {
                        text.classList.remove('active');
                        // Only activate if progress bar has reached this dot position
                        // For first text, only activate if progress is above 0%
                        if (progressBarWidth >= dotPositions[index]) {
                            if (index === 0 && progressBarWidth > 0) {
                                text.classList.add('active');
                            } else if (index > 0) {
                                text.classList.add('active');
                            }
                        }
                    });
                }


                // Listen for scroll events
                stickWrapper.addEventListener('scroll', updateProgressBar);

                // Listen for tab visibility changes
                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden) {
                        // Tab became visible, update progress bar
                        updateProgressBar();
                    }
                });

                // Listen for window focus
                window.addEventListener('focus', updateProgressBar);

                // Add click functionality to dots
                dots.forEach((dot, index) => {
                    dot.addEventListener('click', function () {
                        const targetPercentage = (index * 25); // 0%, 25%, 50%, 75%
                        const targetScrollLeft = (targetPercentage / 100) * totalScrollWidth;

                        stickWrapper.scrollTo({
                            left: targetScrollLeft,
                            behavior: 'smooth'
                        });
                    });
                });

                // Initialize on load
                updateProgressBar();
            });
        </script>

