            <script>
                (function () {
                    // Only run for desktop/web view (> 1024px)
                    if (window.innerWidth <= 1024) return;

                    // Get all relevant elements
                    const wrapper = document.getElementById('placeAccordion');
                    if (!wrapper) return;
                    const images = wrapper.querySelectorAll('.placeImageWrapper .placeImage');
                    const details = wrapper.querySelectorAll('.placeDetailWrapper .placeDetail');
                    const uppers = wrapper.querySelectorAll('.placeDetail .placeUpper');
                    const accContents = wrapper.querySelectorAll('.placeDetail .placeAccodianContent');

                    function setActive(idx) {
                        // Remove all actives
                        images.forEach((img, i) => {
                            if (i === idx) {
                                img.classList.add('active');
                                img.style.display = 'block';
                                // Fade in
                                setTimeout(() => {
                                    img.style.opacity = '1';
                                    img.style.zIndex = '2';
                                }, 10);
                            } else {
                                img.classList.remove('active');
                                img.style.opacity = '0';
                                img.style.zIndex = '1';
                                setTimeout(() => {
                                    img.style.display = 'none';
                                }, 400);
                            }
                        });
                        details.forEach((det, i) => {
                            det.classList.toggle('active', i === idx);
                        });
                        accContents.forEach((acc, i) => {
                            if (i === idx) {
                                acc.style.display = 'block';
                                acc.style.maxHeight = acc.scrollHeight + 'px';
                            } else {
                                acc.style.maxHeight = '0';
                                setTimeout(() => { acc.style.display = 'none'; }, 400);
                            }
                        });
                    }

                    // Initial state: first active
                    setActive(0);

                    // Click handlers
                    uppers.forEach((upper, idx) => {
                        upper.addEventListener('click', function () {
                            const isActive = details[idx].classList.contains('active');
                            if (isActive) {
                                // If closing all, reopen first
                                let anyOpen = false;
                                details.forEach((d, i) => {
                                    if (i !== idx && d.classList.contains('active')) anyOpen = true;
                                });
                                if (anyOpen) {
                                    setActive(idx);
                                } else {
                                    setActive(0);
                                }
                            } else {
                                setActive(idx);
                            }
                        });
                    });

                    // Handle window resize
                    window.addEventListener('resize', function () {
                        if (window.innerWidth <= 1024) {
                            // Reset all states when switching to mobile
                            images.forEach(img => {
                                img.style.display = '';
                                img.style.opacity = '';
                                img.style.zIndex = '';
                                img.classList.remove('active');
                            });
                            details.forEach(det => det.classList.remove('active'));
                            accContents.forEach(acc => {
                                acc.style.display = '';
                                acc.style.maxHeight = '';
                            });
                        } else {
                            // Reinitialize for desktop
                            setActive(0);
                        }
                    });
                })();
            </script>

        </section>
