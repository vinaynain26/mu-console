    $(".faqtabs li").click(function () {
        let id = $(this).attr('data-rel')
        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');

        let cohort = $(this).attr('data-cohort');
        if (cohort) {
            currentActiveCohort = cohort;

            if (cohort === "1") {
                if (cohort1ActiveIndex < students_RiseCohort1.length) {
                    $("#loadMoreCohortBtn").show();
                }
            } else if (cohort === "2") {
                if (cohort2ActiveIndex < students_RiseCohort2.length) {
                    $("#loadMoreCohortBtn").show();
                }
            }
            else if (cohort === "3") {
                if (cohort3ActiveIndex < students_RiseCohort3.length) {
                    $("#loadMoreCohortBtn").show();
                }
            }
        }

    });

    setTimeout(function () {
        if (isCountryCodeFound) {
            $("#faqsTabs li").not('.hideFortheMENA.hide').first().addClass('active').siblings().removeClass('active');
            let activeId = $("#faqsTabs li").not('.hideFortheMENA.hide').first().attr('data-rel');
            $(`#${activeId}`).addClass('active').siblings().removeClass('active');
        }
    }, 2000)


    $(".navigationBox .courseName").click(function () {
        let id = $(this).attr('data-rel')
        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');

