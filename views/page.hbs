        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');

    });

    function openTab(tag, tab) {
        // Get the target element's position
        let scrollTarget = $("#" + tag).offset().top;

        // Adjust for fixed header if needed (assuming header height is 80px)
        scrollTarget = scrollTarget - 80;

        $('html, body').animate({
            scrollTop: scrollTarget
        }, 1000);

        history.pushState(null, "", `/${tab}`);
        updateUrlWithUtm();
    };


