            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const tabs = document.querySelectorAll(".getpreppedTabs li");
                    const container = document.getElementById("horizontalContainer");
                    const leftBtn = document.querySelector(".scroll-btn.left");
                    const rightBtn = document.querySelector(".scroll-btn.right");
                    const sections = document.querySelectorAll(".stateContent");

                    if (!tabs.length || !container || !leftBtn || !rightBtn) return;

                    let isProgrammaticScroll = false;
                    let scrollEndTimer;

                    function getSectionScrollLeft(section) {
                        return section.offsetLeft - container.offsetLeft;
                    }

                    function updateScrollButtons() {
                        leftBtn.classList.toggle("active", container.scrollLeft > 0);
                        rightBtn.classList.toggle(
                            "active",
                            Math.ceil(container.scrollLeft + container.clientWidth) < container.scrollWidth
                        );
                    }

                    function scrollToSection(sectionId) {
                        const target = document.getElementById(sectionId);
                        if (!target) return;

                        isProgrammaticScroll = true; // disable scroll listener
                        container.scrollTo({ left: getSectionScrollLeft(target), behavior: "smooth" });

                        const cardsContainer = target.querySelector(".cardsContainer");
                        if (cardsContainer) cardsContainer.scrollTo({ left: 0, behavior: "smooth" });

                        // Scroll end detection - wait until scrolling stops
                        clearTimeout(scrollEndTimer);
                        scrollEndTimer = setTimeout(() => {
                            isProgrammaticScroll = false; // enable scroll listener again
                            updateScrollButtons();
                        }, 300); // will reset if scroll keeps happening
                    }

                    tabs.forEach(tab => {
                        tab.addEventListener("click", function () {
                            tabs.forEach(t => t.classList.remove("active"));
                            tab.classList.add("active");
                            scrollToSection(tab.dataset.rel);
                        });
                    });

                    leftBtn.addEventListener("click", function () {
                        container.scrollBy({ left: -550, behavior: "smooth" });
                        setTimeout(updateScrollButtons, 250);
                    });

                    rightBtn.addEventListener("click", function () {
                        container.scrollBy({ left: 550, behavior: "smooth" });
                        setTimeout(updateScrollButtons, 250);
                    });

                    container.addEventListener("scroll", function () {
                        if (isProgrammaticScroll) {
                            // reset scrollEndTimer every time scroll fires
                            clearTimeout(scrollEndTimer);
                            scrollEndTimer = setTimeout(() => {
                                isProgrammaticScroll = false; // enable scroll listener after scroll really ends
                                updateScrollButtons();
                            }, 150); // wait until no scroll for 150ms
                            return;
                        }

                        let scrollLeft = container.scrollLeft;
                        let activeSection = null;

                        sections.forEach(section => {
                            const sectionLeft = getSectionScrollLeft(section);
                            // Modified logic: Change tab when scrolling left and reaching 50px from left edge
                            if (scrollLeft >= sectionLeft - 150) {
                                activeSection = section;
                            }
                        });

                        if (activeSection) {
                            tabs.forEach(t => t.classList.remove("active"));
                            const activeTab = document.querySelector(`.getpreppedTabs li[data-rel="${activeSection.id}"]`);
                            if (activeTab) {
                                activeTab.classList.add("active");
                                // Center the newly active tab in viewport on mobile
                                if (window.innerWidth <= 767) {
                                    activeTab.scrollIntoView({
                                        behavior: "smooth",
                                        inline: "center",
                                        block: "nearest"
                                    });
                                }
                            }
                        }

                        updateScrollButtons();
                    });

                    let initialTab = document.querySelector(".getpreppedTabs li.active");
                    if (initialTab) {
                        scrollToSection(initialTab.dataset.rel);
                    } else if (tabs.length) {
                        tabs[0].classList.add("active");
                        scrollToSection(tabs[0].dataset.rel);
                    } else {
                        updateScrollButtons();
                    }

                    window.addEventListener("resize", function () {
                        let activeTab = document.querySelector(".getpreppedTabs li.active");
                        if (activeTab) scrollToSection(activeTab.dataset.rel);
                    });
                });
            </script>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (window.innerWidth > 767) return; // Only run on mobile

                    const tabs = document.querySelectorAll('.getpreppedTabs li');
                    const container = document.querySelector('.getpreppedTabs');

                    function scrollActiveIntoView(tab) {
                        // Smoothly scroll active tab into view (centered)
                        tab.scrollIntoView({
                            behavior: "smooth",
                            inline: "center",
                            block: "nearest"
                        });
                    }

                    function centerActiveTab() {
                        // Always center the active tab in viewport
                        const activeTab = document.querySelector('.getpreppedTabs li.active');
                        if (activeTab) {
                            scrollActiveIntoView(activeTab);
                        }
                    }

                    // On click make tab active + scroll it into view
                    tabs.forEach(tab => {
                        tab.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();

                            // Remove active from all tabs
                            tabs.forEach(t => t.classList.remove('active'));
                            // Add active to clicked tab
                            tab.classList.add('active');

                            // Immediately scroll clicked tab into view
                            scrollActiveIntoView(tab);
                        });
                    });

                    // Watch for scroll events to keep active tab centered
                    let scrollDebounce = null;
                    window.addEventListener('scroll', () => {
                        if (scrollDebounce) clearTimeout(scrollDebounce);

                        scrollDebounce = setTimeout(() => {
                            // Always center the active tab when tabs section is visible
                            if (container) {
                                const rect = container.getBoundingClientRect();
                                // Center tab if tabs section is in viewport (even partially)
                                if (rect.top < window.innerHeight && rect.bottom > 0) {
                                    centerActiveTab();
                                }
                            }
                        }, 100);
                    });
                });
            </script>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const hovers = document.querySelectorAll(".videoHover");

                    hovers.forEach(el => {
                        const id = el.dataset.videoId;
                        const box = el.querySelector(".imageBoxi");
                        const thumb = box.querySelector("img");
                        let iframe, overlay;

                        function createIframe() {
                            if (iframe) return;

                            // YouTube embed with NO UI
                            const src = `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&modestbranding=1&iv_load_policy=3&rel=0&fs=0&cc_load_policy=0&disablekb=1`;

                            // Ensure box is positioned for absolute children
                            box.style.position = "relative";

                            // Create iframe
                            iframe = document.createElement("iframe");
                            iframe.src = src;
                            iframe.allow = "autoplay; fullscreen";
                            iframe.setAttribute("frameborder", "0");
                            iframe.style.position = "absolute";
                            iframe.style.top = "0";
                            iframe.style.left = "0";
                            iframe.style.width = "100%";
                            iframe.style.height = "100%";
                            iframe.style.opacity = "0";
                            iframe.style.transition = "opacity 0.3s ease";
                            iframe.style.zIndex = "0"; // stays behind overlay & content
                            iframe.style.pointerEvents = "none";
                            // Create black overlay
                            overlay = document.createElement("div");
                            overlay.style.position = "absolute";
                            overlay.style.top = "0";
                            overlay.style.left = "0";
                            overlay.style.width = "100%";
                            overlay.style.height = "100%";
                            // overlay.style.background = "rgba(0, 0, 0, 0.45)"; // dark overlay
                            overlay.style.zIndex = "1"; // sits above iframe but under content
                            overlay.style.pointerEvents = "none";


                            iframe.addEventListener("load", () => {
                                iframe.style.opacity = "1";
                                thumb.style.opacity = "0"; // fade out static image
                            });

                            // Insert in correct order: iframe -> overlay -> existing content
                            box.insertBefore(iframe, box.firstChild);
                            box.insertBefore(overlay, box.firstChild.nextSibling);
                        }

                        function removeIframe() {
                            if (iframe) {
                                iframe.remove();
                                iframe = null;
                                thumb.style.opacity = "1";
                            }
                            if (overlay) {
                                overlay.remove();
                                overlay = null;
                            }
                        }

                        el.addEventListener("mouseenter", createIframe);
                        el.addEventListener("mouseleave", removeIframe);
                    });
                });
            </script>


