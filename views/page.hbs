    let students_RiseCohort1 = [];
    let students_RiseCohort2 = [];
    let students_RiseCohort3 = [];

    getPgpRiseStudents();

    const pgpRiseStudentsToKeepInLast = [
        "662f429939437b7d0a2dc7de",
        "662f429939437b7d0a2dc7d1",
