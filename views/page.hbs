        if (pgpRiseMasters.length === 0) return;
        currentPagePGPRise++;
        loadAndBindMastersPGPRise(currentPagePGPRise);
    });


    function loadMorePgpStudents() {
        if (currentActiveCohort === "1") {
            cohort1ActiveIndex += 9;
            document.getElementById("pgpRiseCohort1").innerHTML = '';
            bindPGPStudents("1");
        }
        else if (currentActiveCohort === "2") {
            cohort2ActiveIndex += 9;
            document.getElementById("pgpRiseCohort2").innerHTML = '';
            bindPGPStudents("2");
        } else {
            cohort3ActiveIndex += 9;
            document.getElementById("pgpRiseCohort3").innerHTML = '';
            bindPGPStudents("3");
        }
    }

    document.querySelectorAll("#masterTabsUl li").forEach(function (element) {
        element.addEventListener("click", function () {
            document.querySelector("#mastertab1")?.classList?.add("hide");
            document.querySelector("#mastertab2")?.classList?.add("hide");
            document.querySelector("#mastertab3")?.classList?.add("hide");
            let id = this.getAttribute('data-rel');

            let siblings = Array.from(this.parentNode.children).filter(function (child) {
                return child !== this;
            }, this);
            siblings.forEach(function (sibling) {
                sibling.classList.remove('active');
            });

            document.getElementById(id).classList.remove("hide");
            this.classList.add('active');

            // Scroll the active content to top (100px from top of viewport)
            const targetContent = document.getElementById(id);
            if (targetContent) {
                const targetPosition = targetContent.offsetTop - 100;
                window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                });
            }
        });
    });


</script>