                    position: relative;
                    width: 100%;
                    height: 340px;
                    touch-action: pan-y;
                }

                .day-immersion__slide {
                    position: absolute;
                    width: 100%;
                    bottom: 0;
                    transform-origin: center calc(100% + 600px);
                    will-change: transform, filter;
                    cursor: grab;
                    user-select: none;
                }

                .day-immersion__slide:active {
                    cursor: grabbing;
                }

                .day-immersion__slide img {
                    width: 100%;
                    display: block;
                    pointer-events: none;
                }
            }

            @media (max-width: 767px) {
                .day-immersion {
                    display: flex;
                    flex-direction: column;
                    justify-content: flex-end;
                }
            }
        </style>

        <script>
            const SLIDES_DATA = {{{jsArray "SLIDES_DATA"}}};

            const TOTAL = SLIDES_DATA.length;
            const DEG = 12;
            const TILT = 0.7;
            const VISIBLE = 2;
            const POOL_SIZE = VISIBLE * 2 + 1;

            const labelEl = document.getElementById('slideLabel');
            const headingEl = document.getElementById('slideHeading');
            const subEl = document.getElementById('slideSub');
            const iconEl = document.getElementById('slideIcon');
            const track = document.getElementById('wheelTrack');

            function updateContent(index) {
                const s = SLIDES_DATA[((index % TOTAL) + TOTAL) % TOTAL];
                labelEl.textContent = s.label;
                headingEl.textContent = s.heading;
                subEl.textContent = s.sub;
                iconEl.src = s.icon;
            }

            const pool = [];
            for (let i = 0; i < POOL_SIZE; i++) {
                const card = document.createElement('div');
                card.className = 'day-immersion__slide';
                const img = document.createElement('img');
                img.alt = '';
                card.appendChild(img);
                track.appendChild(card);
                pool.push(card);
            }

            let angleDeg = 0;
            let current = 0;

            function render(angle, instant) {
                const centreSlot = Math.round(angle / DEG);
                pool.forEach((card, pi) => {
                    const offset = pi - VISIBLE;
                    const slotIndex = centreSlot + offset;
                    const dataIdx = ((slotIndex % TOTAL) + TOTAL) % TOTAL;
                    const data = SLIDES_DATA[dataIdx];

                    const img = card.querySelector('img');
                    if (img.src !== data.img) img.src = data.img;

                    const rot = slotIndex * DEG - angle;
                    const absRot = Math.abs(rot);
                    const gray = Math.min(absRot / DEG, 1);
                    const brightness = 1 - gray * 0.55;
                    const scale = 1 - gray * 0.05;
                    const lift = absRot * 2.5;
                    const visualRot = rot + rot * TILT;

                    card.style.transition = instant
                        ? 'none'
                        : 'transform 0.45s cubic-bezier(0.25,0.46,0.45,0.94), filter 0.45s ease';
                    card.style.transform = `rotate(${visualRot}deg) translateY(-${lift}px) scale(${scale})`;
                    card.style.filter = `grayscale(${gray}) brightness(${brightness})`;
                    card.style.zIndex = String(50 - Math.round(absRot * 2));
                });
            }

            function snap(rawAngle) {
                const nearest = Math.round(rawAngle / DEG);
                angleDeg = nearest * DEG;
                current = ((nearest % TOTAL) + TOTAL) % TOTAL;
                render(angleDeg, false);
                updateContent(current);
            }

            render(angleDeg, true);
            updateContent(0);

            let startX = 0, startAngle = 0, lastX = 0, dragging = false;

            /* ─── Touch events ───────────────────────────────────────── */
            track.addEventListener('touchstart', e => {
                if (!e.target.closest('.day-immersion__slide')) return;

                dragging = true;
                startX = e.touches[0].clientX;
                startAngle = angleDeg;
                lastX = startX;
                pool.forEach(c => { c.style.transition = 'none'; });
            }, { passive: true });

            track.addEventListener('touchmove', e => {
                if (!dragging) return;
                e.preventDefault();
                const x = e.touches[0].clientX;
                lastX = x;
                angleDeg = startAngle - (x - startX) / track.offsetWidth * DEG * 2;
                render(angleDeg, true);
            }, { passive: false });

            track.addEventListener('touchend', () => {
                if (!dragging) return;
                dragging = false;
                snap(angleDeg);
            });

            /* ─── Mouse events ───────────────────────────────────────── */
            track.addEventListener('mousedown', e => {
                if (!e.target.closest('.day-immersion__slide')) return;

                dragging = true;
                startX = e.clientX;
                startAngle = angleDeg;
                lastX = startX;
                pool.forEach(c => { c.style.transition = 'none'; });
                e.preventDefault();
            });

            window.addEventListener('mousemove', e => {
                if (!dragging) return;
                lastX = e.clientX;
                angleDeg = startAngle - (e.clientX - startX) / track.offsetWidth * DEG * 2;
                render(angleDeg, true);
            });

            window.addEventListener('mouseup', () => {
                if (!dragging) return;
                dragging = false;
                snap(angleDeg);
            });
        </script>
        

