<main><section data-sec="s1" class="relative pt-32 pb-24 overflow-hidden"><div class="absolute inset-0 pointer-events-none hero-overlay" aria-hidden="true"></div><div class="container relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"><div class="text-center lg:text-left"><h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-foreground leading-[1.1]" data-c="s1.rich4" data-c-rich="1">{{{c "s1.rich4"}}}</h1><p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto lg:mx-0" data-c="s1.p5">{{{c "s1.p5"}}}</p><div class="mt-10 flex flex-col sm:flex-row justify-center lg:justify-start gap-4"><a href="#contact" class="btn-primary {{{c 's1.state2'}}}" data-c-state="s1.state2" data-c="s1.a6">{{{c "s1.a6"}}}</a><a href="#features" class="btn-outline {{{c 's1.state3'}}}" data-c-state="s1.state3" data-c="s1.a7">{{{c "s1.a7"}}}</a></div></div><div class="flex justify-center lg:justify-end"><div class="w-full max-w-xl rounded-xl overflow-hidden shadow-elegant">{{{media 's1.media1'}}}</div></div></div></section><section data-sec="s2" id="features" class="py-24 md:py-32"><div class="container"><div class="text-center mb-16 md:mb-20"><h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-foreground" data-c="s2.h21">{{{c "s2.h21"}}}</h2><p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto" data-c="s2.p2">{{{c "s2.p2"}}}</p></div><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><article class="surface-card feature-card p-8"><div class="flex items-center gap-4 mb-6"><div class="feature-num"><span class="feature-num-text">01</span></div><h3 class="text-xl font-medium text-foreground" data-c="s2.h33">{{{c "s2.h33"}}}</h3></div><p class="text-muted-foreground leading-relaxed" data-c="s2.p4">{{{c "s2.p4"}}}</p></article><article class="surface-card feature-card p-8"><div class="flex items-center gap-4 mb-6"><div class="feature-num"><span class="feature-num-text">02</span></div><h3 class="text-xl font-medium text-foreground" data-c="s2.h35">{{{c "s2.h35"}}}</h3></div><p class="text-muted-foreground leading-relaxed" data-c="s2.p6">{{{c "s2.p6"}}}</p></article><article class="surface-card feature-card p-8"><div class="flex items-center gap-4 mb-6"><div class="feature-num"><span class="feature-num-text">03</span></div><h3 class="text-xl font-medium text-foreground" data-c="s2.h37">{{{c "s2.h37"}}}</h3></div><p class="text-muted-foreground leading-relaxed" data-c="s2.p8">{{{c "s2.p8"}}}</p></article></div></div></section><section data-sec="s3" id="contact" class="py-24 md:py-32"><div class="container grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"><div class="text-center lg:text-left"><h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-foreground" data-c="s3.h21">{{{c "s3.h21"}}}</h2><p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto lg:mx-0" data-c="s3.p2">{{{c "s3.p2"}}}</p></div><div class="surface-card-elegant p-8 md:p-10"><form class="space-y-6"><div class="space-y-2"><label for="name" class="form-label" data-c="s3.label3">{{{c "s3.label3"}}}</label><input id="name" name="name" placeholder="Jane Doe" required="" class="form-input"></div><div class="space-y-2"><label for="email" class="form-label" data-c="s3.label4">{{{c "s3.label4"}}}</label><input id="email" name="email" type="email" placeholder="jane.doe@example.com" required="" class="form-input"></div><div class="space-y-2"><label for="message" class="form-label" data-c="s3.label5">{{{c "s3.label5"}}}</label><textarea id="message" name="message" rows="4" placeholder="Tell us about your needs..." required="" class="form-textarea"></textarea></div><button type="submit" class="btn-primary w-full" data-c="s3.button6">{{{c "s3.button6"}}}</button></form></div></div></section></main>