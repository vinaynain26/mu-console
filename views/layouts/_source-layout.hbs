  function scrollTab(active) {
    var activeWidth = active.width() / 2;
    let ancorVar = $(active).find("a").attr("href");
    let parent = active.parent().attr("id");
    var pos = active.position()?.left + activeWidth;
    var currentscroll = active.parent().scrollLeft();
    var divwidth = active.parent().width();

    if (activeWidth > 60) {
      pos = pos + currentscroll - divwidth / 2 + 105;
    } else {
      pos = pos + currentscroll - divwidth / 2 + 80;
    }
    active.parent().animate({
      scrollLeft: pos,
    }, 300);
  }

  function openTab(scrollTo, newUrl) {
    // Update URL without page reload
    if (newUrl) {
      history.pushState({tab: newUrl}, '', '/' + newUrl);
    }
    
    // Scroll to element if specified
    if (scrollTo) {
      const element = document.getElementById(scrollTo);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth' });
      }
    }
  }

  function initializeTabContent(tabId) {
    // Reinitialize all Swiper instances in the tab
    if (typeof Swiper !== 'undefined') {
      const $tab = $(`#${tabId}`);
      $tab.find('.swiper').each(function() {
        const $swiper = $(this);
        if ($swiper.length && !$swiper.hasClass('swiper-initialized')) {
          // Get the Swiper instance configuration based on class
          if ($swiper.hasClass('eventheld13')) {
            new Swiper('.eventheld13', swiperConfig);
          } else if ($swiper.hasClass('outclassSwipergm1')) {
            new Swiper('.outclassSwipergm1', outclassConfig);
          }
          // Add more Swiper initializations as needed
        }
      });
    }

    // Reinitialize any other interactive elements
    const $tab = $(`#${tabId}`);
    
    // Trigger a resize event to fix any layout issues
    window.dispatchEvent(new Event('resize'));
  }

  function switchToTab(tabId) {
    // Find the tab element
    const $tab = $(`.seondtabs li[data-rel="${tabId}"]`);
    if ($tab.length) {
      // Update active states
      $tab.addClass('active').siblings().removeClass('active');
      const $content = $(`#${tabId}`);
      $content.addClass('active').siblings().removeClass('active');
      
      // Scroll the tab into view
      scrollTab($tab);

      // Initialize the tab content
      initializeTabContent(tabId);
    }
  }

  // Handle tab switching
  $(".seondtabs li").click(function () {
    const $this = $(this);
    const id = $this.attr('data-rel');
    const url = $this.attr('data-url');
    
    // Switch to the selected tab
    switchToTab(id);
    
    // Update URL if specified
    if (url) {
      history.pushState({tab: id}, '', '/' + url);
    }
  });

  // Handle browser back/forward
  window.addEventListener('popstate', function(event) {
    if (event.state && event.state.tab) {
      // Get the tab ID from the current URL
      const currentPath = window.location.pathname.substring(1); // Remove leading slash
      const $tab = $(`.seondtabs li[data-url="${currentPath}"]`);
      if ($tab.length) {
        switchToTab($tab.attr('data-rel'));
      }
    }
  });

