  <script>
    (function () {
      // Region is detected CLIENT-SIDE (same as the cookie banner in components/cokkie.hbs).
      // The geo request leaves the visitor's browser, so it follows their VPN exit / real IP
      // and works even on localhost — unlike a server lookup, which only sees 127.0.0.1 locally.
      var COUNTRY_COOKIE = 'mu_fellowship_country';

      function setCookie(name, value) {
        var d = new Date();
        d.setTime(d.getTime() + 30 * 86400000); // 30 days
        document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/';
      }
      function getCookie(name) {
        var m = document.cookie.match('(?:^|; )' + name + '=([^;]+)');
        return m ? decodeURIComponent(m[1]) : null;
      }
      function setFellowshipRegion(country) {
        var isIndia = String(country || 'IN').toUpperCase() === 'IN';
        document.documentElement.setAttribute('data-fellowship-region', isIndia ? 'in' : 'out');
      }
      function run() {
        var cached = getCookie(COUNTRY_COOKIE);
        if (cached) setFellowshipRegion(cached); // instant paint from last known country (no flicker across pages)

        fetch('https://api.country.is/')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var country = d && d.country ? d.country : (cached || 'IN');
            setCookie(COUNTRY_COOKIE, country); // remember it, and refresh if the VPN/location changed
            setFellowshipRegion(country);
          })
          .catch(function () { if (!cached) setFellowshipRegion('IN'); });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    })();
  </script>

